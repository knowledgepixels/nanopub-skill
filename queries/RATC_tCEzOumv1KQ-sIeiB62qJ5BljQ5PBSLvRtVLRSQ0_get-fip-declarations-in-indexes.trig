@prefix this: <https://w3id.org/np/RATC_tCEzOumv1KQ-sIeiB62qJ5BljQ5PBSLvRtVLRSQ0> .
@prefix sub: <https://w3id.org/np/RATC_tCEzOumv1KQ-sIeiB62qJ5BljQ5PBSLvRtVLRSQ0/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-fip-decl-in-index a grlc:grlc-query;
    dct:description "This query returns all FIP declarations that are part of the most recent version of each FIP index, as these nanopublications are produced by the FIP Wizard. An index counts as superseded when a newer, non-invalidated index was derived (prov:wasDerivedFrom) from the same FIP Wizard source, or when a newer, non-invalidated index carries the same title (a FIP re-created as a new Wizard project). The previous version compared titles only, against any nanopublication: it kept every older version whose title had changed (66 of 235 indexes on 2026-10-29) and dropped the two indexes whose title is shared by a non-index nanopublication. Indexes of retracted FIPs (referred to only by invalidated FIP nanopublications) and of reference FIPs (rFIPs, which the separate get-rfip-decl-in-context query covers) are left out.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get FIP declarations in indexes";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix fip: <https://w3id.org/fair/fip/terms/>
prefix dct: <http://purl.org/dc/terms/>
prefix dce: <http://purl.org/dc/elements/1.1/>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix np: <http://www.nanopub.org/nschema#>
prefix prov: <http://www.w3.org/ns/prov#>
select ?fip_index ?fip_title ?fip_source ?decl_np where {
  # Current indexes first (one row per index), so the version filters run per index, not per declaration.
  { select ?fip_index ?fip_title ?fip_source where {
    graph npa:graph {
      ?fip_index npx:hasNanopubType npx:NanopubIndex .
      ?fip_index npa:hasValidSignatureForPublicKey ?pubkey .
      filter not exists { ?index_np_x npx:invalidates ?fip_index ; npa:hasValidSignatureForPublicKey ?pubkey . }
      ?fip_index np:hasPublicationInfo ?index_i .
      ?fip_index rdfs:label ?fip_title .
      ?fip_index dct:created ?index_date .
    }
    graph ?index_i {
      ?fip_index prov:wasDerivedFrom ?fip_source .
    }
  # An index is superseded when a newer, non-invalidated index was derived from the same FIP Wizard
  # source (prov:wasDerivedFrom in the index's publication info) ...
  filter not exists {
    graph npa:graph {
      ?fip_newer_index npx:hasNanopubType npx:NanopubIndex .
      ?fip_newer_index npa:hasValidSignatureForPublicKey ?newer_pubkey .
      filter not exists { ?fip_newer_index_x npx:invalidates ?fip_newer_index ; npa:hasValidSignatureForPublicKey ?newer_pubkey . }
      ?fip_newer_index np:hasPublicationInfo ?newer_i .
      ?fip_newer_index dct:created ?newer_date .
    }
    graph ?newer_i {
      ?fip_newer_index prov:wasDerivedFrom ?fip_source .
    }
    filter(?newer_date > ?index_date)
  }
  # ... or when a newer, non-invalidated index carries the same title: a FIP re-created as a new
  # Wizard project keeps its title but gets a new source. Only indexes count here; the earlier
  # version matched any nanopublication with that label (which dropped the PARC rFIP, whose
  # own nanopublication shares the index's title) and nothing else, so it kept every index
  # whose title had changed between versions (underscores replaced by spaces in 2024).
  filter not exists {
    graph npa:graph {
      ?fip_newer_index2 rdfs:label ?fip_title .
    }
    graph npa:graph {
      ?fip_newer_index2 npa:hasValidSignatureForPublicKey ?newer_pubkey2 .
      filter not exists { ?fip_newer_index2_x npx:invalidates ?fip_newer_index2 ; npa:hasValidSignatureForPublicKey ?newer_pubkey2 . }
      ?fip_newer_index2 dct:created ?newer_date2 .
      ?fip_newer_index2 npx:hasNanopubType npx:NanopubIndex .
    }
    filter(?newer_date2 > ?index_date)
  }
  # Drop the index of a retracted FIP: FIP nanopublications refer to it, and all of them are invalidated.
  # (An index no FIP nanopublication refers to at all is kept.)
  filter not exists {
    graph ?fa_r { ?fip_r fip:has-declaration-index ?fip_index . }
    graph npa:graph {
      ?fnp_r np:hasAssertion ?fa_r ; npx:hasNanopubType fip:FAIR-Implementation-Profile ; npa:hasValidSignatureForPublicKey ?fpk_r .
      ?fx_r npx:invalidates ?fnp_r ; npa:hasValidSignatureForPublicKey ?fpk_r .
    }
    filter not exists {
      graph ?fa_v { ?fip_v fip:has-declaration-index ?fip_index . }
      graph npa:graph {
        ?fnp_v np:hasAssertion ?fa_v ; npx:hasNanopubType fip:FAIR-Implementation-Profile ; npa:hasValidSignatureForPublicKey ?fpk_v .
        filter not exists { ?fx_v npx:invalidates ?fnp_v ; npa:hasValidSignatureForPublicKey ?fpk_v . }
      }
    }
  }
  # Drop the index of a reference FIP (rFIP): rFIPs come from the separate get-rfip-decl-in-context query,
  # which only adds declarations not already covered here, so an rFIP index here would claim them for itself.
  filter not exists {
    graph ?fa_t { ?fip_t fip:has-declaration-index ?fip_index . }
    graph npa:graph {
      ?fnp_t np:hasAssertion ?fa_t ; npx:hasNanopubType fip:Reference-FAIR-Implementation-Profile ; npa:hasValidSignatureForPublicKey ?fpk_t .
      filter not exists { ?fx_t npx:invalidates ?fnp_t ; npa:hasValidSignatureForPublicKey ?fpk_t . }
    }
  }
  } }
  graph npa:graph {
    ?fip_index np:hasAssertion ?index_a .
    ?decl_np npa:hasValidSignatureForPublicKey ?decl_pubkey .
    filter not exists { ?decl_np_x npx:invalidates ?decl_np ; npa:hasValidSignatureForPublicKey ?decl_pubkey . }
    ?decl_np npx:hasNanopubType fip:FIP-Declaration .
  }
  graph ?index_a {
    ?fip_index npx:includesElement ?decl_np .
  }
}""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://w3id.org/np/RALx4mcnF84op6E-q-voMr19X80Sy_Khy2I1dMmachJ3o> .
}

