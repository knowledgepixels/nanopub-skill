@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-topics-of-presentation a grlc:grlc-query;
    dct:description "Returns what a talk is about: one row per topic recorded for it, with the topic's URI and its label. The talk comes in as the queried resource, so the same query serves every presentation in the network. Topics are existing URIs — Wikidata items, or a W3C specification where Wikidata has no item for a standard yet — and the label is read from the tagging nanopublication's publication info, falling back to the URI itself, so a topic shows a name even where nothing else in the repository knows it. Every valid, uninvalidated tagging nanopublication counts, rather than only the most recent one, because topics accumulate: a later contribution adds topics instead of replacing them.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the topics of a presentation";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/3952cad1a6d2561f045d33e5e79c03e7264b0a492b8becf6c62656c596cf398c>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>

select distinct ?topic ?topic_label ?np (\"^\" as ?np_label) where {
  values ?_presentation_multi_iri {}
  graph npa:graph {
    ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
    filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
    ?np np:hasAssertion ?a .
    ?np np:hasPublicationInfo ?pi .
  }
  graph ?a { ?_presentation_multi_iri dct:subject ?topic . }
  optional { graph ?pi { ?topic rdfs:label ?tl . } }
  bind(coalesce(?tl, str(?topic)) as ?topic_label)
} order by ?topic_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-10-25T05:50:15Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:get-topics-of-presentation;
    rdfs:label "Get the topics of a presentation";
