@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:check-nanopub-loaded a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "This query checks whether a given nanopublication has been loaded by the answering Nanopub Query instance. It returns the nanopublication's creation date if the nanopublication is present, and an empty result otherwise. It is designed to be as cheap as possible (a single indexed lookup), so it can be used to poll for the arrival of a just-published nanopublication, for example to delay a cache refresh until the new nanopublication has made its round trip through the network.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Check if a nanopublication is loaded";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/meta>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix npa: <http://purl.org/nanopub/admin/>
prefix dct: <http://purl.org/dc/terms/>

select ?date where {
  graph npa:graph {
    ?_np_iri dct:created ?date .
  }
} limit 1""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-08-25T12:12:53Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:check-nanopub-loaded;
    rdfs:label "Check if a nanopublication is loaded";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA0J4vUn_dekg-U1kK3AOEt02p9mT2WO03uGxLDec1jLw>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAEFAt-QcFK0ZhqfvlsmS10BnzGJA0xwOICZXkO-ai87k> .
  
  sub:sig npx:hasAlgorithm "RSA";
