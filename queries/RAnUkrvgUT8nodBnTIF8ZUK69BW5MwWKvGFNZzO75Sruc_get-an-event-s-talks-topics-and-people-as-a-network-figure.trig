      bind(round(52 + (?rank - 0.5) * (1300 / ?total)) as ?y)
      bind(if(?col = 1,
              if(strlen(?label) > 52, concat(substr(?label, 1, 51), \"\\u2026\"), ?label),
              if(strlen(?label) > 30, concat(substr(?label, 1, 29), \"\\u2026\"), ?label)) as ?short)
