      bind(round(52 + (?rankB - 0.5) * (1300 / ?totalB)) as ?yb)
      bind(if(?colA = 0, 254, 790) as ?xa)
      bind(if(?colB = 1, 418, 945) as ?xb)
      bind((?xa + ?xb) / 2 as ?xm)
      bind(concat('<path d=\"M', str(?xa), ',', str(?ya),
                  ' C', str(?xm), ',', str(?ya), ' ', str(?xm), ',', str(?yb), ' ',
                  str(?xb), ',', str(?yb), '\" fill=\"none\" stroke=\"',
