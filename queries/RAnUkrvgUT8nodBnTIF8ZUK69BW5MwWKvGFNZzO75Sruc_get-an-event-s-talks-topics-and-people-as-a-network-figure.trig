          filter not exists { ?inv2 npx:invalidates ?nw ; npa:hasValidSignatureForPublicKeyHash ?pkw . }
        }
      }
      values ?_event_multi_iri {  }
      graph ?a { ?pres a wd:Q604733 ; dct:isPartOf ?_event_multi_iri ; rdfs:label ?tlabel . }
        optional { graph ?a { ?pres schema:startDate ?sdA } }
        optional { graph ?a { ?pres schemaold:startDate ?sdB } }
        bind(coalesce(str(?sdA), str(?sdB), \"\") as ?sd)
        bind(?pres as ?node)
        bind(1 as ?col)
        bind(?tlabel as ?label)
        bind(concat(?sd, \"|\", str(?pres)) as ?key)
      } union {
        { select ?node ?label (min(?osd0) as ?osd) where {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKeyHash ?pk ;
          np:hasAssertion ?a ; np:hasPublicationInfo ?pi ; npx:introduces ?pres ; dct:created ?cr .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
        filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
        filter not exists {
          ?nw npx:introduces ?pres ; npa:hasValidSignatureForPublicKeyHash ?pkw ; dct:created ?crw .
          filter(?crw > ?cr)
          filter not exists { ?inv2 npx:invalidates ?nw ; npa:hasValidSignatureForPublicKeyHash ?pkw . }
        }
      }
      values ?_event_multi_iri {  }
      graph ?a { ?pres a wd:Q604733 ; dct:isPartOf ?_event_multi_iri ; rdfs:label ?tlabel . }
        graph npa:graph {
          ?tnp npa:hasValidSignatureForPublicKeyHash ?tpk ;
            np:hasAssertion ?ta ; np:hasPublicationInfo ?tpi .
          filter not exists { ?tinv npx:invalidates ?tnp ; npa:hasValidSignatureForPublicKeyHash ?tpk . }
          filter not exists { ?tnp npx:hasNanopubType npx:ExampleNanopub . }
        }
          optional { graph ?a { ?pres schema:startDate ?osdA } }
          optional { graph ?a { ?pres schemaold:startDate ?osdB } }
          bind(coalesce(str(?osdA), str(?osdB), \"\") as ?osd0)
          graph ?ta { ?pres dct:subject ?node }
          optional { graph ?tpi { ?node rdfs:label ?tl } }
          bind(coalesce(?tl, str(?node)) as ?label)
        } group by ?node ?label }
        bind(2 as ?col)
        bind(concat(?osd, \"|\", lcase(?label), \"|\", str(?node)) as ?key)
