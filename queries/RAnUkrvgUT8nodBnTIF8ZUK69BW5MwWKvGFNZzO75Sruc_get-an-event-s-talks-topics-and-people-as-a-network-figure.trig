          optional { graph ?a { ?pres schema:startDate ?psdA } }
          optional { graph ?a { ?pres schemaold:startDate ?psdB } }
          bind(coalesce(str(?psdA), str(?psdB), \"\") as ?psd0)
          graph ?a { ?pres pav:authoredBy|wd:P823 ?node }
