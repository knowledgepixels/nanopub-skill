sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-talk-topic-people-network-svg a grlc:grlc-query;
    dct:description "Draws an event's talks, the people who give them and the topics they are about as one figure: a tripartite network with people on the left, talks in the middle and topics on the right, an edge from each person to every talk they author or present and from each talk to every topic recorded for it. A force-directed layout is not open to a SPARQL query, which has no trigonometry, so the columns are laid out by rank and the edges drawn as Beziers; people and topics are ordered by the first talk they attach to rather than alphabetically, which turns what is otherwise a hairball into bundles and makes a co-author or a shared topic visible as a crossing. Each column is spread over the same vertical band whatever its size, so the figure stays proportionate for an event with four talks or forty. Talk boxes link to the talk's own page; every node carries its full name as a tooltip, since labels are truncated to fit. The event comes in as the queried resource, so the same query serves any event whose talks carry authors or topics.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get an event's talks, topics and people as a network figure";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/3952cad1a6d2561f045d33e5e79c03e7264b0a492b8becf6c62656c596cf398c>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix wd: <http://www.wikidata.org/entity/>
prefix schema: <https://schema.org/>
prefix schemaold: <http://schema.org/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix pav: <http://purl.org/pav/>

select ?title (concat(
    '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1160 1378\" width=\"1160\" height=\"1378\" font-family=\"sans-serif\">',
    '<text x=\"242\" y=\"26\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"end\" fill=\"#5e8f55\">People</text>' , '<text x=\"600\" y=\"26\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#33475b\">Talks</text>' , '<text x=\"950\" y=\"26\" font-size=\"12\" font-weight=\"bold\" fill=\"#a9762f\">Topics</text>',
    ?edgefrags, ?nodefrags, '</svg>') as ?svg)
where {
  {
    select (group_concat(?efrag; separator=\"\") as ?edgefrags) where {
      { select (?node as ?nodeA) (?col as ?colA) (?label as ?labelA) (?rank as ?rankA) (?total as ?totalA) where {
  select ?node ?col ?label ?key (sum(if(?key2 <= ?key, 1, 0)) as ?rank) (count(?key2) as ?total)
  where {
    { select distinct ?node ?col ?key ?label where {
      {
        { select ?node ?label (min(?psd0) as ?psd) where {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKeyHash ?pk ;
          np:hasAssertion ?a ; np:hasPublicationInfo ?pi ; npx:introduces ?pres ; dct:created ?cr .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
        filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
        filter not exists {
          ?nw npx:introduces ?pres ; npa:hasValidSignatureForPublicKeyHash ?pkw ; dct:created ?crw .
          filter(?crw > ?cr)
          filter not exists { ?inv2 npx:invalidates ?nw ; npa:hasValidSignatureForPublicKeyHash ?pkw . }
        }
      }
      values ?_event_multi_iri {  }
      graph ?a { ?pres a wd:Q604733 ; dct:isPartOf ?_event_multi_iri ; rdfs:label ?tlabel . }
          optional { graph ?a { ?pres schema:startDate ?psdA } }
          optional { graph ?a { ?pres schemaold:startDate ?psdB } }
          bind(coalesce(str(?psdA), str(?psdB), \"\") as ?psd0)
          graph ?a { ?pres pav:authoredBy|wd:P823 ?node }
          graph ?pi { ?node foaf:name ?label }
        } group by ?node ?label }
        bind(0 as ?col)
        bind(concat(?psd, \"|\", lcase(?label), \"|\", str(?node)) as ?key)
      } union {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKeyHash ?pk ;
          np:hasAssertion ?a ; np:hasPublicationInfo ?pi ; npx:introduces ?pres ; dct:created ?cr .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
        filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
        filter not exists {
          ?nw npx:introduces ?pres ; npa:hasValidSignatureForPublicKeyHash ?pkw ; dct:created ?crw .
          filter(?crw > ?cr)
          filter not exists { ?inv2 npx:invalidates ?nw ; npa:hasValidSignatureForPublicKeyHash ?pkw . }
        }
      }
      values ?_event_multi_iri {  }
      graph ?a { ?pres a wd:Q604733 ; dct:isPartOf ?_event_multi_iri ; rdfs:label ?tlabel . }
        optional { graph ?a { ?pres schema:startDate ?sdA } }
        optional { graph ?a { ?pres schemaold:startDate ?sdB } }
        bind(coalesce(str(?sdA), str(?sdB), \"\") as ?sd)
        bind(?pres as ?node)
        bind(1 as ?col)
        bind(?tlabel as ?label)
        bind(concat(?sd, \"|\", str(?pres)) as ?key)
      } union {
        { select ?node ?label (min(?osd0) as ?osd) where {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKeyHash ?pk ;
          np:hasAssertion ?a ; np:hasPublicationInfo ?pi ; npx:introduces ?pres ; dct:created ?cr .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
        filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
        filter not exists {
