    npx:hasSignature "R7T24DgUkoihdMrgIMD8uaijDmUdMxrOcHPMy+cLzyS7liCg5nCASNX4PDK8bt7/X5e03oza4CC3Okx0LGDNVL8fU6DGj22W7OrQv4zx3TV07k/cTmCG38V8Ya6GO9ZR0gtG88SIU8SO8wmxNFktkxi3CV+0aDLSwZy9crJgC0A=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

