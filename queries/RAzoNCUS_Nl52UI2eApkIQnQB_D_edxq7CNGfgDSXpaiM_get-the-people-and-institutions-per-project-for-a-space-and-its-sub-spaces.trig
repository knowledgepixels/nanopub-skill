    npx:hasSignature "AXZkVcWyn5gm93RjC8ubJYMyCxAUHhbCsFhrXdyoNGFldpTwX5Bs8+CnYj/210kVFgobxSMkNfrDn3eYhZE2E0eKiApOxgd2zUZgNw86IalRf3+8vXKwoEiiXDg6qDLmm+qorwumb6xXXqs2FSIuNBC6+BDufqA7p17PLXiNo9o=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

