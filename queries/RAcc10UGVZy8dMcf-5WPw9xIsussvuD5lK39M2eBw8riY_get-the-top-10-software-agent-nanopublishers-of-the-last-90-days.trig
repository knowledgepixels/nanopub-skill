@prefix this: <https://w3id.org/np/RAcc10UGVZy8dMcf-5WPw9xIsussvuD5lK39M2eBw8riY> .
@prefix sub: <https://w3id.org/np/RAcc10UGVZy8dMcf-5WPw9xIsussvuD5lK39M2eBw8riY/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-top-software-agent-nanopublishers a grlc:grlc-query;
    dct:description "This query returns the 10 software agents that published most nanopublications during the last 90 days. Publishers are resolved via the trust network: only agents with an approved account are counted, and only the nanopublications signed with their own approved public keys. An agent counts as a software agent if it is introduced as a bot or other software agent.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the top-10 software agent nanopublishers of the last 90 days";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix prov: <http://www.w3.org/ns/prov#>

select ?user_iri where {
  # resolve the signing keys to their agents via the trust network (approved accounts only):
  {
    select ?user_iri ?pubkey_hash where {
      service <https://w3id.org/np/l/nanopub-query-1.1/repo/trust> {
        graph npa:graph {
          <http://purl.org/nanopub/admin/thisRepo> npa:hasCurrentTrustState ?trust_state .
        }
        graph ?trust_state {
          ?account a npa:AccountState ;
            npa:agent ?user_iri ;
            npa:pubkey ?pubkey_hash ;
            npa:trustStatus ?trust_status .
        }
        filter(?trust_status in (npa:loaded, npa:toLoad))
      }
    }
  }
  # keep only agents that are introduced as bots or other software agents:
  {
    select distinct ?user_iri where {
      values ?agent_type { npx:Bot npx:SoftwareAgent prov:SoftwareAgent }
      graph ?agent_graph {
        ?user_iri a ?agent_type .
      }
    }
  }
  # count their nanopublications of the last 90 days per signing key:
  {
    select ?pubkey (count(distinct ?np) as ?np_count) where {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKey ?pubkey ;
          dct:created ?date .
        filter(?date > now() - \"P90D\"^^xsd:dayTimeDuration)
      }
    }
    group by ?pubkey
  }
  filter(sha256(?pubkey) = ?pubkey_hash)
}
group by ?user_iri
order by desc(sum(?np_count))
limit 10""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

