    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:get-presentations-for-event;
    npx:supersedes <https://w3id.org/np/RAzwVkWqhZhHEGqQyukcR3jyIcLehE5eDSmCDv5yUHs6M>;
