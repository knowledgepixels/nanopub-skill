@prefix sub: <https://w3id.org/np/RAtiuwYYr4ZfpaICYSVcbP5o63cLF52qbdDrNYtxZX3PU/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-idea-upvotes a grlc:grlc-query;
    dct:description "Lists the up-votes of one idea for its part page, oldest first: one row per valid (not retracted or otherwise invalidated) schema:VoteAction nanopublication whose schema:object is the idea, with the voter (schema:agent, labelled with the foaf:name from the nanopublication's publication info), the date, and the nanopublication. The hidden withdraw_target column holds the nanopublication when it was signed by the viewer's local key (?__LOCALPUBKEY_multi), so that the viewer can retract their own up-vote.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the up-votes of an idea";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>
prefix schema: <https://schema.org/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix idea: <https://w3id.org/np/RA7b4hUMrroGWIlG_JJm9XV_XJlHGqRiTFP0amY0BcOd8/>

select ?voter ?voter_label ?date ?np ?np_label ?withdraw_target
where {
  {
    select ?np ?voter ?created ?pk (min(str(?vn)) as ?vname) where {
      graph ?va { ?vote a schema:VoteAction ; schema:object ?_idea_iri . }
      graph npa:graph {
        ?np np:hasAssertion ?va ; np:hasPublicationInfo ?pi ; npa:hasValidSignatureForPublicKey ?pk ; dct:created ?created .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKey ?pk . }
      }
      optional { graph ?va { ?vote schema:agent ?voter . } }
      optional { graph ?pi { ?voter foaf:name ?vn . } }
    } group by ?np ?voter ?created ?pk
  }
  values ?__LOCALPUBKEY_multi {}
  bind(coalesce(?vname, replace(str(?voter), '^.*/', '')) as ?voter_label)
  bind(str(?created) as ?date)
  bind('^' as ?np_label)
  bind(if(coalesce(str(?pk) = str(?__LOCALPUBKEY_multi), false), str(?np), '') as ?withdraw_target)
}
order by ?created""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

