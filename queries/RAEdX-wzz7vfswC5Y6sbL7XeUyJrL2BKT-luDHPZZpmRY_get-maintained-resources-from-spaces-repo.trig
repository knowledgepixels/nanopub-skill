sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-maintained-resources a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns server-validated maintained resources (npa:isMaintainedBy) from the current space-state graph of the spaces repo (/repo/spaces), with each resource's maintainer space, declaring nanopublication, label, optional namespace, and date. One row per resource and space: of several declarations, the newest by dct:created wins. The label is the resource's own rdfs:label from the declaring nanopublication's assertion, falling back to the nanopublication's label; a nanopublication declaring several resources therefore gives each of them its own name.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get maintained resources from spaces repo";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>

select ?resource ?space
       (coalesce(min(if(lang(?rLabel) = \"\", ?rLabel, ?nolabel)), min(?rLabel), min(?npLabel)) as ?label)
       (min(?ns) as ?namespace) ?date ?np (\"^\" as ?np_label) where {
  {
    select ?resource ?space (max(concat(str(?d0), \">\", str(?np0))) as ?maxW) where {
      graph npa:graph { npa:thisRepo npa:hasCurrentSpaceState ?g . }
      graph ?g { ?resource npa:isMaintainedBy ?space . }
      graph npa:spacesGraph {
        ?decl0 a npa:MaintainedResourceDeclaration ;
           npa:resourceIri ?resource ; npa:maintainerSpace ?space ;
           npa:viaNanopub ?np0 ; dct:created ?d0 .
      }
    } group by ?resource ?space
  }
  bind(iri(strafter(?maxW, \">\")) as ?np)
  graph npa:spacesGraph {
    ?decl a npa:MaintainedResourceDeclaration ;
       npa:resourceIri ?resource ; npa:maintainerSpace ?space ;
       npa:viaNanopub ?np ; dct:created ?date .
  }
  graph npa:graph { ?np np:hasAssertion ?a . }
  optional { graph npa:graph { ?np rdfs:label ?npLabel } }
  optional { graph ?a { ?resource rdfs:label ?rLabel } }
  optional { graph ?a { ?resource gen:hasNamespace ?ns } }
} group by ?resource ?space ?date ?np order by desc(?date)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

