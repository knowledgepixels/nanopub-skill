    npx:hasSignature "hPxg99L+AuNB51RnmDR+rYw3SGeiJKLcWiX1dm57/9dTIIeIsHCNHzZ6HHlbzSAE180KQu3LTWM3coCj5bIiRb+78pfYqfdZE0iwot8rcHj36BZIE9L/mWzIYUsafNAB3QGM0SdpJNfovsyD0upSSRUJTybrhWLqU/iUYGK1N1I=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

