    npx:hasSignature "MKx52UMlrgvYCccVSJ8/egkBk/bg65edV9XGq7YfyGNL5HgXZUrr6gdvG7FvgMUi0n/MPwCHOgIf6n6oCLG+Z4EJa2wAZHE3wgIW6wVSTJXXOLmUT5/aGeW6ZhCXFKu8IbqAG65nJZz06yQDHnIxDuY9BFH6jPWOTBuaanb2m7s=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

