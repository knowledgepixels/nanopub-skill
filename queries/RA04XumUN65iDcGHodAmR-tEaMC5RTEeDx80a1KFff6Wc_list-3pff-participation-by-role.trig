@prefix sub: <https://w3id.org/np/RA04XumUN65iDcGHodAmR-tEaMC5RTEeDx80a1KFff6Wc/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:list-3pff-participation-by-role a grlc:grlc-query;
    dct:description "Lists everybody who declared to have participated in a given 3PFF event (one row per agent), together with the roles they participated in: participant (3PFF participatedAsParticipantIn or wikidata P1344), implementer, implementer aspirant, facilitator, facilitator assistant, trainer, and trainer assistant. Only self-declarations count: the declaring nanopublication must name the participating agent as its creator. Retracted declarations are excluded, and where an agent declared the same role more than once, the newest declaration is the one linked. The name shown is the foaf:name stated by the declaring nanopublication itself, so agents without a published key still render with their name rather than as a bare URI. The nps column points to one declaration nanopublication per role. IRI-keyed by the event (param resource), which works both for 3PFF events that are Spaces and for other resources used as the object of the participation statements.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "List 3PFF participation by role";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix tpff: <https://w3id.org/fair/3pff/>
select ?user ?user_label ?roles_multi ?nps_multi_iri ?nps_label_multi where {
  {
    select ?user
           (sample(?roleName) as ?pickedName)
           (group_concat(?roleLabel; separator=\"\\n\") as ?roles_multi)
           (group_concat(?lastNp; separator=\" \") as ?nps_multi_iri)
           (group_concat(\"^\"; separator=\"\\n\") as ?nps_label_multi)
    where {
      {
        select ?user ?roleLabel (sample(?name) as ?roleName) (strafter(max(?dateAndNp), \"|\") as ?lastNp)
        where {
          values ( ?role ?roleLabel ) {
            ( tpff:participatedAsParticipantIn \"Participant\" )
            ( <http://www.wikidata.org/entity/P1344> \"Participant\" )
            ( tpff:participatedAsImplementerIn \"Implementer\" )
            ( tpff:participatedAsImplementerAspirantIn \"Implementer Aspirant\" )
            ( tpff:participatedAsFacilitatorIn \"Facilitator\" )
            ( tpff:participatedAsFacilitatorAssistantIn \"Facilitator Assistant\" )
            ( tpff:participatedAsTrainerIn \"Trainer\" )
            ( tpff:participatedAsTrainerAssistantIn \"Trainer Assistant\" )
          }
          graph npa:graph {
            ?np dct:creator ?user ;
                dct:created ?date ;
                np:hasAssertion ?a ;
                npa:hasValidSignatureForPublicKeyHash ?pubkey .
            filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
          }
          graph ?a { ?user ?role ?_resource_iri . }
          optional {
            graph npa:graph { ?np np:hasPublicationInfo ?pi . }
            graph ?pi { ?user foaf:name ?name . }
          }
          bind(concat(str(?date), \"|\", str(?np)) as ?dateAndNp)
        }
        group by ?user ?roleLabel
      }
    }
    group by ?user
  }
  bind(coalesce(str(?pickedName), \"\") as ?user_label)
}
order by lcase(?user_label)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

