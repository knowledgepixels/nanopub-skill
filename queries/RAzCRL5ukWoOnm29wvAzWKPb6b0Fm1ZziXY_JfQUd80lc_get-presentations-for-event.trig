@prefix this: <https://w3id.org/np/RAzCRL5ukWoOnm29wvAzWKPb6b0Fm1ZziXY_JfQUd80lc> .
@prefix sub: <https://w3id.org/np/RAzCRL5ukWoOnm29wvAzWKPb6b0Fm1ZziXY_JfQUd80lc/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-presentations-for-event a grlc:grlc-query;
    dct:description "Returns all presentations of the given event, with label, date and time, location, and the people involved - the presenter first where known, then the authors - plus the nanopub link, in chronological order. Reads both the http:// and https:// schema.org namespaces. Authors who are also listed as presenter of the same presentation are excluded from the authors part of the people column by a per-presentation not-exists check, so a person never appears twice. Date and time share one column as plain text (\"2026-09-17 14:00–15:00\"): a bare date is rendered by Nanodash as a relative time from midnight UTC, which showed a talk later today as hours ago. A presentation that records its track and the session it belongs to (optional statements of the presentation template since October 2026) also gets a track column and a session group header: rows are grouped by session, with the session’s own label, time and room in the header, and ordered within a session by the recorded running position rather than by whatever the engine returns. Where no session is recorded the group is the slot and room, which is what a programme with session-level times amounts to anyway. A presentation that records further material with rdfs:seeAlso gets a see-also column of links to it; this carries over the one addition of the parallel version RA0vadIa of 13 October 2026, which this version merges back in, the two having forked off RAza14ob independently: this version supersedes both heads, as RAKZ9Tq2 and RAq1Je8R did for earlier forks of the same pair.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get presentations for event";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/3952cad1a6d2561f045d33e5e79c03e7264b0a492b8becf6c62656c596cf398c>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix wd: <http://www.wikidata.org/entity/>
prefix schema: <https://schema.org/>
prefix schemaold: <http://schema.org/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix pav: <http://purl.org/pav/>
prefix conf: <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#>

select ?presentation ?presentation_label ?date ?location ?track ?people_multi_iri ?people_label_multi ?see_also_multi_iri ?see_also_label_multi ?np (\"^\" as ?np_label) (?np as ?override_target) ?session_group where {
  {
    select ?np ?presentation ?presentation_label ?startDate ?endDate ?location ?olddate
           ?position ?session ?sessionName ?track
           (group_concat(distinct ?spk; separator=\" \") as ?spkIris)
           (group_concat(distinct ?spkLabel; separator=\"\\n\") as ?spkNames)
           (group_concat(distinct ?auth; separator=\" \") as ?authIris)
           (group_concat(distinct ?authLabel; separator=\"\\n\") as ?authNames)
           (group_concat(distinct ?seeAlso; separator=\" \") as ?seeAlsoIris)
    where {
      graph npa:graph {
        ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
        filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
        filter not exists { ?np npx:hasNanopubType npx:ExampleNanopub . }
        ?np dct:created ?npdate .
        ?np np:hasAssertion ?a .
        ?np np:hasPublicationInfo ?pi .
        ?np npx:introduces ?presentation .
      }
      {
        select ?presentation (max(?npdate2) as ?latestdate) where {
          graph npa:graph {
            ?np2 npa:hasValidSignatureForPublicKeyHash ?pubkey2 .
            filter not exists { ?npx2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
            filter not exists { ?np2 npx:hasNanopubType npx:ExampleNanopub . }
            ?np2 dct:created ?npdate2 .
            ?np2 npx:introduces ?presentation .
          }
        } group by ?presentation
      }
      filter(?npdate = ?latestdate)
      values ?_event_multi_iri {}
      graph ?a {
        ?presentation a wd:Q604733 .
        ?presentation dct:isPartOf ?_event_multi_iri .
      }
      optional { graph ?a { ?presentation rdfs:label ?presentation_label . } }
      optional { graph ?a { ?presentation schema:startDate ?startDateA . } }
      optional { graph ?a { ?presentation schemaold:startDate ?startDateB . } }
      optional { graph ?a { ?presentation schema:endDate ?endDateA . } }
      optional { graph ?a { ?presentation schemaold:endDate ?endDateB . } }
      optional { graph ?a { ?presentation schema:location ?locationA . } }
      optional { graph ?a { ?presentation schemaold:location ?locationB . } }
      optional { graph ?a { ?presentation dct:date ?olddate . } }
      optional { graph ?a { ?presentation schema:position ?position . } }
      optional { graph ?a { ?presentation schema:additionalType ?track . } }
      optional {
        graph ?a { ?presentation conf:isSubEventOf ?session . }
        optional { graph ?pi { ?session rdfs:label ?sessionName . } }
      }
      optional {
        graph ?a { ?presentation rdfs:seeAlso ?seeAlso . }
        filter(isIri(?seeAlso))
      }
      optional {
        graph ?a { ?presentation wd:P823 ?spk . }
        optional { graph ?pi { ?spk foaf:name ?spkName . } }
        bind(coalesce(?spkName, str(?spk)) as ?spkLabel)
      }
      optional {
        graph ?a { ?presentation pav:authoredBy ?auth . }
        filter not exists { graph ?a { ?presentation wd:P823 ?auth . } }
        optional { graph ?pi { ?auth foaf:name ?authName . } }
        bind(coalesce(?authName, str(?auth)) as ?authLabel)
      }
      bind(coalesce(?startDateA, ?startDateB) as ?startDate)
      bind(coalesce(?endDateA, ?endDateB) as ?endDate)
      bind(coalesce(?locationA, ?locationB) as ?location)
    }
    group by ?np ?presentation ?presentation_label ?startDate ?endDate ?location ?olddate
             ?position ?session ?sessionName ?track
  }
  bind(coalesce(strbefore(str(?startDate), \"T\"), str(?olddate)) as ?day)
  bind(substr(strafter(str(?startDate), \"T\"), 1, 5) as ?starttime)
  bind(substr(strafter(str(?endDate), \"T\"), 1, 5) as ?endtime)
  bind(coalesce(concat(?starttime, \"\\u2013\", ?endtime), ?starttime) as ?time)
  bind(if(bound(?time) && strlen(?time) > 0, concat(?day, \" \", ?time), ?day) as ?date)
  bind(coalesce(str(?startDate), str(?olddate)) as ?sortkey)
  bind(coalesce(?location, \"\") as ?loc0)
  bind(coalesce(?sessionName, str(?session), \"\") as ?sessLabel)
  bind(if(strlen(?sessLabel) > 0,
          if(strlen(?loc0) > 0, concat(?sessLabel, \" · \", ?date, \" · \", ?loc0),
                                concat(?sessLabel, \" · \", ?date)),
          if(strlen(?loc0) > 0, concat(?date, \" · \", ?loc0), ?date)) as ?session_group)
  bind(if(strlen(?spkIris) > 0 && strlen(?authIris) > 0, concat(?spkIris, \" \", ?authIris),
       concat(?spkIris, ?authIris)) as ?people_multi_iri)
  bind(if(strlen(?spkNames) > 0 && strlen(?authNames) > 0, concat(?spkNames, \"\\n\", ?authNames),
       concat(?spkNames, ?authNames)) as ?people_label_multi)
  bind(?seeAlsoIris as ?see_also_multi_iri)
  bind(replace(replace(?seeAlsoIris, \"[^ ]+\", \"link\"), \" \", \"\\n\") as ?see_also_label_multi)
} order by ?sortkey ?session_group coalesce(?position, 999) ?presentation_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

