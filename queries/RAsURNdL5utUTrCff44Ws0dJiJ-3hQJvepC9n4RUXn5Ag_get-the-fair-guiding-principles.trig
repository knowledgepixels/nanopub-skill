sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-fair-principles a grlc:grlc-query;
    dct:description "Lists the 15 FAIR Guiding Principles (F1 to R1.3) with their text, in the order and grouping of Box 2 of Wilkinson et al. (2016): one row per principle, with a group column ('To be Findable:' etc.) for the four top-level principles F, A, I and R. The content comes from the FAIR principles vocabulary (namespace https://w3id.org/fair/principles/terms/), reading only the current, non-invalidated nanopublications signed with the key that publishes that vocabulary, so nobody else's nanopublication can change the wording shown.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the FAIR Guiding Principles";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/f2a0ff8319823c7eb4c1e93c8c6b25c6ebc8a46454801e856e8cc1f98e4641f4>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix fair: <https://w3id.org/fair/principles/terms/>

select ?principle_group (?principle as ?principle_noheader) ?principle_label (?text as ?text_noheader) ?np ?np_label where {
  values (?top ?order) { (fair:F 1) (fair:A 2) (fair:I 3) (fair:R 4) }
  values ?pk { \"2a6683923dcbd9810ef4e5debda8c4152c297b12303e286622bbbb0ed1884384\" }
  graph npa:graph {
    ?tnp npx:introduces ?top ; np:hasAssertion ?ta ; npa:hasValidSignatureForPublicKeyHash ?pk .
    filter not exists { ?y npx:invalidates ?tnp ; npa:hasValidSignatureForPublicKeyHash ?pk . }
  }
  graph ?ta { ?top rdfs:label ?topLabel ; dct:hasPart ?sub . }
  graph npa:graph {
    ?np npx:introduces ?principle ; np:hasAssertion ?a ; npa:hasValidSignatureForPublicKeyHash ?pk .
    filter not exists { ?x npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
  }
  graph ?a {
    ?principle a fair:FAIR-SubPrinciple ; rdfs:label ?principle_label ; skos:definition ?text .
  }
  filter(?principle = ?sub || strstarts(str(?principle), concat(str(?sub), \".\")))
  bind(concat(\"To be \", str(?topLabel), \":\") as ?principle_group)
  bind(\"^\" as ?np_label)
}
order by ?order str(?principle_label)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

