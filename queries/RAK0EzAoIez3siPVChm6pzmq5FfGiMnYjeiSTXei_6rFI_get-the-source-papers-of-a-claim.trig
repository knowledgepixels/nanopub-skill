@prefix this: <https://w3id.org/np/RAK0EzAoIez3siPVChm6pzmq5FfGiMnYjeiSTXei_6rFI> .
@prefix sub: <https://w3id.org/np/RAK0EzAoIez3siPVChm6pzmq5FfGiMnYjeiSTXei_6rFI/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-claim-source-papers a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Lists the sources a claim was derived from -- the works its nanopublication's provenance derives the assertion from with prov:wasDerivedFrom, leaving out resources inside the nanopublication itself such as the quote -- for the page of that claim (its IRI passed as the 'claim' parameter), read from the claim's current definition: of all validly signed, non-invalidated nanopublications that introduce the claim, the newest one (ties broken by nanopublication URI). Each paper's title and year are looked up wherever they are asserted rather than in one fixed graph, since a source may be described in the citing nanopublication's provenance graph or elsewhere on the network. The year is blank for a source whose dct:date is not published anywhere. Ordered by year, most recent first, then alphabetically by title.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the source papers of a claim";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix prov: <http://www.w3.org/ns/prov#>
prefix delphi: <https://w3id.org/delphi/ontology/>

select ?paper ?paper_label ?year ?np (\"^\" as ?np_label) where {
  {
    select ?np ?paper (min(?titleV) as ?paper_label) (min(?yearV) as ?year) where {
      values ?_claim_multi_iri {}
      graph npa:graph {
        ?np npx:introduces ?_claim_multi_iri ;
          np:hasAssertion ?a ;
          np:hasProvenance ?p ;
          dct:created ?date ;
          npa:hasValidSignatureForPublicKeyHash ?pubkey .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      }
      graph ?a { ?_claim_multi_iri a delphi:Claim }
      graph ?p { ?a prov:wasDerivedFrom ?paper }
      filter(isIri(?paper) && !strstarts(str(?paper), \"https://w3id.org/np/\"))
      filter not exists {
        graph npa:graph {
          ?np2 npx:introduces ?_claim_multi_iri ;
            np:hasAssertion ?a2 ;
            dct:created ?date2 ;
            npa:hasValidSignatureForPublicKeyHash ?pubkey2 .
          filter not exists { ?inv2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
        }
        graph ?a2 { ?_claim_multi_iri a delphi:Claim }
        filter(?date2 > ?date || (?date2 = ?date && str(?np2) > str(?np)))
      }
      optional { graph ?tg { ?paper dct:title ?titleV } }
      optional { graph ?yg { ?paper dct:date ?d } bind(substr(str(?d), 1, 4) as ?yearV) }
    } group by ?np ?paper
  }
}
order by desc(?year) lcase(str(coalesce(?paper_label, \"\")))""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

