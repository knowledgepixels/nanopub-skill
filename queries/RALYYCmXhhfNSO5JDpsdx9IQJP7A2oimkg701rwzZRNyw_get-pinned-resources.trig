    npx:embeds sub:get-pinned-resources;
    npx:supersedes <https://w3id.org/np/RABx3zMAR6L9_EPQ8JwHD2GLLPPQJkiAHJ5WgoUCdEzUg>;
    skos:changeNote "Each resource is listed only once: when several valid pins of the same resource exist for the entity, only the latest one (by dct:created) is shown.";
