@prefix this: <https://w3id.org/np/RALYYCmXhhfNSO5JDpsdx9IQJP7A2oimkg701rwzZRNyw> .
@prefix sub: <https://w3id.org/np/RALYYCmXhhfNSO5JDpsdx9IQJP7A2oimkg701rwzZRNyw/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-pinned-resources a grlc:grlc-query;
    dct:description "This query returns the pinned resources for a given entity (e.g. a Space), each resource only once (from its latest pin).";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get pinned resources";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/9c7a26ffc0dbf578c976ef2d16ad50734b357fc411557ac884d646e5fd5570b8>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>

select ?resource (min(?label) as ?resource_label) (min(?cmt) as ?comment) ?np (\"^\" as ?np_label) where {
  values ?_entity_multi_iri {}
  graph npa:graph {
    ?np npx:hasNanopubType gen:hasPinnedResource ;
      npa:hasValidSignatureForPublicKeyHash ?pubkey ;
      dct:created ?date ;
      np:hasAssertion ?a .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
  }
  graph ?a {
    ?_entity_multi_iri gen:hasPinnedResource ?resource .
  }
  # Show each resource once: skip this pin if a newer valid pin of the same resource exists (by anyone).
  optional {
    graph ?a2 {
      ?_entity_multi_iri gen:hasPinnedResource ?resource .
    }
    graph npa:graph {
      ?np2 np:hasAssertion ?a2 ;
        npx:hasNanopubType gen:hasPinnedResource ;
        npa:hasValidSignatureForPublicKeyHash ?pubkey2 ;
        dct:created ?date2 .
      filter not exists { ?npx2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
    }
    filter(?date2 > ?date || (?date2 = ?date && str(?np2) > str(?np)))
  }
  filter(!bound(?np2))
  optional { graph ?a { ?resource rdfs:label ?label . } }
  optional { graph ?a { ?resource rdfs:comment ?cmt . } }
} group by ?resource ?np""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

