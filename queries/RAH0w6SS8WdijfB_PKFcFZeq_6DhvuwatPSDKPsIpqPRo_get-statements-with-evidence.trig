@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-statements-with-evidence a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns all nanopublications typed as schema:Statement (npx:hasNanopubType), with the statement text (rdf:value) and the evidence it cites (cito:citesAsEvidence). Retracted and superseded nanopublications are left out.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get statements with evidence";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/29e2f808e4864fca4930806dee70c4a32df54a63ee90156244910a47d3443736>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix cito: <http://purl.org/spar/cito/>
prefix schema: <https://schema.org/>

select ?Statement ?Evidence_multi_iri ?Evidence_label_multi ?np (\"^\" as ?np_label)
where {
  select ?np ?created ?Statement
         (group_concat(distinct str(?evidence); separator=\" \") as ?Evidence_multi_iri)
         (group_concat(distinct ?evidenceLabel; separator=\"\\n\") as ?Evidence_label_multi)
  where {
    graph npa:graph {
      ?np npx:hasNanopubType schema:Statement ;
          npa:hasValidSignatureForPublicKeyHash ?pubkey ;
          np:hasAssertion ?a ;
          np:hasPublicationInfo ?pi ;
          dct:created ?created .
      filter not exists { ?npi npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
    }
    graph ?pi { ?np npx:hasNanopubType schema:Statement . }
    graph ?a { ?s rdf:value ?Statement . }
    optional {
      graph ?a { ?s cito:citesAsEvidence ?evidence . }
      bind(replace(str(?evidence), \"^.*[/#]\", \"\") as ?evidenceLabel)
    }
  }
  group by ?np ?created ?Statement
}
order by desc(?created)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354 .
}

