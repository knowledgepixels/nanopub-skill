@prefix this: <https://w3id.org/np/RARVqlc-69m9ITEdA68gPbvj_atZkj06k7acJBvuYyW4U> .
@prefix sub: <https://w3id.org/np/RARVqlc-69m9ITEdA68gPbvj_atZkj06k7acJBvuYyW4U/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-mvikg-sample-phenotypes a grlc:grlc-query;
    dct:description "Lists the phenotype and antibiogram observation records that are results of a sample ('partid') of the MVIKG knowledge graph, with description, baseline, associated variant and review status. Only records signed by a current admin, maintainer or member of the mvikg space count, in their newest non-invalidated version; the review status is the latest npx:approvesOf / npx:disapprovesOf verdict of a current mvikg admin on that version (none: pending).";
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    rdfs:label "Get MVIKG phenotypes of a sample";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>
prefix sosa: <http://www.w3.org/ns/sosa/>
prefix biolink: <https://w3id.org/biolink/vocab/>
prefix mvikg: <http://example.org/mvikg/>
prefix obo: <http://purl.obolibrary.org/obo/>

select ?phenotype ?phenotype_label ?description ?compared_to ?variant ?variant_label ?status ?np ?np_label where {
  {
    select ?phenotype ?np (sample(?l) as ?pl) (sample(?c) as ?description) (sample(?ct) as ?compared_to) (sample(coalesce(?varc, ?var)) as ?variant) (min(?varl) as ?vl) (max(?verdict) as ?mv) where {
      service <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces> {
        select (group_concat(distinct ?pk; separator=' ') as ?memberKeys) (group_concat(distinct ?apk; separator=' ') as ?adminKeys) where {
          graph npa:graph { npa:thisRepo npa:hasCurrentSpaceState ?sg . }
          graph ?sg {
            ?ri a gen:RoleInstantiation ; npa:forSpace <https://w3id.org/spaces/mvikg> ; npa:hasRoleType ?tier ; npa:forAgent ?agent .
            filter(?tier in (gen:AdminRole, gen:MaintainerRole, gen:MemberRole))
            ?acct a npa:AccountState ; npa:agent ?agent ; npa:pubkey ?pk .
            bind(if(?tier = gen:AdminRole, ?pk, '') as ?apk)
          }
        }
      }
      {
        select distinct ?alias where {
          { bind(?_partid_iri as ?alias) }
          union
          { graph npa:graph { ?cur npx:introduces ?_partid_iri . ?cur npx:supersedes* ?old . ?old npx:introduces ?alias . } }
        }
      }
      graph ?a { ?phenotype sosa:isResultOf ?alias . ?phenotype a biolink:PhenotypicFeature ; dct:isPartOf <https://w3id.org/spaces/mvikg/r/kg> . }
      graph npa:graph {
        ?np np:hasAssertion ?a ; npx:introduces ?phenotype ; dct:created ?date ;
            npa:hasValidSignatureForPublicKeyHash ?pubkey .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      }
      filter(contains(?memberKeys, ?pubkey))
      optional {
        graph npa:graph {
          ?np2 npx:introduces ?phenotype ; dct:created ?date2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 .
          filter not exists { ?inv2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
        }
        filter(contains(?memberKeys, ?pubkey2) && concat(str(?date2), '>', str(?np2)) > concat(str(?date), '>', str(?np)))
      }
      filter(!bound(?np2))
      optional { graph ?a { ?phenotype rdfs:label ?l } }
      optional { graph ?a { ?phenotype rdfs:comment ?c } }
      optional { graph ?a { ?phenotype mvikg:comparedTo ?ct } }
      optional { graph ?a { ?phenotype mvikg:isAssociatedWithVariant ?var } }
      optional {
        graph npa:graph {
          ?varonp npx:introduces ?var . ?varnp npx:supersedes* ?varonp ; npx:introduces ?varc ; rdfs:label ?varl ;
               npa:hasValidSignatureForPublicKeyHash ?varpk .
          filter not exists { ?varinv npx:invalidates ?varnp ; npa:hasValidSignatureForPublicKeyHash ?varpk . }
        }
      }
      optional {
        values ?vpred { npx:approvesOf npx:disapprovesOf }
        graph ?va { ?vagent ?vpred ?np . }
        graph npa:graph {
          ?vnp np:hasAssertion ?va ; dct:created ?vdate ; npa:hasValidSignatureForPublicKeyHash ?vpk .
          filter not exists { ?vinv npx:invalidates ?vnp ; npa:hasValidSignatureForPublicKeyHash ?vpk . }
        }
        filter(contains(?adminKeys, ?vpk))
        bind(concat(str(?vdate), '>', if(?vpred = npx:disapprovesOf, 'd', 'a')) as ?verdict)
      }
    } group by ?phenotype ?np
  }
  bind(coalesce(str(?pl), replace(str(?phenotype), '^.*/np/', '')) as ?phenotype_label)
  bind(coalesce(str(?vl), replace(str(?variant), '^.*/np/', '')) as ?variant_label)
  bind(if(!bound(?mv), '⏳ pending', if(strends(?mv, 'd'), '🚫 rejected', '✅ approved')) as ?status)
  bind('^' as ?np_label)
}
order by ?phenotype_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

