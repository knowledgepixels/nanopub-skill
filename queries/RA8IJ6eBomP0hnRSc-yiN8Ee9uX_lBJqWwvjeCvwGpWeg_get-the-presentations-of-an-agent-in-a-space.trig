    npx:hasSignature "pujgmdWcJHsBDgyz1xTExuYsLTuBAHTsmRHgk/h32KgVyKR/qUWr5XHLEjftehoEaJD0O6OoOm4lJ6u+VaDlk5HfQd4MXW9cvpks+8XgdZubKJzJMG1Cz5/VyQKD4DdR8O+2R9/5s8yggUGiCbpkSHB3/S+tsWQtg0p/WSWB4tk=";
