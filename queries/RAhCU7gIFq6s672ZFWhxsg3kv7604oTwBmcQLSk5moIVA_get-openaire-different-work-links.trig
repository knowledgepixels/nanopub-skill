    npx:hasSignature "OArMXa+nXrigfltBo+uQ92nrEVODhGALkDe6WY4+p3fHv25LiLrPFDmwOcbGGD/gFACtbZ/d4jRdcYJvrdccZNliChiEk3tX+SdkV0mVqzQEOZIAvP6Cf0Ng4dKzWjj5pKRnbMe/omWdrIXberVQk/DpR/fe78eBewPcjuaaOyI=";
