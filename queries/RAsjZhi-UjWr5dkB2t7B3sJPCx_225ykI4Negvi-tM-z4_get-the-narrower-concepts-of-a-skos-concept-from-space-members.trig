@prefix sub: <https://w3id.org/np/RAsjZhi-UjWr5dkB2t7B3sJPCx_225ykI4Negvi-tM-z4/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-narrower-concepts-from-space-members a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Given an individual SKOS concept, this query returns the concepts that declare it as their broader concept (skos:broader) within the same scheme, for a listing on the concept's part page. The scheme is taken from the given concept's own latest non-invalidated definition, and the maintaining space and its validated member public-key hashes are then resolved server-side from the spaces repo (/repo/spaces); only narrower concepts published by an admin, maintainer or member of that space are listed, and observers are excluded because that tier is self-attestable. A concept whose scheme is not a registered maintained resource therefore yields no rows. Each narrower concept appears at most once: of all non-invalidated member-published definitions placing it under this broader concept in this scheme, only the latest by nanopublication timestamp is kept (ties broken by nanopublication URI), so an in-place override replaces the earlier row rather than adding one, and a new version that drops the skos:broader link removes the row. Labels and definitions prefer an untagged literal but fall back to a language-tagged one, so a concept labelled only in a tagged language still shows a label and never duplicates its row across languages. The status column is a multi-value literal listing the curation states of the winning definition: \"deprecated\" (owl:DeprecatedClass, or owl:deprecated true), \"withdrawn\" (gen:WithdrawnTerm), \"draft\" (npx:DraftNanopub) and \"example\" (npx:ExampleNanopub), in that order. The override_target column is action data rather than content: it carries the row's nanopublication so that a view can offer a per-row in-place re-edit action.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the narrower concepts of a SKOS concept from space members";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/af79dec054ac75f59327aa4e560e3ed0c243130f9852d4e7027aee5beefed2f3>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix gen: <https://w3id.org/kpxl/gen/terms/>

select ?concept (strafter(?labelWin, \"|\") as ?concept_label) (strafter(?descWin, \"|\") as ?description)
       ?status_multi ?last_modified (?np as ?override_target) ?np ?np_label where {
  select ?concept (min(?labelRank) as ?labelWin) (min(?descRank) as ?descWin)
         ?status_multi (sample(?date) as ?last_modified) ?np (\"^\" as ?np_label) where {
    graph npa:graph {
      ?pnp npx:hasNanopubType skos:Concept ;
           npa:hasValidSignatureForPublicKeyHash ?ppubkey ;
           npx:introduces ?_concept_iri ;
           np:hasAssertion ?pa .
      filter not exists { ?pinv npx:invalidates ?pnp ; npa:hasValidSignatureForPublicKeyHash ?ppubkey . }
    }
    graph ?pa { ?_concept_iri skos:inScheme ?scheme . }
    service <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces> {
      select ?scheme (group_concat(?mpk; separator=\" \") as ?memberPubkeys) where {
        graph npa:graph { npa:thisRepo npa:hasCurrentSpaceState ?stateG . }
        graph ?stateG {
          ?scheme npa:isMaintainedBy? ?space .
          ?ri a gen:RoleInstantiation ; npa:forSpace ?space ; npa:forAgent ?agent ;
              npa:hasRoleType ?rt .
          filter(?rt in (gen:AdminRole, gen:MaintainerRole, gen:MemberRole))
          ?acct a npa:AccountState ; npa:agent ?agent ; npa:pubkey ?mpk .
        }
      } group by ?scheme
    }
    graph npa:graph {
      ?np npx:hasNanopubType skos:Concept .
      ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
      filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      ?np dct:created ?date .
      ?np npx:introduces ?concept .
      ?np np:hasAssertion ?a .
    }
    filter(contains(?memberPubkeys, ?pubkey))
    graph ?a {
      ?concept skos:broader ?_concept_iri .
      ?concept skos:inScheme ?scheme .
      optional { ?concept skos:prefLabel ?label . }
      optional { ?concept skos:definition ?definition . }
    }
    bind(concat(if(lang(?label) = \"\", \"1\", \"2\"), \"|\", str(?label)) as ?labelRank)
    bind(concat(if(lang(?definition) = \"\", \"1\", \"2\"), \"|\", str(?definition)) as ?descRank)
    bind(replace(concat(
      if(exists { graph ?a { ?concept a owl:DeprecatedClass } }
         || exists { graph ?a { ?concept owl:deprecated true } }, \"deprecated\\n\", \"\"),
      if(exists { graph ?a { ?concept a gen:WithdrawnTerm } }, \"withdrawn\\n\", \"\"),
      if(exists { graph npa:graph { ?np npx:hasNanopubType npx:DraftNanopub } }, \"draft\\n\", \"\"),
      if(exists { graph npa:graph { ?np npx:hasNanopubType npx:ExampleNanopub } }, \"example\\n\", \"\")
    ), \"\\n$\", \"\") as ?status_multi)
    filter not exists {
      graph npa:graph {
        ?np2 npx:hasNanopubType skos:Concept .
        ?np2 npa:hasValidSignatureForPublicKeyHash ?pubkey2 .
        filter not exists { ?np2x npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
        ?np2 dct:created ?date2 .
        ?np2 npx:introduces ?concept .
        ?np2 np:hasAssertion ?a2 .
      }
      filter(contains(?memberPubkeys, ?pubkey2))
      graph ?a2 { ?concept skos:broader ?_concept_iri ; skos:inScheme ?scheme . }
      filter(?date2 > ?date || (?date2 = ?date && str(?np2) > str(?np)))
    }
  } group by ?concept ?status_multi ?np
}
group by ?concept ?labelWin ?descWin ?status_multi ?last_modified ?np ?np_label
order by ?concept_label""" .
}

