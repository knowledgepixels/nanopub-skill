            filter not exists { ?oixinst npx:invalidates ?onpinst ; npa:hasValidSignatureForPublicKeyHash ?opkinst . }
            filter not exists { ?osxinst npx:supersedes ?onpinst . }
          }
          filter(contains(?memberPubkeys, ?opkinst))
