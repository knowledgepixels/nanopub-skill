@prefix sub: <https://w3id.org/np/RA2bxIg8vz95gwYZYOP36ED73mH3GIISZg8AOks9emuQw/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-qualified-users a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns all users who have been qualified by GO FAIR Foundation as either an Implementer, Facilitator or Trainer.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get Implementers, Facilitators and Trainers";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix dct: <http://purl.org/dc/terms/>
prefix tpff: <https://w3id.org/fair/3pff/>
prefix schema: <https://schema.org/>
prefix dcat: <https://www.w3.org/ns/dcat#>
prefix foaf: <http://xmlns.com/foaf/0.1/>

select ?user (min(?name) as ?user_label) 
	(group_concat(distinct ?qtype_label; separator=\", \") as ?qualification)
	(max(?startdate) as ?qualified_on) 
	(min(?np) as ?np) (\"^\" as ?np_label) 
where {
  graph npa:graph {
    ?np npx:hasNanopubType tpff:3PFF-Qualification .
    ?np npa:hasValidSignatureForPublicKeyHash ?pk .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pk . }
    ?np np:hasAssertion ?a .
  }
  graph ?a {
    ?np tpff:issued-to ?user .
    ?np npx:qualifies ?qtype .
    optional { ?np <https://schema.org/issuedBy>|<http://schema.org/issuedBy> ?issuer . }
    optional { ?np <https://www.w3.org/ns/dcat#startDate>|<http://www.w3.org/ns/dcat#startDate> ?startdate . }
  }
  bind(replace(str(?qtype), \"^.*/\", \"\") as ?qtype_label)
  optional {
    graph npa:graph { ?inp np:hasAssertion ?ia ; npa:hasValidSignatureForPublicKey ?ipk . filter not exists { ?ix npx:invalidates ?inp ; npa:hasValidSignatureForPublicKey ?ipk . } }
    graph ?ia { ?decl npx:declaredBy ?user . ?user foaf:name ?name . }
  }
} group by ?user order by ?user_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

