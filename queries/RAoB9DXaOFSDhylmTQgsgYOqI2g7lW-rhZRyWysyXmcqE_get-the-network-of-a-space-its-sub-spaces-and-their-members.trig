@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-space-network a grlc:grlc-query;
    dct:description "Returns the space family around a space as a network, one row per edge, for a network view (gen:NetworkView): the space's parent, its sub-spaces at any depth, and the agents holding a validated role in any of them, with the role tier as the relation. Each relation carries its type, so sub-space edges and the several role tiers are drawn in colours of their own. Agents carry their name; spaces are left to be named by the renderer. Hosted on the spaces repo, reading the current validated space state.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the network of a space, its sub-spaces and their members";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces>;
    grlc:sparql """prefix npa: <http://purl.org/nanopub/admin/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>
prefix foaf: <http://xmlns.com/foaf/0.1/>

select distinct ?source ?source_label ?source_type
       ?edge_type ?edge_label
       ?target ?target_label ?target_type
       ?np ('^' as ?np_label)
where {
  # The state graph is resolved and read in the same query, so a rebuild cannot
  # leave this reading a graph that no longer exists.
  graph npa:graph { <http://purl.org/nanopub/admin/thisRepo> npa:hasCurrentSpaceState ?g . }
  {
    # The space this page is about, under its parent.
    graph ?g { ?_resource_iri npa:isSubSpaceOf ?parent . }
    bind(?parent as ?source)
    bind(?_resource_iri as ?target)
    bind(gen:Space as ?source_type)
    bind(gen:Space as ?target_type)
    bind(npa:hasSubSpace as ?edge_type)
    bind(\"has sub-space\" as ?edge_label)
  } union {
    # Its sub-spaces, at any depth.
    graph ?g { ?_resource_iri npa:hasSubSpace* ?space . ?space npa:hasSubSpace ?child . }
    bind(?space as ?source)
    bind(?child as ?target)
    bind(gen:Space as ?source_type)
    bind(gen:Space as ?target_type)
    bind(npa:hasSubSpace as ?edge_type)
    bind(\"has sub-space\" as ?edge_label)
  } union {
    # Everyone holding a validated role in the space or in one of its sub-spaces. An
    # agent in several of them links those spaces together, which is what makes this
    # worth drawing rather than listing. The role tier is the relation's type, so each
    # tier is drawn in its own colour.
    graph ?g {
      ?_resource_iri npa:hasSubSpace* ?space .
      ?ri a gen:RoleInstantiation ;
        npa:forSpace ?space ;
        npa:forAgent ?agent ;
        npa:hasRoleType ?tier ;
        npa:viaNanopub ?grantNp .
    }
    optional { graph ?g { ?agent foaf:name ?agentName . } }
    bind(?space as ?source)
    bind(?agent as ?target)
    bind(gen:Space as ?source_type)
    bind(gen:IndividualAgent as ?target_type)
    bind(?agentName as ?target_label)
    bind(?tier as ?edge_type)
    bind(lcase(replace(replace(str(?tier), \"^.*/\", \"\"), \"Role$\", \"\")) as ?edge_label)
    bind(?grantNp as ?np)
  }
}""" .
}

