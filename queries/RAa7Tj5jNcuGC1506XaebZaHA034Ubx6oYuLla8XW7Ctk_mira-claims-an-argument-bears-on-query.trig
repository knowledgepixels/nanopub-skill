sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-mira-bears-on a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Lists the MIRA claims that the record on this page supports or opposes, with the stance, who asserted the link and when. The inverse of the supporting and opposing views, so an evidence item or claim can be followed onward rather than being a dead end. Takes the part IRI in the partid placeholder.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "MIRA claims an argument bears on (query)";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/5ee93356ac9163d743a44466ee5cae3e537a0bb429b81354f72799d7f700c947>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix mira: <http://purl.org/mira-science/mira#>
prefix dct: <http://purl.org/dc/terms/>
prefix npx: <http://purl.org/nanopub/x/>
prefix npa: <http://purl.org/nanopub/admin/>
prefix np: <http://www.nanopub.org/nschema#>
prefix foaf: <http://xmlns.com/foaf/0.1/>

select ?claim ?claim_label ?stance ?asserted_by ?asserted_by_label ?date
       ?np (\"^\" as ?np_label) where {
  graph ?la { ?_partid_iri ?stancePred ?claim . }
  values (?stancePred ?stance) { (mira:supports \"supports\") (mira:opposes \"opposes\") }
  graph npa:graph { ?np np:hasAssertion ?la ; dct:creator ?asserted_by ; dct:created ?date . }
  optional {
    select ?np (sample(?n) as ?asserterName) where {
      graph npa:graph { ?np np:hasPublicationInfo ?pi ; dct:creator ?c8 . }
      graph ?pi { ?c8 foaf:name ?n . }
    } group by ?np
  }
  bind(coalesce(?asserterName, \"\") as ?asserted_by_label)
  optional { graph ?cg { ?claim a mira:Claim ; dct:title ?ct . } }
  bind(coalesce(?ct, \"\") as ?claim_label)
} order by ?stance""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

