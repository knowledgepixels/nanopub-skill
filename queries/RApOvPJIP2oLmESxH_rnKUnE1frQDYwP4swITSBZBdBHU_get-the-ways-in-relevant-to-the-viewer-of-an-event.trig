    npx:hasSignature "WY7M51l7e4Zwyz0c68S+ZnigxKwDBnmvevJEXenqI8glkwHGGgX96PFObRZY1q5kTyjnHe/g3Y8IShBBj2teVhyv0uGD72Qo65rRzpUTmJaYQfs5/KiMHK4Bz2Y1NpeG3QRa/gxMOeKlQqxKVUpoA0QEO+VE8dF2v0AFL1VI7mo=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

