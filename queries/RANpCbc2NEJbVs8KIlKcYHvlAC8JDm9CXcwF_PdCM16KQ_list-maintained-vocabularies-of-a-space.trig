sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:list-maintained-vocabularies a grlc:grlc-query;
    dct:description "Lists the vocabularies maintained by a given space: the maintained resources of the space (from the validated space state of the spaces repository) whose declaration types them as an OWL ontology (owl:Ontology) or a SKOS concept scheme (skos:ConceptScheme, in both the current 2004/02/skos/core and the legacy 2008/05/skos namespace), each with its label and kind (OWL ontology / SKOS vocabulary). Ordered alphabetically by label.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "List maintained vocabularies of a space";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix dct: <http://purl.org/dc/terms/>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix gen: <https://w3id.org/kpxl/gen/terms/>

select ?vocabulary (coalesce(min(if(lang(?label) = \"\", ?label, ?nolabel)), min(?label)) as ?vocabulary_label) (min(?kindx) as ?kind) where {
  values ?_space_multi_iri {}
  graph npa:graph { <http://purl.org/nanopub/admin/thisRepo> npa:hasCurrentSpaceState ?g . }
  graph ?g { ?_space_multi_iri npa:hasMaintainedResource ?vocabulary . }
  values (?type ?kindx) {
    (owl:Ontology \"OWL ontology\")
    (<http://www.w3.org/2004/02/skos/core#ConceptScheme> \"SKOS vocabulary\")
    (<http://www.w3.org/2008/05/skos#ConceptScheme> \"SKOS vocabulary\")
  }
  graph ?ag { ?vocabulary a ?type ; rdfs:label ?label . }
} group by ?vocabulary order by lcase(str(?vocabulary_label))""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

