    npx:hasSignature "VY79MhqzyPTJFkMYOR0OVIN6yRUlBXV0BqEuyZ3y8tV8Mn4yEUsFxXpeiqroofEc+/XPNUKm77SYsRJ7s4biW3MUV9i+6gHCceld10t9Il6tKd42ju8cN2gj4ZqptTFDnwNDtpz9mOyfXMgxE2rtV0keIL4cxz3olxfN0V0wvCU=";
    npx:hasSignatureTarget this:;
