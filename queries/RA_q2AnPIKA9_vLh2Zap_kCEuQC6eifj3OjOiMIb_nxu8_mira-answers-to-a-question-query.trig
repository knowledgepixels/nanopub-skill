@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-mira-answers a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Lists the MIRA claims that address the question on this page, each with the tally of evidence supporting and opposing it and a derived status, so the competing answers can be compared side by side. Takes the part IRI in the partid placeholder.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "MIRA answers to a question (query)";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/5ee93356ac9163d743a44466ee5cae3e537a0bb429b81354f72799d7f700c947>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix mira: <http://purl.org/mira-science/mira#>
prefix dct: <http://purl.org/dc/terms/>
prefix npx: <http://purl.org/nanopub/x/>
prefix npa: <http://purl.org/nanopub/admin/>
prefix np: <http://www.nanopub.org/nschema#>
prefix foaf: <http://xmlns.com/foaf/0.1/>

select ?claim ?claim_label ?flags ?status ?supporting ?opposing
       ?creator ?creator_label ?date ?np (\"^\" as ?np_label) where {
  {
    select ?claim (sample(?t) as ?claim_label) where {
      graph ?ca { ?claim a mira:Claim ; dct:title ?t ; mira:addresses ?_partid_iri . }
    } group by ?claim
  }
  optional {
    select ?claim (count(distinct ?s) as ?sup) where { graph ?sg { ?s mira:supports ?claim . } } group by ?claim
  }
  optional {
    select ?claim (count(distinct ?o) as ?opp) where { graph ?og { ?o mira:opposes ?claim . } } group by ?claim
  }
  bind(coalesce(?sup, 0) as ?supporting)
  bind(coalesce(?opp, 0) as ?opposing)
  bind(if(?supporting > 0 && ?opposing > 0, \"contested\",
       if(?supporting > 0, \"supported\",
       if(?opposing > 0, \"disputed\", \"no evidence yet\"))) as ?status)
  graph npa:graph { ?np npx:introduces ?claim ; dct:creator ?creator ; dct:created ?date . }
  optional {
    select ?np (sample(?n) as ?creatorName) where {
      graph npa:graph { ?np np:hasPublicationInfo ?pi ; dct:creator ?c9 . }
      graph ?pi { ?c9 foaf:name ?n . }
    } group by ?np
  }
  bind(coalesce(?creatorName, \"\") as ?creator_label)
  optional {
    select ?np (group_concat(distinct ?flag; separator=\", \") as ?flagList) where {
      graph npa:graph { ?np npx:hasNanopubType ?flagType . }
      values (?flagType ?flag) { (npx:ExampleNanopub \"Example\") }
    } group by ?np
  }
  bind(coalesce(?flagList, \"\") as ?flags)
} order by desc(?supporting)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

