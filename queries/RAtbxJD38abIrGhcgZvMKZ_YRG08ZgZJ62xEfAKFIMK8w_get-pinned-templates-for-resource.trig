sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-pinned-templates-for-resource a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns the pinned templates for the given resource (Space, agent, or other resource), with the label recorded when each was pinned.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get pinned templates for resource";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/5061d4f8ce945becd54000fab7645326faad3024f83998d8613ecc5e92c595e5>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix nt: <https://w3id.org/np/o/ntemplate/>
prefix gen: <https://w3id.org/kpxl/gen/terms/>

# template_iri is rendered by Nanodash as a link to the template's form (latest version),
# labelled with template_iri_label; where a pin recorded no label, Nanodash uses the
# template's own label.
select ?template_iri ?template_iri_label ?np (\"^\" as ?np_label) where {
  graph npa:graph {
    ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
    ?np npx:hasNanopubType gen:hasPinnedTemplate .
    ?np dct:created ?date .
    ?np np:hasAssertion ?a .
    ?np np:hasPublicationInfo ?pi .
  }
  graph ?a {
    values ?_resource_multi_iri {}
    ?_resource_multi_iri gen:hasPinnedTemplate ?template_iri .
  }
  optional { graph ?pi { ?template_iri nt:hasLabelFromApi ?api_label } }
  bind(if(contains(?api_label, \" - \"), strbefore(?api_label, \" - \"), ?api_label) as ?template_iri_label)
} order by desc(?date)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

