@prefix this: <https://w3id.org/np/RAunFyhxTUm28DbHz-84zi6MEmzPUWRV1wMbTVebIwmIo> .
@prefix sub: <https://w3id.org/np/RAunFyhxTUm28DbHz-84zi6MEmzPUWRV1wMbTVebIwmIo/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-claim-info a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns the basic information about a claim as a property/value table, for the page of that claim (its IRI passed as the 'claim' parameter). Everything is read from the claim's current definition: of all validly signed, non-invalidated nanopublications that introduce the claim, the newest one (ties broken by nanopublication URI). The weight of evidence is the claim's own delphi:weightOfEvidence where it declares one, otherwise the score of its overall assessment -- the assessment it links to with delphi:hasAssessment whose delphi:assessmentType ends in '/overall', read from delphi:hasProbability or delphi:weightOfEvidence, whichever that assessment carries -- on the scale from 0 to 1 rounded to two decimals; the verdict comes from the same overall assessment, and where several exist the newest by nanopublication timestamp wins. The domain and the publishing agent are given as IRIs, with a label only where the nanopublication supplies one, so that Nanodash names them from its own registries otherwise. Rows whose value is empty are left out, so a claim that declares no context or no verdict simply has fewer rows. Both columns carry the _noheader marker, so the table renders without a header row.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the basic information about a claim";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix prov: <http://www.w3.org/ns/prov#>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix delphi: <https://w3id.org/delphi/ontology/>

select ?Property_noheader ?Value_noheader ?Value_label where {
  {
    select ?np
           (min(?descriptionV) as ?description)
           (min(?contextV) as ?context)
           (min(?claimWeightStrV) as ?claimWeightStr)
           (max(?scoreRankV) as ?scoreRank)
           (max(?verdictRankV) as ?verdictRank)
           (min(?domainStrV) as ?domainStr)
           (min(?domainLabelV) as ?domainLabel)
           (min(?byStrV) as ?byStr)
           (min(?byNameV) as ?byName)
           (min(?dateV) as ?date)
    where {
      values ?_claim_multi_iri {}
      graph npa:graph {
        ?np npx:introduces ?_claim_multi_iri ;
          np:hasAssertion ?a ;
          np:hasProvenance ?prov ;
          np:hasPublicationInfo ?pi ;
          dct:created ?dateV ;
          npa:hasValidSignatureForPublicKeyHash ?pubkey .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      }
      graph ?a { ?_claim_multi_iri a delphi:Claim }
      filter not exists {
        graph npa:graph {
          ?np2 npx:introduces ?_claim_multi_iri ;
            np:hasAssertion ?a2 ;
            dct:created ?date2 ;
            npa:hasValidSignatureForPublicKeyHash ?pubkey2 .
          filter not exists { ?inv2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
        }
        graph ?a2 { ?_claim_multi_iri a delphi:Claim }
        filter(?date2 > ?dateV || (?date2 = ?dateV && str(?np2) > str(?np)))
      }
      optional { graph ?a { ?_claim_multi_iri dct:description ?descriptionV } }
      optional { graph ?a { ?_claim_multi_iri delphi:context ?contextV } }
      optional {
        graph ?a { ?_claim_multi_iri delphi:weightOfEvidence ?claimWeight }
        bind(xsd:integer(round(?claimWeight * 100)) as ?cwPct)
        bind(if(?cwPct >= 100, \"1.00\",
             concat(\"0.\", if(?cwPct < 10, concat(\"0\", str(?cwPct)), str(?cwPct)))) as ?claimWeightStrV)
      }
      optional { graph ?pi { ?np delphi:domain ?domainV } bind(str(?domainV) as ?domainStrV) }
      optional { graph ?pi { ?domainV rdfs:label ?domainLabelV } }
      optional { graph ?prov { ?a prov:wasAttributedTo ?byV } bind(str(?byV) as ?byStrV) }
      optional { graph ?pi { ?byV foaf:name ?byNameV } }
      optional {
        graph ?gb { ?_claim_multi_iri delphi:hasAssessment ?overall }
        graph npa:graph {
          ?onp npx:introduces ?overall ;
            np:hasAssertion ?oa ;
            np:hasPublicationInfo ?opi ;
            dct:created ?odate ;
            npa:hasValidSignatureForPublicKeyHash ?opubkey .
          filter not exists { ?oinv npx:invalidates ?onp ; npa:hasValidSignatureForPublicKeyHash ?opubkey . }
        }
        { graph ?oa { ?overall delphi:assessmentType ?atype } }
        union
        { graph ?opi { ?onp delphi:assessmentType ?atype } }
        filter(strends(str(?atype), \"/overall\"))
        optional { graph ?oa { ?overall delphi:hasProbability ?p1 } }
        optional { graph ?oa { ?overall delphi:weightOfEvidence ?p2 } }
        optional { graph ?oa { ?overall delphi:hasVerdict ?overallVerdict } }
        bind(coalesce(?p1, ?p2) as ?oscore)
        bind(xsd:integer(round(?oscore * 100)) as ?oPct)
        bind(concat(str(?odate), \"|\",
             if(?oPct >= 100, \"1.00\",
             concat(\"0.\", if(?oPct < 10, concat(\"0\", str(?oPct)), str(?oPct))))) as ?scoreRankV)
        bind(concat(str(?odate), \"|\", str(?overallVerdict)) as ?verdictRankV)
      }
    } group by ?np
  }
  bind(if(bound(?scoreRank), strafter(?scoreRank, \"|\"), \"\") as ?overallScore)
  bind(if(bound(?claimWeightStr), ?claimWeightStr, ?overallScore) as ?weightS)
  bind(if(bound(?verdictRank), strafter(?verdictRank, \"|\"), \"\") as ?verdictS)
  bind(coalesce(?description, \"\") as ?descriptionS)
  bind(coalesce(?context, \"\") as ?contextS)
  bind(coalesce(?domainStr, \"\") as ?domainS)
  bind(coalesce(?byStr, \"\") as ?byS)
  values (?k ?Property_noheader ?ord) {
    (\"description\" \"Claim:\" 1)
    (\"context\" \"Context:\" 2)
    (\"weight\" \"Weight of evidence:\" 3)
    (\"verdict\" \"Verdict:\" 4)
    (\"domain\" \"Domain:\" 5)
    (\"by\" \"Published by:\" 6)
    (\"date\" \"Published on:\" 7)
    (\"np\" \"Nanopublication:\" 8)
  }
  bind(if(?k = \"description\", ?descriptionS,
       if(?k = \"context\", ?contextS,
       if(?k = \"weight\", ?weightS,
       if(?k = \"verdict\", ?verdictS,
       if(?k = \"domain\", ?domainS,
       if(?k = \"by\", ?byS,
       if(?k = \"date\", str(?date), str(?np))))))))  as ?Value_noheader)
  filter(?Value_noheader != \"\")
  bind(if(?k = \"domain\", coalesce(?domainLabel, \"\"),
       if(?k = \"by\", coalesce(?byName, \"\"),
       if(?k = \"np\", substr(replace(str(?np), \"^.*/np/\", \"\"), 1, 10), \"\"))) as ?Value_label)
}
order by ?ord""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

