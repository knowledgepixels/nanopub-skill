    npx:hasSignature "QVNZyyOo5ZUZlg2mdIgmAaiKGhNoH2d4THZYjXy2SN7GefjXznYNPp+ZbYVIXcKbTWsOKAPGbA8PrIhLQdss/6B0VAZu0+NjQ+I1fYRSL6st02o3IedxAohp9damrIFELcUdD1cAG0Of+NjwoTwD9909k+eo8V6vKNCa+9uwYCo=";
