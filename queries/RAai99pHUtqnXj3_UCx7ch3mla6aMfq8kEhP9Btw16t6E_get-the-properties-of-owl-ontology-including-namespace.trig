@prefix sub: <https://w3id.org/np/RAai99pHUtqnXj3_UCx7ch3mla6aMfq8kEhP9Btw16t6E/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-properties-of-ontology-ns a grlc:grlc-query;
    dct:description "This query returns all properties that specify to be part of a given ontology or use its namespace. Of several versions of the same property, only the newest valid declaration is shown.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the properties of OWL ontology including namespace";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/0ecf438131f3cf9e7777966e39e6c8302684a3d64cf48d80902cc0f66fc85fe6>;
    grlc:sparql """prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix skos: <http://www.w3.org/2004/02/skos/core#>

select ?property
       (coalesce(min(?property_label_u), min(?property_label_a)) as ?property_label)
       (coalesce(min(?definition_u), min(?definition_a)) as ?description)
       ?np (\"^\" as ?np_label) where {
  values ?_ontology_multi_iri {}
  {
    select ?property (iri(strafter(max(concat(str(?date0), \"|\", str(?np0))), \"|\")) as ?np) where {
      values ?_ontology_multi_iri {}
      graph npa:graph {
        ?np0 npx:hasNanopubType rdf:Property .
        ?np0 npa:hasValidSignatureForPublicKeyHash ?pubkey0 .
        filter not exists { ?npx0 npx:invalidates ?np0 ; npa:hasValidSignatureForPublicKeyHash ?pubkey0 . }
        ?np0 dct:created ?date0 .
        ?np0 npx:introduces ?property .
        ?np0 np:hasAssertion ?a0 .
      }
      graph ?a0 {
        {
          ?property a rdf:Property .
          filter(strstarts(str(?property), ?__ontologyNamespace))
        } union {
          ?property a rdf:Property .
          ?property (dct:partOf|dct:isPartOf) ?_ontology_multi_iri .
        }
      }
    } group by ?property
  }
  graph npa:graph { ?np np:hasAssertion ?a . }
  graph ?a {
    ?property a rdf:Property .
    optional { ?property rdfs:label ?property_label_u . filter(lang(?property_label_u) = \"\") }
    optional { ?property rdfs:label ?property_label_a . }
    optional { ?property skos:definition ?definition_u . filter(lang(?definition_u) = \"\") }
    optional { ?property skos:definition ?definition_a . }
  }
}
group by ?property ?np
order by lcase(str(coalesce(?property_label, \"\")))""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

