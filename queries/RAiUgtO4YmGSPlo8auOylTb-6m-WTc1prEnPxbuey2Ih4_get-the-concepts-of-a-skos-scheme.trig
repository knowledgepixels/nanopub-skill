    npx:embeds sub:get-concepts-of-skos-scheme;
    skos:changeNote "Show only the newest valid declaration of each concept (argmax by creation date, ties broken by nanopub URI); prefer untagged labels and definitions; merge several broader concepts into one multi-value column; sort labels case-insensitively.";
