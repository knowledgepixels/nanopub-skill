    npx:hasSignature "MVm5Ez9dQiNT1ExNVscJ6tKBg9p/HklifK4MKoIqukLsCBLKp5diKaNUo/IZbWBOnRQSBm0HVuFiTdvI53vc7suHfeE0roofttypWJzsuKGe0dY9Bo3sqnNJWtbqa4a+yeP2+aMq6GnuXNLj99KGg+bw6Jz4WqhdEY+I/3czWnE=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}
