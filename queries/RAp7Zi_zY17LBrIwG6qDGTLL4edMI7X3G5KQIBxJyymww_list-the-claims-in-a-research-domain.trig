@prefix this: <https://w3id.org/np/RAp7Zi_zY17LBrIwG6qDGTLL4edMI7X3G5KQIBxJyymww> .
@prefix sub: <https://w3id.org/np/RAp7Zi_zY17LBrIwG6qDGTLL4edMI7X3G5KQIBxJyymww/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:list-claims-in-domain a grlc:grlc-query;
    dct:description "Lists the claims in a research domain, for the page of that domain (its IRI passed as the 'domain' parameter). A claim is in the domain when its current definition declares pk:domain for it in the nanopublication's publication-info graph, which is where ProbKnow records the domain. The tag is read only from the current definition, so a claim whose newest version dropped it is no longer listed, and a nanopublication may carry several domains, so the domains overlap rather than partition the claims. Columns and semantics are those of the space-level claims listing: of all validly signed, non-invalidated nanopublications that introduce a given claim, only the newest by timestamp is read (ties broken by nanopublication URI), so a claim appears once with its current content, and no publisher restriction is applied. The weight of evidence is the claim's own pk:weightOfEvidence where it declares one, otherwise the score of its overall assessment, on the scale from 0 to 1 rounded to two decimals; the verdict comes from that same overall assessment; the assessments column counts the distinct assessments linked by pk:hasAssessment, wherever that triple is asserted -- in the claim's nanopublication or in the assessment's -- which is why the query runs on the full repository. The override_target column is action data rather than content: it carries the row's nanopublication for a per-row in-place re-edit action. Ordered by date, most recent first, then alphabetically by label.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "List the claims in a research domain";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix pk: <https://w3id.org/probknow/ontology/>

select ?claim ?claim_label ?weight_of_evidence ?verdict ?assessments
       ?date
       (?np as ?override_target) ?np (\"^\" as ?np_label) where {
  {
    select ?claim ?np ?date
           (min(?labelRank) as ?labelWin)
           (min(?claimWeightStr) as ?claimWeightWin)
           (max(?scoreRank) as ?scoreWin)
           (max(?verdictRank) as ?verdictWin)
           (count(distinct ?as) as ?assessments)
    where {
      values ?_domain_multi_iri {}
      graph npa:graph {
        ?np npx:hasNanopubType pk:Claim ;
          npa:hasValidSignatureForPublicKeyHash ?pubkey ;
          dct:created ?date ;
          npx:introduces ?claim ;
          np:hasAssertion ?a ;
          np:hasPublicationInfo ?pi .
        filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      }
      # The domain is declared in pubinfo, and only on the claim's current definition:
      # a claim whose newest version dropped the tag is not in the domain any more.
      graph ?pi { ?np pk:domain ?_domain_multi_iri . }
      filter not exists {
        graph npa:graph {
          ?np2 npx:hasNanopubType pk:Claim ;
            npa:hasValidSignatureForPublicKeyHash ?pubkey2 ;
            dct:created ?date2 ;
            npx:introduces ?claim .
          filter not exists { ?inv2 npx:invalidates ?np2 ; npa:hasValidSignatureForPublicKeyHash ?pubkey2 . }
        }
        filter(?date2 > ?date || (?date2 = ?date && str(?np2) > str(?np)))
      }
      graph ?a { ?claim a pk:Claim . optional { ?claim rdfs:label ?label } }
      bind(concat(if(lang(?label) = \"\", \"1\", \"2\"), \"|\", str(?label)) as ?labelRank)
      optional {
        graph ?a { ?claim pk:weightOfEvidence ?claimWeight }
        bind(xsd:integer(round(?claimWeight * 100)) as ?claimWeightPct)
        bind(if(?claimWeightPct >= 100, \"1.00\",
             concat(\"0.\", if(?claimWeightPct < 10, concat(\"0\", str(?claimWeightPct)), str(?claimWeightPct)))) as ?claimWeightStr)
      }
      optional { graph ?ga { ?claim pk:hasAssessment ?as } }
      optional {
        graph ?gb { ?claim pk:hasAssessment ?overall }
        graph npa:graph {
          ?onp npx:introduces ?overall ;
            np:hasAssertion ?oa ;
            np:hasPublicationInfo ?opi ;
            dct:created ?odate ;
            npa:hasValidSignatureForPublicKeyHash ?opubkey .
          filter not exists { ?oinv npx:invalidates ?onp ; npa:hasValidSignatureForPublicKeyHash ?opubkey . }
        }
        { graph ?oa { ?overall pk:assessmentType ?atype } }
        union
        { graph ?opi { ?onp pk:assessmentType ?atype } }
        filter(strends(str(?atype), \"/overall\"))
        optional { graph ?oa { ?overall pk:hasProbability ?p1 } }
        optional { graph ?oa { ?overall pk:weightOfEvidence ?p2 } }
        optional { graph ?oa { ?overall pk:hasVerdict ?overallVerdict } }
        bind(coalesce(?p1, ?p2) as ?overallScore)
        bind(xsd:integer(round(?overallScore * 100)) as ?overallPct)
        bind(concat(str(?odate), \"|\",
             if(?overallPct >= 100, \"1.00\",
             concat(\"0.\", if(?overallPct < 10, concat(\"0\", str(?overallPct)), str(?overallPct))))) as ?scoreRank)
        bind(concat(str(?odate), \"|\", str(?overallVerdict)) as ?verdictRank)
      }
    } group by ?claim ?np ?date
  }
  bind(strafter(?labelWin, \"|\") as ?claim_label)
  bind(if(bound(?verdictWin), strafter(?verdictWin, \"|\"), \"\") as ?verdict)
  bind(if(bound(?claimWeightWin), ?claimWeightWin,
       if(bound(?scoreWin), strafter(?scoreWin, \"|\"), \"\")) as ?weight_of_evidence)
}
order by desc(?date) lcase(?claim_label)""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-10-16T05:29:45Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:list-claims-in-domain;
    rdfs:label "List the claims in a research domain";
