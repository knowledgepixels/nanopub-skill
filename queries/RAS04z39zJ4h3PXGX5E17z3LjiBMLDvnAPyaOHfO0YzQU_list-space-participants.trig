    npx:hasSignature "WkAQDKDPFwRvddsLjKP3PdvK6GfLBirQ6hBg0tPLAp64zNpqCfOLe/EMqhZRLmb5AhPHv+4paqWV77/5zs8kvooI+Kpxrt30gdT7t6OhW9wdzPYq8gqzyasrQUax/s9YwKLofqMVgaWLRS/NvZdw2CGmAFkPkXP4QVStUMDFELQ=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
