@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-stated-relations a grlc:grlc-query;
    dct:description "Returns the relations someone has stated between this talk and another, in both directions at once: the talks this one extends, uses the method or the data of, confirms or disagrees with, and the talks that say so about it. The direction column says which way each row runs. Only CiTO properties count, so an unrelated statement about the talk cannot appear here, and the relation is named by its own property rather than flattened to one word. Nothing is scoped to an event, so a relation may point at a talk in another workshop or another conference. Empty until somebody states a relation, which is what the panel's action is for.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the stated relations of a presentation";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/type/3952cad1a6d2561f045d33e5e79c03e7264b0a492b8becf6c62656c596cf398c>;
    grlc:sparql """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix wd: <http://www.wikidata.org/entity/>

select ?other ?other_label ?direction ?relation_label ?np (\"^\" as ?np_label) where {
  values ?_presentation_multi_iri {}
  graph npa:graph {
    ?rnp npa:hasValidSignatureForPublicKeyHash ?rpk .
    filter not exists { ?rx npx:invalidates ?rnp ; npa:hasValidSignatureForPublicKeyHash ?rpk . }
    filter not exists { ?rnp npx:hasNanopubType npx:ExampleNanopub . }
    ?rnp np:hasAssertion ?ra .
  }
  {
    graph ?ra { ?_presentation_multi_iri ?relation ?other . }
    bind(\"this talk →\" as ?direction)
  } union {
    graph ?ra { ?other ?relation ?_presentation_multi_iri . }
    bind(\"← that talk\" as ?direction)
  }
  filter(strstarts(str(?relation), \"http://purl.org/spar/cito/\"))
  filter(?other != ?_presentation_multi_iri)
  bind(lcase(replace(strafter(str(?relation), \"cito/\"), \"([a-z])([A-Z])\", \"$1 $2\")) as ?relation_label)
  graph npa:graph {
    ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
    ?np np:hasAssertion ?a .
    ?np npx:introduces ?other .
  }
  graph ?a { ?other a wd:Q604733 ; rdfs:label ?other_label . }
} order by ?direction ?other_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

