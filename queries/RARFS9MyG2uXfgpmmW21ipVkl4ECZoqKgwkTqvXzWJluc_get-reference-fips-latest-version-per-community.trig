@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-reference-fips a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "This query returns the reference FAIR Implementation Profiles (rFIPs), one row per community: the rFIP nanopublication with the newest dct:created among those declared by that community. Successive versions of an rFIP are not reliably chained by npx:supersedes -- the FIP wizard supersedes some earlier nanopublication rather than the preceding rFIP -- so filtering on invalidation alone leaves several versions of the same profile in the listing (three for PARC Toxicology). The community given by fip:declared-by is used as the identity of the profile, since each version re-introduces the rFIP under a new IRI and therefore cannot be grouped by it.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get reference FIPs (latest version per community)";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/type/1629a4570fbaa9e1e66389174008a5e7515d9b20d333686449c50ab3aa936e4c>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix fip: <https://w3id.org/fair/fip/terms/>
prefix schema: <https://schema.org/>

select (?rfip as ?rFIP) (?rfip_label as ?rFIP_label) ?version ?community ?np (\"^\" as ?np_label) where {
  {
    select ?community (max(?date) as ?latest) where {
      graph npa:graph {
        ?cnp npx:hasNanopubType fip:Reference-FAIR-Implementation-Profile .
        ?cnp npa:hasValidSignatureForPublicKeyHash ?cpubkey .
        filter not exists { ?cnpx npx:invalidates ?cnp ; npa:hasValidSignatureForPublicKeyHash ?cpubkey . }
        ?cnp dct:created ?date .
        ?cnp np:hasAssertion ?ca .
        ?cnp npx:introduces ?crfip .
      }
      graph ?ca { ?crfip fip:declared-by ?community . }
    } group by ?community
  }
  graph npa:graph {
    ?np npx:hasNanopubType fip:Reference-FAIR-Implementation-Profile .
    ?np npa:hasValidSignatureForPublicKeyHash ?pubkey .
    filter not exists { ?npx npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
    ?np dct:created ?latest .
    ?np np:hasAssertion ?a .
    ?np npx:introduces ?rfip .
  }
  graph ?a {
    ?rfip a fip:Reference-FAIR-Implementation-Profile .
    ?rfip rdfs:label ?rfip_label .
    ?rfip fip:declared-by ?community .
    optional { ?rfip schema:version ?version . }
  }
}
""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

