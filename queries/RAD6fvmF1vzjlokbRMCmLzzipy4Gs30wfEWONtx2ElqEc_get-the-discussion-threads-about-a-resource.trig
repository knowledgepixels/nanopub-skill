@prefix this: <https://w3id.org/np/RAD6fvmF1vzjlokbRMCmLzzipy4Gs30wfEWONtx2ElqEc> .
@prefix sub: <https://w3id.org/np/RAD6fvmF1vzjlokbRMCmLzzipy4Gs30wfEWONtx2ElqEc/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-threads-about-resource a grlc:grlc-query;
    dct:description "Returns the discussion threads whose first contribution is about the given resource (schema:about), with all responses to it at any depth. A contribution is a schema:Statement or schema:Question with its text in rdf:value, following the Nanoarguments model. It responds to another contribution through as:inReplyTo or a rhetorical CiTO stance (supports, disputes, qualifies, agreesWith, and so on) or na:tests, pointing at the contribution itself or at the nanopublication holding it; citation relations such as cito:citesAsEvidence do not make it a response. One row per contribution, in the columns a thread view reads (reply, relation, in_reply_to, by, date); a contribution with no in_reply_to starts a thread. The relation is the CiTO stance where there is one, else asks for a question, answers for a statement responding to a question, and replies otherwise. A contribution republished under the same IRI shows its latest version. Retracted and superseded nanopublications and example nanopublications are left out.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the discussion threads about a resource";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix prov: <http://www.w3.org/ns/prov#>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix schema: <https://schema.org/>
prefix schemah: <http://schema.org/>
prefix as: <https://www.w3.org/ns/activitystreams#>
prefix cito: <http://purl.org/spar/cito/>
prefix na: <https://w3id.org/nanoarguments/>

select ?reply ?reply_label ?relation ?in_reply_to ?by ?by_label ?date ?support_stance ?dispute_stance ?np ?np_label
where {
  {
    select ?reply ?np ?a ?prov ?pi ?date
      (max(if(?ctype = schema:Question, 1, 0)) as ?isQuestion)
      (min(str(?p)) as ?parentStr)
      (min(if(?rel = as:inReplyTo, \"~\", str(?rel))) as ?stanceStr)
      (max(if(bound(?pqa), 1, 0)) as ?toQuestion)
    where {
      {
        # the latest valid, non-example version of each contribution
        select ?reply (max(?created) as ?date) where {
          {
            # the contributions of every thread whose root is about the resource
            select distinct ?reply where {
              {
                select distinct ?root where {
                  graph ?aa { ?anchor schema:about|schemah:about ?_resource_iri . }
                  values ?atype { schema:Statement schema:Question }
                  graph ?aa { ?anchor a ?atype ; rdf:value ?av . }
                  graph npa:graph {
                    ?anp np:hasAssertion ?aa ; npa:hasValidSignatureForPublicKeyHash ?apk .
                    filter not exists { ?ax npx:invalidates ?anp ; npa:hasValidSignatureForPublicKeyHash ?apk . }
                  }
                  bind(?anchor as ?root)
                  filter not exists {
                    values ?rrel {
                      as:inReplyTo na:tests cito:agreesWith cito:confirms cito:corrects
                      cito:critiques cito:derides cito:disagreesWith cito:discusses cito:disputes
                      cito:extends cito:parodies cito:qualifies cito:refutes cito:repliesTo
                      cito:retracts cito:reviews cito:ridicules cito:speculatesOn cito:supports
                      cito:updates
                    }
                    graph ?ra { ?root ?rrel ?rt . }
                    values ?rtt { schema:Statement schema:Question }
                    graph ?rta { ?rt a ?rtt ; rdf:value ?rtv . }
                    filter(?rt != ?root)
                  }
                }
              }
              ?reply (as:inReplyTo|na:tests|cito:agreesWith|cito:confirms|cito:corrects|cito:critiques|cito:derides|cito:disagreesWith|cito:discusses|cito:disputes|cito:extends|cito:parodies|cito:qualifies|cito:refutes|cito:repliesTo|cito:retracts|cito:reviews|cito:ridicules|cito:speculatesOn|cito:supports|cito:updates|npx:introduces)* ?root .
            }
          }
          values ?type { schema:Statement schema:Question }
          graph ?va { ?reply a ?type ; rdf:value ?vv . }
          graph npa:graph {
            ?vnp np:hasAssertion ?va ; np:hasPublicationInfo ?vpi ;
              npa:hasValidSignatureForPublicKeyHash ?vpk ; dct:created ?created .
            filter not exists { ?vx npx:invalidates ?vnp ; npa:hasValidSignatureForPublicKeyHash ?vpk . }
          }
          filter not exists { graph ?vpi { ?vnp npx:hasNanopubType npx:ExampleNanopub . } }
        } group by ?reply
      }
      graph npa:graph { ?np dct:created ?date ; np:hasAssertion ?a ; np:hasProvenance ?prov ; np:hasPublicationInfo ?pi . }
      values ?ctype { schema:Statement schema:Question }
      graph ?a { ?reply a ?ctype ; rdf:value ?cv . }
      # what it responds to: a reply or a CiTO stance toward another contribution
      # (directly, or via the nanopublication that holds it)
      optional {
        values ?rel {
          as:inReplyTo na:tests cito:agreesWith cito:confirms cito:corrects cito:critiques
          cito:derides cito:disagreesWith cito:discusses cito:disputes cito:extends cito:parodies
          cito:qualifies cito:refutes cito:repliesTo cito:retracts cito:reviews cito:ridicules
          cito:speculatesOn cito:supports cito:updates
        }
        graph ?a { ?reply ?rel ?t . }
        optional {
          graph npa:graph { ?t np:hasAssertion ?ta . }
          graph ?ta { ?tn a ?tnt . }
          filter(?tnt in (schema:Statement, schema:Question))
        }
        bind(coalesce(?tn, ?t) as ?p)
        filter(?p != ?reply)
        filter exists {
          values ?ptype { schema:Statement schema:Question }
          graph ?pa { ?p a ?ptype ; rdf:value ?pv . }
          graph npa:graph {
            ?pnp np:hasAssertion ?pa ; npa:hasValidSignatureForPublicKeyHash ?ppk .
            filter not exists { ?px npx:invalidates ?pnp ; npa:hasValidSignatureForPublicKeyHash ?ppk . }
          }
        }
        optional { graph ?pqa { ?p a schema:Question . } }
      }
    } group by ?reply ?np ?a ?prov ?pi ?date
  }
  bind(iri(?parentStr) as ?in_reply_to)
  bind(if(coalesce(?stanceStr, \"~\") != \"~\", ?stanceStr,
         if(?isQuestion = 1, \"asks\",
           if(!bound(?in_reply_to), \"\",
             if(?toQuestion = 1, \"answers\", \"replies\")))) as ?relation)
  optional { graph ?a { ?reply rdf:value ?reply_label . } }
  optional { graph ?prov { ?a prov:wasAttributedTo ?attr . } }
  optional { graph ?pi { ?np dct:creator ?creator . } }
  bind(coalesce(?attr, ?creator) as ?by)
  optional { graph ?pi { ?by foaf:name ?by_label . } }
  bind(cito:supports as ?support_stance)
  bind(cito:disputes as ?dispute_stance)
  bind(\"^\" as ?np_label)
}
order by ?date
""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

