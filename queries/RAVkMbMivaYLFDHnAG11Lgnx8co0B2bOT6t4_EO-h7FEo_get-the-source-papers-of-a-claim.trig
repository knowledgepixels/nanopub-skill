    npx:hasSignature "QrfuO4r/ghZuyfdJlqFqgUX6Bs1Xn8Gn3NrX+TaagY4pZpVmXD6ZDT/8SZmIvXVLIv5bzV8ZxW4holZlCChyjnHQQVivEgBZk20pHEW5i+AeTb1gsFxr439mlyyxs8fPjZtlpY4BS1dqGr3hnxz3SWBfd1X3MVlvuQObbfq+dvk=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

