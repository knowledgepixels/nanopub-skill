@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-reasoning-chain a grlc:grlc-query;
    dct:description "Lists the contributions that test a claim or are derived from it, directly or indirectly.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get reasoning chain for a claim";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix prov: <http://www.w3.org/ns/prov#>
prefix na: <https://w3id.org/nanoarguments/>
prefix schema: <https://schema.org/>

select distinct ?step_iri ?step_iri_label ?relation ?target_iri ?target_iri_label ?user_iri ?np (\"^\" as ?np_label) where {
  values (?rel ?relation) {
    (na:tests \"tests\")
    (prov:wasDerivedFrom \"was derived from\")
  }
  # The claim or anything on its chain.
  ?target_iri (prov:wasDerivedFrom|na:tests)* ?_claim_iri .
  graph npa:graph {
    ?np np:hasAssertion ?a ; np:hasProvenance ?p ;
        npa:hasValidSignatureForPublicKeyHash ?pubkey .
    filter not exists { ?inv npx:invalidates ?np ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
  }
  graph ?a {
    ?step_iri a schema:Statement ; ?rel ?target_iri .
    optional { ?step_iri rdf:value ?step_iri_label }
  }
  optional { ?target_iri rdf:value ?target_iri_label }
  optional { graph ?p { ?a prov:wasAttributedTo ?user_iri } }
}
order by ?target_iri_label ?relation ?step_iri_label""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

