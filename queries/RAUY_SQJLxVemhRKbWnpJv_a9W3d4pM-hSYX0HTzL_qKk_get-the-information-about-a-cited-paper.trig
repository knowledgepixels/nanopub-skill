@prefix this: <https://w3id.org/np/RAUY_SQJLxVemhRKbWnpJv_a9W3d4pM-hSYX0HTzL_qKk> .
@prefix sub: <https://w3id.org/np/RAUY_SQJLxVemhRKbWnpJv_a9W3d4pM-hSYX0HTzL_qKk/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-paper-info a <https://w3id.org/kpxl/grlc/grlc-query>;
    dct:description "Returns what is known about a cited paper as a property/value table, for the page of that paper (its IRI passed as the 'paper' parameter): its title, its year of publication where one is recorded, and how many claims cite it. Project Delphi publishes no nanopublication that defines a paper, so the title is taken from the claim nanopublications (delphi:Claim) whose provenance derives their assertion from the paper with prov:wasDerivedFrom, rather than from any statement about the IRI elsewhere on the network; within those, it is looked up in the assertion graph or the provenance graph (dct:title, and dct:date for the year). The claim count is the number of distinct claims those nanopublications introduce. Where several citing nanopublications give a title or a year, the lexicographically first is shown. Rows whose value is empty are left out, so a paper with no recorded year simply has fewer rows. Both value columns carry the _noheader marker, so the table renders without a header row. This view exists chiefly to name the paper: a paper's part page has no defining nanopublication, so its heading is only the identifier.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the information about a cited paper";
    <https://w3id.org/kpxl/grlc/endpoint> <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    <https://w3id.org/kpxl/grlc/sparql> """prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix prov: <http://www.w3.org/ns/prov#>
prefix delphi: <https://w3id.org/delphi/ontology/>

select ?Property_noheader ?Value_noheader (\"\" as ?Value_label) where {
  {
    select (min(?titleV) as ?title) (min(?yearV) as ?year) (count(distinct ?claim) as ?claims) where {
      values ?_paper_multi_iri {}
      # Scoped to the claim nanopublications whose provenance derives their assertion from
      # this paper, so that the title is the one the citing claims give it and not any
      # statement about the IRI elsewhere on the network. It is read from the assertion
      # graph or the provenance graph of those nanopublications.
      graph npa:graph { ?cnp npx:hasNanopubType delphi:Claim ; npx:introduces ?claim ; np:hasAssertion ?ca ; np:hasProvenance ?cp . }
      graph ?cp { ?ca prov:wasDerivedFrom ?_paper_multi_iri . }
      graph ?ca { ?claim a delphi:Claim . }
      optional {
        graph npa:graph { ?cnp (np:hasAssertion|np:hasProvenance) ?tg . }
        graph ?tg { ?_paper_multi_iri dct:title ?titleV . }
      }
      optional {
        graph npa:graph { ?cnp (np:hasAssertion|np:hasProvenance) ?yg . }
        graph ?yg { ?_paper_multi_iri dct:date ?d . }
        bind(substr(str(?d), 1, 4) as ?yearV)
      }
    }
  }
  bind(coalesce(?title, \"\") as ?titleS)
  bind(coalesce(?year, \"\") as ?yearS)
  values (?k ?Property_noheader ?ord) {
    (\"title\" \"Title:\" 1)
    (\"year\" \"Year:\" 2)
    (\"claims\" \"Cited by:\" 3)
  }
  bind(if(?k = \"title\", ?titleS,
       if(?k = \"year\", ?yearS,
       if(?claims = 1, \"1 claim\", concat(str(?claims), \" claims\")))) as ?Value_noheader)
  filter(?Value_noheader != \"\")
}
order by ?ord""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

