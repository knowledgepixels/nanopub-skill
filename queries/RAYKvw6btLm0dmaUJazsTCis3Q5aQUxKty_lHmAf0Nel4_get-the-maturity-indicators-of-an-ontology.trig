@prefix sub: <https://w3id.org/np/RAYKvw6btLm0dmaUJazsTCis3Q5aQUxKty_lHmAf0Nel4/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-maturity-indicators-of-an-ontology a grlc:grlc-query;
    dct:description "Returns the maturity indicators of a FAIRplus-DSM-style maturity model ontology, one row per indicator, with its code, requirement, maturity level, dimension, category, granularity level or hosting capability, and the FAIR guiding principles it relates to. Only the newest non-invalidated definition of each indicator is returned. Results are ordered by indicator code, which groups them by maturity level and dimension.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the maturity indicators of an ontology";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix np: <http://www.nanopub.org/nschema#>
prefix npa: <http://purl.org/nanopub/admin/>
prefix npx: <http://purl.org/nanopub/x/>
prefix dsm: <https://w3id.org/spaces/fairplus/r/dsm/>
select ?code ?indicator ?indicator_label ?level_label ?dimension_label ?category_label ?scope_label
       (group_concat(distinct ?plabel; separator=\"\\n\") as ?fair_principles_multi)
       (str(?np) as ?override_target) ?np ?np_label
where {
  {
    select ?term (max(?rank) as ?maxrank) where {
      values ?_ontology_multi_iri {}
      graph npa:graph {
        ?np_ npx:hasNanopubType dsm:MaturityIndicator ;
             npa:hasValidSignatureForPublicKeyHash ?pubkey ;
             dct:created ?date ; npx:introduces ?term ; np:hasAssertion ?a .
        filter not exists { ?inv npx:invalidates ?np_ ; npa:hasValidSignatureForPublicKeyHash ?pubkey . }
      }
      graph ?a { ?term dct:isPartOf ?_ontology_multi_iri . }
      bind(concat(str(?date), \"|\", str(?np_)) as ?rank)
    } group by ?term
  }
  graph npa:graph {
    ?np npx:hasNanopubType dsm:MaturityIndicator ;
        dct:created ?d2 ; npx:introduces ?term ; np:hasAssertion ?ag .
  }
  filter(concat(str(?d2), \"|\", str(?np)) = ?maxrank)
  graph ?ag {
    ?term dsm:indicatorCode ?code ; rdfs:label ?indicator_label ;
          dsm:hasMaturityLevel ?level ; dsm:inDimension ?dimension .
  }
  optional { graph ?ag { ?term dsm:hasCategory ?category } }
  optional { graph ?ag { ?term dsm:hasGranularityLevel ?gran } }
  optional { graph ?ag { ?term dsm:concernsCapability ?cap } }
  optional { graph ?ag { ?term dsm:relatedFAIRPrinciple ?principle } }
  bind(?term as ?indicator)
  bind(coalesce(?gran, ?cap, <urn:none>) as ?scope)
  bind(coalesce(?category, <urn:none>) as ?cat)
  optional { { select (?t as ?level) (?tl as ?llab) where {
      values ?_ontology_multi_iri {}
      graph npa:graph { ?lnp npx:introduces ?t ; np:hasAssertion ?la }
      graph ?la { ?t dct:isPartOf ?_ontology_multi_iri ; rdfs:label ?tl }
  } } }
  optional { { select (?t as ?dimension) (?tl as ?dlab) where {
      values ?_ontology_multi_iri {}
      graph npa:graph { ?dnp npx:introduces ?t ; np:hasAssertion ?da }
      graph ?da { ?t dct:isPartOf ?_ontology_multi_iri ; rdfs:label ?tl }
  } } }
  optional { { select (?t as ?cat) (?tl as ?clab) where {
      values ?_ontology_multi_iri {}
      graph npa:graph { ?cnp npx:introduces ?t ; np:hasAssertion ?ca }
      graph ?ca { ?t dct:isPartOf ?_ontology_multi_iri ; rdfs:label ?tl }
  } } }
  optional { { select (?t as ?scope) (?tl as ?slab) where {
      values ?_ontology_multi_iri {}
      graph npa:graph { ?snp npx:introduces ?t ; np:hasAssertion ?sa }
      graph ?sa { ?t dct:isPartOf ?_ontology_multi_iri ; rdfs:label ?tl }
  } } }
  bind(coalesce(?llab, \"\") as ?level_label)
  bind(coalesce(?dlab, \"\") as ?dimension_label)
  bind(coalesce(?clab, \"\") as ?category_label)
  bind(coalesce(?slab, \"\") as ?scope_label)
  bind(replace(str(?principle), \"^.*/\", \"\") as ?plabel)
  bind(\"^\" as ?np_label)
}
group by ?code ?indicator ?indicator_label ?level_label ?dimension_label ?category_label ?scope_label ?np ?np_label
order by ?code
""" .
}

