sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:get-digital-object-type-template-link a grlc:grlc-query;
    dct:description "Returns a single row whose content column holds a ready-made link to the Nanodash publish form for the 'Introducing a Digital Object Type or Methodology in a vocabulary' template (https://w3id.org/np/RAeEN6u4VQazNLXofl2EsDBZ7H7pf3fFkYN-I-1puite8/template), pre-filled with the given ontology or vocabulary as the template's vocabulary field. It backs a minimal plain-paragraph view that offers the 'add a term' step next to a listing view rather than as a view-level action on it, in the same way as 'Get the link to the I-ADOPT-variable template'. In addition, the query looks up the vocabulary's declared namespace and pre-fills the term identifier with that namespace followed by the literal marker <SET-SUFFIX>, which is the same pre-fill that Nanodash itself produces for view actions that declare a template part field, so that the new term is minted inside the vocabulary's namespace and only the short name has to be filled in. The namespace is picked deterministically with a minimum, so that a vocabulary re-declared in several nanopublications still yields a single link. The link is a root-relative /publish URL with template-version=latest, which Nanodash renders as a button and to which it appends the page context automatically, so the same query works on any Nanodash instance and from any resource page. Note that the template is referenced by its embedded IRI (the nanopub URI with the /template suffix) rather than by the nanopublication URI, because that template uses the embedded-identity shape.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Get the link to the Digital-Object-Type-or-Methodology template";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/full>;
    grlc:sparql """prefix gen: <https://w3id.org/kpxl/gen/terms/>

select ?content where {
  values ?_ontology_multi_iri {}
  {
    select (min(?ns0) as ?ns) where {
      values ?_ontology_multi_iri {}
      graph ?g { ?_ontology_multi_iri gen:hasNamespace ?ns0 . }
    }
  }
  bind(concat('<p><a href=\"/publish?template=',
              encode_for_uri('https://w3id.org/np/RAeEN6u4VQazNLXofl2EsDBZ7H7pf3fFkYN-I-1puite8/template'),
              '&template-version=latest&param_vocabulary=',
              encode_for_uri(str(?_ontology_multi_iri)),
              coalesce(concat('&param_thing=', encode_for_uri(concat(str(?ns), '<SET-SUFFIX>'))), ''),
              '\">➕ introduce a new digital object type or methodology...</a></p>') as ?content)
}""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

