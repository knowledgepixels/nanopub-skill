    gen:hasActionTemplate <https://w3id.org/np/RALLhFXriQjVFESflcok4WIpBW5W0Zh9horxrvcACD1Mw/templateVersion>;
    gen:hasActionTemplateQueryMapping "restore_target:@override restore_template:@template";
