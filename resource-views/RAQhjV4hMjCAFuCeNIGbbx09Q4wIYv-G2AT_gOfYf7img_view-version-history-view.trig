  sub:viewVersion a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:view-version-history-view;
    dct:title "🕓 Version history";
    rdfs:label "View version history view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:hasStructuralPosition "4.1.versionHistory";
