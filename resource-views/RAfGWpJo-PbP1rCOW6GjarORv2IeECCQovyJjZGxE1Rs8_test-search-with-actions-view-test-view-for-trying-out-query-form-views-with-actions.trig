sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:comment-action a gen:ViewResultAction;
    rdfs:label "💬 comment on this resource";
    gen:hasActionTemplate <http://purl.org/np/RA3gQDMnYbKCTiQeiUYJYBaH6HUhz8f3HIg71itlsZDgA>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "thing" .
  
  sub:comment-entry-action a gen:ViewEntryAction;
    rdfs:label "💬 comment";
    gen:hasActionTemplate <http://purl.org/np/RA3gQDMnYbKCTiQeiUYJYBaH6HUhz8f3HIg71itlsZDgA>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "np:thing";
    gen:hasActionTemplateTargetField "void" .
  
  sub:test-search-actions-view a gen:NanopubSetView, gen:QueryFormView, gen:ResourceView;
    dct:description "This is a test view for trying out query-form views (gen:QueryFormView) combined with view actions: a top-level comment action and a per-row comment action on the full-text search results, shown as a nanopub set.";
    dct:isVersionOf <https://w3id.org/np/RAcU0NlvqiLk-jSoRj7a1PzDGiyr8G_Vp-7FJCv2N0vLA/test-search-actions-view-kind>;
    dct:title "🧪 Test Search With Actions";
    rdfs:label "Test Search With Actions View (test view for trying out query-form views with actions)";
    gen:appliesToInstancesOf gen:IndividualAgent, gen:MaintainedResource, gen:Space;
    gen:hasStructuralPosition "5.5.testsearchactions";
    gen:hasViewAction sub:comment-action, sub:comment-entry-action;
    gen:hasViewQuery <https://w3id.org/np/RAxdh5xkc6K6SMLY23yKu__zTWJPXeRFc0qgNNxkbOkpY/fulltext-search> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

