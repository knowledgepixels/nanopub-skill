sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:addOpenEndedSpaceAction a gen:ViewResultAction;
    rdfs:label "add open-ended Space";
    gen:hasActionTemplate <https://w3id.org/np/RAgrIys3ge48pXrL_qNE0Rt1DHnIP8Rl2_29BnacMqYYY>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:addTimeLimitedSpaceAction a gen:ViewResultAction;
    rdfs:label "add time-limited Space";
    gen:hasActionTemplate <https://w3id.org/np/RAiuySO2dFpNoNdE0XLPiMlyZSVkIaD-INxaAq7yL4UGY>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:all-spaces-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RANB1bHSVXw8W0aFTvPURWpq960qJm9jEsI1rUDxXwMDY/all-spaces-view-kind>;
    dct:title "All Spaces";
    rdfs:label "All spaces view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels/nanodash>;
    gen:hasDisplayWidth gen:ColumnWidth06of12;
    gen:hasStructuralPosition "5.5.all-spaces";
    gen:hasViewAction sub:addOpenEndedSpaceAction, sub:addTimeLimitedSpaceAction;
    gen:hasViewQuery <https://w3id.org/np/RAvO2pFGy2AONKhIur4XAE_aJcVVeM9pEBoZPfxjl1NUY/get-all-spaces>;
    gen:hasViewQueryTargetField "resource" .
}

