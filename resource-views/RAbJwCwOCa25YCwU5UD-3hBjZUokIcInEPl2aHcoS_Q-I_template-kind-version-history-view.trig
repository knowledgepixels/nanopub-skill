    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:template-kind-version-history-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RARNpYSJnfwqmZOTfxrdHfCQ6NgLqyhqetSrobNJuiK3I/template-kind-version-history-view-kind>;
    dct:title "🕓 Version history";
    rdfs:label "Template kind version history view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:hasStructuralPosition "4.1.versionHistory";
    gen:hasViewAction sub:override-action;
