    dct:title "❔ Unanswered FAQ";
    rdfs:label "Unanswered FAQ view";
    gen:appliesToInstancesOf gen:IndividualAgent, gen:MaintainedResource, gen:Space;
    gen:hasStructuralPosition "4.2.unansweredFaq";
    gen:hasViewAction sub:addAction, sub:answerAction, sub:overrideAction, sub:suggestAnswerAction;
