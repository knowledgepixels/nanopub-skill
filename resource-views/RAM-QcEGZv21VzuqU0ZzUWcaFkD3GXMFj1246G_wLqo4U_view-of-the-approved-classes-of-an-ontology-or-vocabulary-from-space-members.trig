sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:classes-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RA7sMyjwPD5PaoBLd8MSeZiixkOMMvZC9XqKpLkLlooXM/biochementities-from-space-members-view-kind>;
    dct:title "🏷️ Classes";
    rdfs:label "View of the approved classes of an ontology or vocabulary from space members";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    gen:hasStructuralPosition "4.3.classes.3";
    gen:hasViewAction sub:disapproveAction, sub:overrideAction;
    gen:hasViewQuery <https://w3id.org/np/RA4zT51OuX9rmuWDSmgTwa8WAH4aH6S0rq6fF2t_GcVz4/get-approved-classes-of-an-ontology-from-space-members>;
    gen:hasViewQueryTargetField "ontology" .
  
  sub:disapproveAction a gen:ViewEntryAction;
    rdfs:label "disapprove...";
    gen:hasActionTemplate <https://w3id.org/np/RAkhTlKa-i0miq_DN3V4HSv-btlDgwzg8qPUesrsJ0k9Q>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "disapprove_target:nanopub approval_choice:approveOrDisapprove";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:overrideAction a gen:ViewEntryAction;
    rdfs:label "override...";
    gen:hasActionTemplate <https://w3id.org/np/RAD4mKOVqsJc7nAVVR0dXXcVFU2IOjrFywv2GspkpalfQ>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
}

