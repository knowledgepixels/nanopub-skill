    gen:hasActionTemplate <https://w3id.org/np/RAAK7zq9m5XHQaPZSfWxIS8coE-FJn9PWn43Qa8_sv6Tk>;
    gen:hasActionTemplateQueryMapping "override_target:@override override_template:@template";
