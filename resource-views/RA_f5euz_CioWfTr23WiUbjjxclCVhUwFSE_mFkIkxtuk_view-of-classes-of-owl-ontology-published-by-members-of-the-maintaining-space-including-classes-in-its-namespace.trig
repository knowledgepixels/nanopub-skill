    dct:isVersionOf <https://w3id.org/np/RAg3-5LVOXPhSKP7Wzql131pUfab51MkpPqN7fk5BOpag/classes-from-space-members-view-kind>;
    dct:title "🏷 Classes";
    rdfs:label "View of classes of OWL ontology published by members of the maintaining space, including classes in its namespace";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    gen:hasStructuralPosition "4.3.classes.2";
