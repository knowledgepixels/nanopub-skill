sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-view-action a gen:ViewResultAction;
    rdfs:label "➕ add view...";
    gen:hasActionTemplate <https://w3id.org/np/RAr1Krh98VGXbIc7JVSJpH24bWi2JEVRYfvJ_KJq0wJtc>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "governingSpace";
    gen:isVisibleTo gen:MemberRole .
  
  sub:maintained-views-view a gen:ListView, gen:ResourceView;
    dct:isVersionOf sub:maintained-views-view-kind;
    dct:title "🖼️ Maintained views";
    rdfs:label "Maintained views view";
    gen:appliesToInstancesOf gen:Space;
    gen:hasDisplayWidth gen:ColumnWidth06of12;
    gen:hasStructuralPosition "3.4.maintainedViews";
    gen:hasViewAction sub:add-view-action;
    gen:hasViewQuery <https://w3id.org/np/RA7sUq2achAjyyP1TDuUExMAScLUmaZ18SPjtOZ7DeKiM/list-maintained-views>;
    gen:hasViewQueryTargetField "space" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

