sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:edit-verdict-action a gen:ViewEntryAction;
    rdfs:label "✏️ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RAhXvXvhWBCewWPmsl-YXOdsDhVQytS_6ajcqLZLTHscU/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:verdicts-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:verdicts-view-kind;
    dct:title "✅ Indicator verdicts";
    rdfs:label "Dataset indicator verdicts view";
    gen:appliesToInstancesOf dsm:Dataset;
    gen:governedBy <https://w3id.org/spaces/fairplus>;
    gen:hasPageSize "10"^^xsd:integer;
    gen:hasStructuralPosition "4.1.dsmVerdicts";
    gen:hasViewAction sub:edit-verdict-action;
    gen:hasViewQuery <https://w3id.org/np/RAkcQdd5wpN6i0iiSh3KxpjzX5GvUDTUO1XKnHvMZC6bw/get-indicator-verdicts-of-a-dataset>;
    gen:hasViewQueryTargetField "dataset" .
}

