sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-part-view-display-action a gen:ViewResultAction;
    rdfs:label "➕ add part-level view display";
    gen:hasActionTemplate <https://w3id.org/np/RAIrUZ9TQfAYeun74aM_BicxYF4uU6GkL6BthX4WdI9dA>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:MaintainerRole .
  
  sub:add-view-display-action a gen:ViewResultAction;
    rdfs:label "➕ add view display";
    gen:hasActionTemplate <https://w3id.org/np/RAQhTCHtfzGCj1YiE1LualWcZjg3thlRiquFWUE14UF-g>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:MaintainerRole .
  
  sub:deactivate-action a gen:ViewEntryAction;
    rdfs:label "🚫 deactivate";
    gen:hasActionTemplate <https://w3id.org/np/RAZ47_4JquvEXk30HYnVeSgFRcQqHtpdibcfBOeqHI2j4>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "deactivateView:view";
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:MaintainerRole .
  
  sub:override-action a gen:ViewEntryAction;
    rdfs:label "♻️ override...";
    gen:hasActionTemplate <https://w3id.org/np/RAQhTCHtfzGCj1YiE1LualWcZjg3thlRiquFWUE14UF-g>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override override_template:@template";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MaintainerRole .
  
  sub:override-preset-view-action a gen:ViewEntryAction;
    rdfs:label "♻️ override...";
    gen:hasActionTemplate <https://w3id.org/np/RAQhTCHtfzGCj1YiE1LualWcZjg3thlRiquFWUE14UF-g>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_view:view";
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:MaintainerRole .
  
  sub:view-displays-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RA1d1qBF8Fk-ZWKtNB-wZd56HrV0wdtJkw0wp58sHxM0E/user-view-displays-view-kind>;
    dct:title "⬜ View displays";
    rdfs:label "View displays view (User)";
    gen:appliesToInstancesOf gen:IndividualAgent;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    gen:hasStructuralPosition "5.5.viewDisplays";
    gen:hasViewAction sub:add-part-view-display-action, sub:add-view-display-action, sub:deactivate-action,
      sub:override-action, sub:override-preset-view-action;
    gen:hasViewQuery <https://w3id.org/np/RAzaL0ejiyX7WqCbRlazFYUUO8a9wKY-uhNYwHZ5-S7Do/list-view-displays>;
    gen:hasViewQueryTargetField "resource" .
}

