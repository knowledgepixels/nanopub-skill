sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-action a gen:ViewResultAction;
    rdfs:label "🔗 add related paragraph...";
    gen:hasActionTemplate <https://w3id.org/np/RAViRgNY5UUksXi6NFZVOR0Fz78kSGuDoDhXfNIrAeybk/template>;
    gen:hasActionTemplateTargetField "paragraph";
    gen:isVisibleTo gen:MemberRole .
  
  sub:docs-paragraph-related-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAfdFsvfwxMw1VbJR0xoJyTTSNWMAEY2hdgSG2pJaGJiQ/docs-paragraph-related-view-kind>;
    dct:title "🔗 Related";
    rdfs:label "Documentation paragraph related-paragraphs view";
    gen:appliesToInstancesOf gen:Paragraph;
    gen:governedBy <https://w3id.org/spaces/nanopub>;
    gen:hasStructuralPosition "4.6.related";
    gen:hasViewAction sub:add-action, sub:edit-action;
    gen:hasViewQuery <https://w3id.org/np/RANVCTgItt8SIo-zU50f1Cp56UnrM-oLk_irj1ioGxQjI/get-docs-paragraph-related>;
    gen:hasViewQueryTargetField "resource" .
  
  sub:edit-action a gen:ViewEntryAction;
    rdfs:label "✏ edit link...";
    gen:hasActionTemplate <https://w3id.org/np/RAViRgNY5UUksXi6NFZVOR0Fz78kSGuDoDhXfNIrAeybk/template>;
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:isVisibleTo gen:MemberRole .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/np/RAFJKwxgChOLOQ2UduMAT1bYf1VNaWIZYIPmTT3YvJ8y0/docs-bot> .
}

