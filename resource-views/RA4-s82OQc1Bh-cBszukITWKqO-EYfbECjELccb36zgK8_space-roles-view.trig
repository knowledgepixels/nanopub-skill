sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-role-action a gen:ViewResultAction;
    rdfs:label "➕ add role...";
    gen:hasActionTemplate <https://w3id.org/np/RARBzGkEqiQzeiHk0EXFcv9Ol1d-17iOh9MoFJzgfVQDc>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "space";
    gen:isVisibleTo gen:AdminRole .
  
  sub:assign-user-action a gen:ViewEntryAction;
    rdfs:label "👤 add user...";
    gen:hasActionTemplate <https://w3id.org/np/RAR1oWGaiVkWtDL6SdXYnlRBR7t5NoVNa46ShNLJ697g0>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "roleAssignmentTemplate:@template";
    gen:hasActionTemplateTargetField "space";
    gen:isVisibleTo gen:AdminRole .
  
  sub:detach-role-action a gen:ViewEntryAction;
    rdfs:label "🚫 detach role...";
    gen:hasActionTemplate <https://w3id.org/np/RAVnwxKEiHRthdz-ZUNDGoDz9CDiTjnx4gEzs4lCXg6gk>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "detachRole:role";
    gen:hasActionTemplateTargetField "space";
    gen:isVisibleTo gen:AdminRole .
  
  sub:space-roles-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RADFLDTJUN8Qa9028Ltvlx19_J6Pm2_Mfa3g8KhxxbNiI/space-roles-view-kind>;
    dct:title "🎭 Assigned roles";
    rdfs:label "Space roles view";
    gen:appliesToInstancesOf gen:Space;
    gen:hasDisplayWidth gen:ColumnWidth12of12;
    gen:hasStructuralPosition "5.6.spaceRoles";
    gen:hasViewAction sub:add-role-action, sub:assign-user-action, sub:detach-role-action;
    gen:hasViewQuery <https://w3id.org/np/RAVA7rSNA6fgl4fphFqJYc-QPhdqYAGrvkocg9JWf-U3Y/list-space-roles>;
    gen:hasViewQueryTargetField "space" .
}

