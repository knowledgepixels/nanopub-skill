sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:approveAction a gen:ViewEntryAction;
    rdfs:label "✔ approve...";
    gen:hasActionTemplate <https://w3id.org/np/RAkhTlKa-i0miq_DN3V4HSv-btlDgwzg8qPUesrsJ0k9Q/template>;
    gen:hasActionTemplateQueryMapping "np:!nanopub approve_target:!approveOrDisapprove";
    gen:isVisibleTo gen:AdminRole .
  
  sub:rejectAction a gen:ViewEntryAction;
    rdfs:label "✖ reject...";
    gen:hasActionTemplate <https://w3id.org/np/RAkhTlKa-i0miq_DN3V4HSv-btlDgwzg8qPUesrsJ0k9Q/template>;
    gen:hasActionTemplateQueryMapping "np:!nanopub reject_target:!approveOrDisapprove";
    gen:isVisibleTo gen:AdminRole .
  
  sub:viewVersion a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAEo7UtJ-URvVMRpCslgueGsgtCQDOlZeSga2ttcL_HFg/kg-pending-variants-view>;
    dct:title "⏳ Pending variants";
    rdfs:label "⏳ Pending variants";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:hasDisplayWidth gen:ColumnWidth06of12;
    gen:hasStructuralPosition "6.1.pending-variant";
    gen:hasViewAction sub:approveAction, sub:rejectAction;
    gen:hasViewQuery <https://w3id.org/np/RAGYRyfUM73KOjWNEzPFNk_68k2vS2Q1ezQ38dkdWTMUg/get-kg-pending-variants>;
    gen:hasViewQueryTargetField "void" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0009-0005-5515-1230 .
}

sub:pubinfo {
  this: dct:created "2026-11-09T18:16:45Z"^^xsd:dateTime;
    dct:creator orcid:0009-0005-5515-1230;
