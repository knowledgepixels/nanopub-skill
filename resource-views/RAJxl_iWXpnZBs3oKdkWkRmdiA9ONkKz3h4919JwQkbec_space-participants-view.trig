sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:declareParticipationAction a gen:ViewResultAction;
    rdfs:label "➕ declare participation...";
    gen:hasActionTemplate <https://w3id.org/np/RA7vwC0g_WOMKyCy_e0gV97PUgZ9ehZ5kaIZh-dCE9x14>;
    gen:hasActionTemplateTargetField "space" .
  
  sub:declarePlannedAttendanceAction a gen:ViewResultAction;
    rdfs:label "➕ declare planned attendance...";
    gen:hasActionTemplate <https://w3id.org/np/RANuBhW-pXbmSr24Nzl4JTaDjgifqmc_DjOe-GcU-4ElI>;
    gen:hasActionTemplateTargetField "space" .
  
  sub:declareRegretsAction a gen:ViewResultAction;
    rdfs:label "✖ declare regrets...";
    gen:hasActionTemplate <https://w3id.org/np/RAnQmm32XwkSVvPPJGoq2FeQZZ8vV63I0varAsv5IGjSs>;
    gen:hasActionTemplateTargetField "space" .
  
  sub:view a gen:ListView, gen:ResourceView;
    dct:isVersionOf <https://w3id.org/np/RAWu0vPMpvBSCUw26MODQfVQ7dyINZMmZA993ICki9cNs/participants-view-kind>;
    dct:title "👥 Participants";
    rdfs:label "Space participants view";
    gen:appliesToInstancesOf gen:Space;
    gen:hasDisplayWidth gen:ColumnWidth06of12;
    gen:hasStructuralPosition "3.2.spaceParticipants";
    gen:hasViewAction sub:declareParticipationAction, sub:declarePlannedAttendanceAction,
      sub:declareRegretsAction;
    gen:hasViewQuery <https://w3id.org/np/RAS04z39zJ4h3PXGX5E17z3LjiBMLDvnAPyaOHfO0YzQU/list-space-participants>;
    gen:hasViewQueryTargetField "space" .
}

