sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:editAction a gen:ViewEntryAction;
    rdfs:label "✏ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RABkfLmIVTDRosDhcfBPY9SWU_ejWYwzaOANE3SKFrR4g/template>;
    gen:hasActionTemplateQueryMapping "edit_target:@supersede";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:feedback-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAIggL8esJRTKiQi4le3V6PRVakHzHK9FD_uEskUmxbI0/feedback-view-kind>;
    dct:title "📝 Feedback to the organizers";
    rdfs:label "Feedback to organizers view";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:hasPageSize "20";
    gen:hasStructuralPosition "6.5.feedback";
    gen:hasViewAction sub:editAction, sub:giveFeedbackAction, sub:upvoteAction, sub:withdrawAction;
    gen:hasViewQuery <https://w3id.org/np/RAjE6b097a2UblKfN1jQgrDEirHEe1-nN6fajarEdO0VQ/get-feedback>;
    gen:hasViewQueryTargetField "target" .
  
  sub:giveFeedbackAction a gen:ViewResultAction;
    rdfs:label "📝 give feedback...";
    gen:hasActionTemplate <https://w3id.org/np/RABkfLmIVTDRosDhcfBPY9SWU_ejWYwzaOANE3SKFrR4g/template>;
    gen:hasActionTemplateTargetField "target";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:upvoteAction a gen:ViewEntryAction;
    rdfs:label "👍 up-vote";
    gen:hasActionTemplate <https://w3id.org/np/RAmL2GJa0wG68KKzTIL4Nl_-xg5hBY1K8dxSG7-ejV-dM/template>;
    gen:hasActionTemplateQueryMapping "upvote_target:idea";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:withdrawAction a gen:ViewEntryAction;
    rdfs:label "↩ withdraw my up-vote";
    gen:hasActionTemplate <https://w3id.org/np/RA0QOsYNphQCityVcDIJEuldhhuJOX3GlBLw6QylRBhEI>;
    gen:hasActionTemplateQueryMapping "withdraw_target:nanopubToBeRetracted";
    gen:isVisibleTo gen:EveryoneRole .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

