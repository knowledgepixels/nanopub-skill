sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:idea-upvotes-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAFjZXNCr4fRrSaPyi1qzP7UIiUR2NQ7aUM6kboLiEm_E/idea-upvotes-view-kind>;
    dct:title "👍 Up-votes";
    rdfs:label "Idea up-votes view";
    gen:appliesToInstancesOf <https://w3id.org/np/RA7b4hUMrroGWIlG_JJm9XV_XJlHGqRiTFP0amY0BcOd8/Idea>;
    gen:hasDisplayWidth gen:ColumnWidth06of12;
    gen:hasPageSize "10";
    gen:hasStructuralPosition "2.6.upvotes";
    gen:hasViewAction sub:upvoteAction, sub:withdrawAction;
    gen:hasViewQuery <https://w3id.org/np/RAtiuwYYr4ZfpaICYSVcbP5o63cLF52qbdDrNYtxZX3PU/get-idea-upvotes>;
    gen:hasViewQueryTargetField "idea" .
  
  sub:upvoteAction a gen:ViewResultAction;
    rdfs:label "👍 up-vote this idea";
    gen:hasActionTemplate <https://w3id.org/np/RA3jJA4Le6hkqTRcsYG1GuuZJQd1KEDvsDxydBXubzg54/template>;
    gen:hasActionTemplateTargetField "idea";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:withdrawAction a gen:ViewEntryAction;
    rdfs:label "↩ withdraw my up-vote";
    gen:hasActionTemplate <https://w3id.org/np/RA0QOsYNphQCityVcDIJEuldhhuJOX3GlBLw6QylRBhEI>;
    gen:hasActionTemplateQueryMapping "withdraw_target:nanopubToBeRetracted";
    gen:isVisibleTo gen:EveryoneRole .
}

