sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-assessment-action a gen:ViewResultAction;
    rdfs:label "➕ add assessment...";
    gen:hasActionTemplate <https://w3id.org/np/RAtUxp8X8qJE3HybsXvzxirCt9YvpeurOCjKFIN0q4-rc/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "model";
    gen:isVisibleTo gen:MemberRole .
  
  sub:add-verdict-action a gen:ViewEntryAction;
    rdfs:label "➕ add verdict...";
    gen:hasActionTemplate <https://w3id.org/np/RAhXvXvhWBCewWPmsl-YXOdsDhVQytS_6ajcqLZLTHscU/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "assessment_target:assessment";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:assessments-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAWTVabVvzVGPjkQl5IoFVcfDoJvNjpcJ0tl2hxfFbtEs/assessments-view-kind>;
    dct:title "📈 Maturity assessments";
    rdfs:label "Maturity assessments view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/fairplus>;
    gen:hasPageSize "10"^^xsd:integer;
    gen:hasStructuralPosition "4.2.dsmAssessments";
    gen:hasViewAction sub:add-assessment-action, sub:add-verdict-action, sub:edit-assessment-action;
    gen:hasViewQuery <https://w3id.org/np/RADG5bf96K14mvbs0Kv9jEl_q-2DBakSg3aYsGkDH0_1k/get-maturity-assessments-of-an-ontology>;
    gen:hasViewQueryTargetField "ontology" .
  
  sub:edit-assessment-action a gen:ViewEntryAction;
    rdfs:label "✏️ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RAtUxp8X8qJE3HybsXvzxirCt9YvpeurOCjKFIN0q4-rc/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
}

