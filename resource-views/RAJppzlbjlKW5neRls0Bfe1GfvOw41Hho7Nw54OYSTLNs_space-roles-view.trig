    dct:title "🎭 Assigned roles";
    rdfs:label "Space roles view";
    <https://w3id.org/kpxl/gen/terms/appliesToInstancesOf> <https://w3id.org/kpxl/gen/terms/Space>;
    <https://w3id.org/kpxl/gen/terms/hasDisplayWidth> <https://w3id.org/kpxl/gen/terms/ColumnWidth06of12>;
    <https://w3id.org/kpxl/gen/terms/hasStructuralPosition> "5.5.spaceRoles";
