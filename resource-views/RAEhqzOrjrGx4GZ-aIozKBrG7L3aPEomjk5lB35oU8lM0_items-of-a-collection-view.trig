sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:01addAction a <https://w3id.org/kpxl/gen/terms/ViewResultAction>;
    rdfs:label "add...";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplate> <https://w3id.org/np/RAP7H9az1ayL4948E3WbfsaZgj_xuxy6WwQ48Yk5JRLc8>;
    <https://w3id.org/kpxl/gen/terms/hasActionTemplatePartField> "thing";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplateQueryMapping> "void";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplateTargetField> "collection" .
  
  sub:02makeIndexAction a <https://w3id.org/kpxl/gen/terms/ViewResultAction>;
    rdfs:label "make index...";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplate> <https://w3id.org/np/RAxnhKtopKXeNotK-uejPSrZ4EC7sSRw0n3JCAsbzJ-3M>;
    <https://w3id.org/kpxl/gen/terms/hasActionTemplatePartField> "void";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplateQueryMapping> "np:element";
    <https://w3id.org/kpxl/gen/terms/hasActionTemplateTargetField> "resource" .
  
  sub:collection-items-view a <https://w3id.org/kpxl/gen/terms/ResourceView>, <https://w3id.org/kpxl/gen/terms/TabularView>;
    dct:isVersionOf <https://w3id.org/np/RAW-_ut4pYlazIz2bY2FgZ-ILKp8rSceh9d2WwQ0YnMs8/collection-items-view-kind>;
    dct:title "Items";
    rdfs:label "Items of a collection view";
    <https://w3id.org/kpxl/gen/terms/appliesToInstancesOf> <http://purl.org/dc/dcmitype/Collection>;
    <https://w3id.org/kpxl/gen/terms/hasStructuralPosition> "4.4.collectionItems.1";
    <https://w3id.org/kpxl/gen/terms/hasViewAction> sub:01addAction, sub:02makeIndexAction;
    <https://w3id.org/kpxl/gen/terms/hasViewQuery> <https://w3id.org/np/RA9ZR8Lu0hlbk8J8uyoiNFqszFQeCy4bL4-0_WzLvZ4DQ/get-items-of-collection>;
    <https://w3id.org/kpxl/gen/terms/hasViewQueryTargetField> "collection" .
}

