sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:query-header-view a gen:HeaderView, gen:ResourceView;
    dct:description "Search the nanopublication network and browse the published queries.";
    dct:isVersionOf sub:query-header-view-kind;
    dct:title "🔍 Query";
    rdfs:label "Query section header view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:hasStructuralPosition "7.1.query" .
}

