    <https://w3id.org/kpxl/gen/terms/hasDisplayWidth> <https://w3id.org/kpxl/gen/terms/ColumnWidth06of12>;
    <https://w3id.org/kpxl/gen/terms/hasStructuralPosition> "3.4.maintainedResources";
    <https://w3id.org/kpxl/gen/terms/hasViewAction> sub:add-maintained-resource;
    <https://w3id.org/kpxl/gen/terms/hasViewQuery> <https://w3id.org/np/RAKTTYw5VcuK0aIRlTvSEVYFPA7mH3Yq_nKnC1qcpzHiI/list-maintained-resources>;
    <https://w3id.org/kpxl/gen/terms/hasViewQueryTargetField> "space" .
}

