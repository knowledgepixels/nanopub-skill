    gen:hasActionTemplate <https://w3id.org/np/RAUneCxaT_JQhs4XK8yFhSm5JGmAMgn8k6zBkWB2pp3BI>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "entity" .
  
  sub:suggestions-view a gen:PlainParagraphView, gen:ResourceView;
    dct:isVersionOf sub:suggestions-view-kind;
    dct:title "💡 Suggested answers";
    rdfs:label "Non-member FAQ suggestions view";
    gen:appliesToInstancesOf gen:IndividualAgent, gen:MaintainedResource, gen:Space;
    gen:hasStructuralPosition "4.3.suggestions";
    gen:hasViewAction sub:acceptAction, sub:addAction;
    gen:hasViewQuery <https://w3id.org/np/RAaae9rYCWn6VPq5qG5cIyiw_hiAKAQ435rA7JuAnnnV8>;
    gen:hasViewQueryTargetField "resource" .
}

