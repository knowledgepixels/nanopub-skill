    dct:title "📎 Supplement links";
    rdfs:label "OpenAIRE supplement links view";
    gen:appliesToInstancesOf gen:Space;
    gen:hasDisplayWidth gen:ColumnWidth12of12;
    gen:hasStructuralPosition "5.1.openaire-linking.1.supplementLinks";
    gen:hasViewAction sub:addAction, sub:approveAction;
    gen:hasViewQuery <https://w3id.org/np/RArjkaTzIbwL4IdHSDJwkiVET3HXDDdfFjZM9_9vuj7J0/get-openaire-supplement-links>;
