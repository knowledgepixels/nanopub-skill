sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:01addClaimAction a gen:ViewResultAction;
    rdfs:label "➕ add claim...";
    gen:hasActionTemplate <https://w3id.org/np/RAzvNtXMF1BMBsNyhsUaXMA0GSPcHgnQRy57uCGyN9QWQ/template>;
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:02editClaimAction a gen:ViewEntryAction;
    rdfs:label "✏ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RAzvNtXMF1BMBsNyhsUaXMA0GSPcHgnQRy57uCGyN9QWQ/template>;
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "resource";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:claims-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAZRB_C_3jXOSoidZ-XsE8frYvqPJlBHziV07-jbqBjAk/claims-view-kind>;
    dct:title "🔬 Claims";
    rdfs:label "Delphi claims view";
    gen:appliesToInstancesOf gen:Space;
    gen:hasStructuralPosition "4.5.claims";
    gen:hasViewAction sub:01addClaimAction, sub:02editClaimAction;
    gen:hasViewQuery <https://w3id.org/np/RAX24Skv0v3dlVLjt7Yzh9umcOJK9m3TQuTTnZkXenV7k/list-delphi-claims>;
    gen:hasViewQueryTargetField "void" .
}

