sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:addExampleAction a gen:ViewEntryAction;
    rdfs:label "add example...";
    gen:hasActionTemplate <https://w3id.org/np/RA6VOR7RkSpQK_rwz5u-XGTHOIQjRAM8Z4dSkMe2vGpTA/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "usecase_ref:useCaseClass";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:addUseCaseAction a gen:ViewResultAction;
    rdfs:label "add use case...";
    gen:hasActionTemplate <https://w3id.org/np/RAzkwQbhBx6lnFhzwCkkORxhlwzkQaF0KUX5V42q0Iblo/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "entity";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:overrideAction a gen:ViewEntryAction;
    rdfs:label "♻️ override...";
    gen:hasActionTemplate <https://w3id.org/np/RAzkwQbhBx6lnFhzwCkkORxhlwzkQaF0KUX5V42q0Iblo/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:use-cases-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAXlyL5SpPLHHk-wNhg2QMru1mBSKDanw8UZD9zCSWDYs/use-cases-view-kind>;
    dct:title "💡 Use cases";
    rdfs:label "Use cases with examples view";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:hasPageSize "20";
    gen:hasStructuralPosition "4.3.useCases";
    gen:hasViewAction sub:addExampleAction, sub:addUseCaseAction, sub:overrideAction;
    gen:hasViewQuery <https://w3id.org/np/RA6dQOftH1SslzJpOFMz9Ow4OP3w5pmRXcBiLyG0Tx87E/get-use-cases-with-examples>;
    gen:hasViewQueryTargetField "entity" .
}

