sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:addAction a gen:ViewResultAction;
    rdfs:label "➕ add award...";
    gen:hasActionTemplate <https://w3id.org/np/RAXndgKwpdKM-WLCg4JWt3FdFJ7kOMWLP1Xj71McOB80E/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "recipient" .
  
  sub:awards-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:awards-view-kind;
    dct:title "🏆 Awards";
    rdfs:label "Awards for recipient view";
    gen:appliesToInstancesOf gen:IndividualAgent;
    gen:hasStructuralPosition "4.5.awards";
    gen:hasViewAction sub:addAction;
    gen:hasViewQuery <https://w3id.org/np/RAbU26aRWmw-t1io65dHgaxTiru7aBq8eZXEyzd93bmhw/get-awards-for-recipient>;
    gen:hasViewQueryTargetField "recipient" .
}

