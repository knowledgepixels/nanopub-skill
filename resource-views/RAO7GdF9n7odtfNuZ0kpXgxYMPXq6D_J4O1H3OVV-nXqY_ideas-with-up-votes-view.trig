@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:editAction a gen:ViewEntryAction;
    rdfs:label "✏ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RAa6-hk0TNAqP71Zzjq6VthHHt77GcPXgVbIADgGmtvpY/template>;
    gen:hasActionTemplateQueryMapping "edit_target:@supersede";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:ideas-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAUs1Ljc_ojGJo0HCNB5GTmxpjjUs3uyO15iSo9AQVbQ0/ideas-view-kind>;
    dct:title "💡 Ideas";
    rdfs:label "Ideas with up-votes view";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:hasPageSize "10";
    gen:hasStructuralPosition "5.5.ideas";
    gen:hasViewAction sub:editAction, sub:suggestAction, sub:upvoteAction, sub:withdrawAction;
    gen:hasViewQuery <https://w3id.org/np/RAVZtl3tI3PL4xLkZDQVmApncVukfeSM5RtiLFYGZSzfE/get-ideas>;
    gen:hasViewQueryTargetField "target" .
  
  sub:suggestAction a gen:ViewResultAction;
    rdfs:label "💡 suggest an idea...";
    gen:hasActionTemplate <https://w3id.org/np/RAa6-hk0TNAqP71Zzjq6VthHHt77GcPXgVbIADgGmtvpY/template>;
    gen:hasActionTemplateTargetField "target";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:upvoteAction a gen:ViewEntryAction;
    rdfs:label "👍 up-vote";
    gen:hasActionTemplate <https://w3id.org/np/RA3jJA4Le6hkqTRcsYG1GuuZJQd1KEDvsDxydBXubzg54/template>;
    gen:hasActionTemplateQueryMapping "upvote_target:idea";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:withdrawAction a gen:ViewEntryAction;
    rdfs:label "↩ withdraw my up-vote";
    gen:hasActionTemplate <https://w3id.org/np/RA0QOsYNphQCityVcDIJEuldhhuJOX3GlBLw6QylRBhEI>;
    gen:hasActionTemplateQueryMapping "withdraw_target:nanopubToBeRetracted";
    gen:isVisibleTo gen:EveryoneRole .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

