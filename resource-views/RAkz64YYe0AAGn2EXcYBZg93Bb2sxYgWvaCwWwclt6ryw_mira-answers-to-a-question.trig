sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:action a gen:ViewResultAction;
    rdfs:label "➕ add an answer...";
    gen:hasActionTemplate <https://w3id.org/np/RAuU6SRacU0AtS8_IBrb-eWHTqhmC6tMMcdVDLgOxm-sc/template>;
    gen:hasActionTemplateTargetField "question";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:mira-answers-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:viewKind;
    dct:title "💬 Answers";
    rdfs:label "MIRA answers to a question";
    gen:appliesToInstancesOf mira:Question;
    gen:governedBy <https://w3id.org/spaces/mira>;
    gen:hasStructuralPosition "4.1.miraAnswers";
    gen:hasViewAction sub:action;
    gen:hasViewQuery <https://w3id.org/np/RA_q2AnPIKA9_vLh2Zap_kCEuQC6eifj3OjOiMIb_nxu8/get-mira-answers>;
    gen:hasViewQueryTargetField "partid" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

