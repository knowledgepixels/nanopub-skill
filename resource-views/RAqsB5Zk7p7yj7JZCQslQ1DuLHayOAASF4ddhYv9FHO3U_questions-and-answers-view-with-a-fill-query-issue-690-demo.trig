sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:askAction a gen:ViewResultAction;
    rdfs:label "❓ ask a question...";
    gen:hasActionFillQuery <https://w3id.org/np/RA1MUappxs760hMyhQCjk_TEj-GxRx8ptCoBrdsjBP9m4/get-question-defaults>;
    gen:hasActionFillQueryMapping "questionText:questionText evidence:!evidence";
