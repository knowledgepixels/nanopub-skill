    gen:hasActionTemplate <https://w3id.org/np/RAfqnkEbBGD9vnRWDOPVb4Z3MtDG2oMvjv_hGjcSnu80M>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "target_np:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
}

