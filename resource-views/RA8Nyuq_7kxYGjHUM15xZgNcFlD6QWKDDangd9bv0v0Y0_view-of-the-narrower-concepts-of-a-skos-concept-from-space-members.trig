sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:addAction a gen:ViewResultAction;
    rdfs:label "add narrower concept...";
    gen:hasActionTemplate <https://w3id.org/np/RAQyD3q-LJzhz_2ygvaisbLQIzYknw3V0wpldr_zWjJrA>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "broaderConcept";
    gen:isVisibleTo gen:MemberRole .
  
  sub:narrower-concepts-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:skos-narrower-concepts-view-kind;
    dct:title "🌳 Narrower concepts";
    rdfs:label "View of the narrower concepts of a SKOS concept from space members";
    gen:appliesToInstancesOf skos:Concept;
    gen:hasStructuralPosition "4.4.narrower.1";
    gen:hasViewAction sub:addAction, sub:overrideAction;
    gen:hasViewQuery <https://w3id.org/np/RAsjZhi-UjWr5dkB2t7B3sJPCx_225ykI4Negvi-tM-z4/get-narrower-concepts-from-space-members>;
    gen:hasViewQueryTargetField "concept" .
  
  sub:overrideAction a gen:ViewEntryAction;
    rdfs:label "override...";
    gen:hasActionTemplate <https://w3id.org/np/RAQyD3q-LJzhz_2ygvaisbLQIzYknw3V0wpldr_zWjJrA>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

