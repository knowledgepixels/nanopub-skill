sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:01-start-action a gen:ViewResultAction;
    rdfs:label "➕ start a discussion...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion> .
  
  sub:02-ask-action a gen:ViewResultAction;
    rdfs:label "❓ ask a question...";
    gen:hasActionTemplate <https://w3id.org/np/RAzhuZcCsv1zcv154bP__56eKxFhhJBz0N2_TW5-kOzIw/templateVersion> .
  
  sub:11-reply-action a gen:ViewEntryAction;
    rdfs:label "💬 reply...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion>;
    gen:hasActionTemplateQueryMapping "reply_target:target" .
  
  sub:viewVersion a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAyz3gJhFmj7fCW-sau9VXHP-EXA8_gvRrs3VpphB2jCY/all-discussions-view>;
    dct:title "🧵 All discussions";
    rdfs:label "All discussion threads";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels/nanoarguments>;
    gen:hasPageSize "10";
    gen:hasStructuralPosition "4.2.allDiscussions";
    gen:hasViewAction sub:01-start-action, sub:02-ask-action, sub:11-reply-action;
    gen:hasViewQuery <https://w3id.org/np/RAOAle0dm3EwBz47bZ_rbuNVsFkSbQ6K2fLqilD38js-E/get-thread-heads>;
    gen:hasViewQueryTargetField "void" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

