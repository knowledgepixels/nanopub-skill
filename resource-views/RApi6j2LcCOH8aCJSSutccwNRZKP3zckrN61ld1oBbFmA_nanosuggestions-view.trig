sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:assignAction a gen:ViewEntryAction;
    rdfs:label "assign...";
    gen:hasActionTemplate <https://w3id.org/np/RAFv-eKTeLzE7W2_7NtOBoYzmBe-iDGjAkqOKH0mgNpV4/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "assign_target:suggestion";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:commentAction a gen:ViewEntryAction;
    rdfs:label "comment...";
    gen:hasActionTemplate <https://w3id.org/np/RAUEWFWLBntdwIbOq9kvsGY8r183GoE5u5aUB8WAWOQNw/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "suggestion:target";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:linkAction a gen:ViewEntryAction;
    rdfs:label "also relevant for...";
    gen:hasActionTemplate <https://w3id.org/np/RA5FyFSM5rwFo74qItgS_b1rwRGcY-NacX8DDXS6U8DaM/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "suggestion:suggestion";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:nanosuggestions-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RANjO9VOwUWuULsfw8-VOEukeyDDBAmmUI3FAD-JGSt0U/nanosuggestions-view-kind>;
    dct:title "🐞 Nanosuggestions";
    rdfs:label "Nanosuggestions view";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:governedBy <https://w3id.org/spaces/nanosuggestions>;
    gen:hasStructuralPosition "4.1.nanosuggestions";
    gen:hasViewAction sub:assignAction, sub:commentAction, sub:linkAction, sub:reassignAction,
      sub:reportAction, sub:statusAction;
    gen:hasViewQuery <https://w3id.org/np/RAqyiexfFWu4ckCM_H4Xx7k7_mDlLUxR7hHx1f1VRcHpc/get-nanosuggestions>;
    gen:hasViewQueryTargetField "resource" .
  
  sub:reassignAction a gen:ViewEntryAction;
    rdfs:label "reassign...";
    gen:hasActionTemplate <https://w3id.org/np/RAFv-eKTeLzE7W2_7NtOBoYzmBe-iDGjAkqOKH0mgNpV4/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "fill_source:@use-a";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:reportAction a gen:ViewResultAction;
    rdfs:label "report...";
    gen:hasActionTemplate <https://w3id.org/np/RAVAdO8EkzVyV2ZGmrYvgfBSoi357QFqbJpvwI0sLk4V8/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "space";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:statusAction a gen:ViewEntryAction;
    rdfs:label "change status...";
    gen:hasActionTemplate <https://w3id.org/np/RAcigohADerlCWLymsIKgDx2yui7IR-F_oHNBzPs-57dI/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "suggestion:suggestion";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
}

