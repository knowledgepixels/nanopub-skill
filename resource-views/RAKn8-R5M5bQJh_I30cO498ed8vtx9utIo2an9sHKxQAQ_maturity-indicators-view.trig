sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-indicator-action a gen:ViewResultAction;
    rdfs:label "➕ add indicator...";
    gen:hasActionTemplate <https://w3id.org/np/RAFmwFfcOIUFvDZokL_yLnBooAx_b4BTOVe4Xs-e_5_ZQ/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "ontology";
    gen:isVisibleTo gen:MemberRole .
  
  sub:edit-indicator-action a gen:ViewEntryAction;
    rdfs:label "✏️ edit...";
    gen:hasActionTemplate <https://w3id.org/np/RAFmwFfcOIUFvDZokL_yLnBooAx_b4BTOVe4Xs-e_5_ZQ/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:MemberRole .
  
  sub:indicators-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAfGP4Y5IQr0hZuYA30slJDT4EovEI3fg8h5v9YHCMMfA/indicators-view-kind>;
    dct:title "📊 Maturity indicators";
    rdfs:label "Maturity indicators view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/fairplus>;
    gen:hasPageSize "10"^^xsd:integer;
    gen:hasStructuralPosition "4.1.dsmIndicators";
    gen:hasViewAction sub:add-indicator-action, sub:edit-indicator-action;
    gen:hasViewQuery <https://w3id.org/np/RAYKvw6btLm0dmaUJazsTCis3Q5aQUxKty_lHmAf0Nel4/get-maturity-indicators-of-an-ontology>;
    gen:hasViewQueryTargetField "ontology" .
}

