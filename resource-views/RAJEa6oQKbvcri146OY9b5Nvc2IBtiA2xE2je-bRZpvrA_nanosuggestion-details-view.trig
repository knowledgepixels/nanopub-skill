sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:assignAction a gen:ViewResultAction;
    rdfs:label "assign...";
    gen:hasActionTemplate <https://w3id.org/np/RAFv-eKTeLzE7W2_7NtOBoYzmBe-iDGjAkqOKH0mgNpV4/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "suggestion";
    gen:isVisibleTo gen:MemberRole .
  
  sub:linkAction a gen:ViewResultAction;
    rdfs:label "also relevant for...";
    gen:hasActionTemplate <https://w3id.org/np/RA5FyFSM5rwFo74qItgS_b1rwRGcY-NacX8DDXS6U8DaM/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "suggestion";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:nanosuggestion-details-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RA6yL3-UF3ypXPMTO-sFgdxO9ofgmuceKlQ8HGvOwKhAI/nanosuggestion-details-view-kind>;
    dct:title "ℹ️ Nanosuggestion details";
    rdfs:label "Nanosuggestion details view";
    gen:appliesToInstancesOf nsug:Nanosuggestion;
    gen:governedBy <https://w3id.org/spaces/nanosuggestions>;
    gen:hasStructuralPosition "2.5.details";
    gen:hasViewAction sub:assignAction, sub:linkAction, sub:statusAction;
    gen:hasViewQuery <https://w3id.org/np/RASFCFo7ectN1JiYuf2WnVCZ_FhHl7luaWIInjWyoAbhg/get-nanosuggestion-details>;
    gen:hasViewQueryTargetField "suggestion" .
  
  sub:statusAction a gen:ViewResultAction;
    rdfs:label "change status...";
    gen:hasActionTemplate <https://w3id.org/np/RAcigohADerlCWLymsIKgDx2yui7IR-F_oHNBzPs-57dI/template>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "suggestion";
    gen:isVisibleTo gen:MemberRole .
}

