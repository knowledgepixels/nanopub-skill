    gen:hasStructuralPosition "4.2.skosConcepts.1";
    gen:hasViewAction sub:addAction, sub:makeIndexAction;
    gen:hasViewQuery <https://w3id.org/np/RAul10Jretr7ykLaQ9dS_kdYRr9v4Cp2homA9W3Demzxg/get-concepts-of-skos-scheme>;
