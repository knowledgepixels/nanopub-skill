sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:01-start-action a gen:ViewResultAction;
    rdfs:label "➕ start a discussion...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion>;
    gen:hasActionTemplateTargetField "about" .
  
  sub:02-ask-action a gen:ViewResultAction;
    rdfs:label "❓ ask a question...";
    gen:hasActionTemplate <https://w3id.org/np/RAzhuZcCsv1zcv154bP__56eKxFhhJBz0N2_TW5-kOzIw/templateVersion>;
    gen:hasActionTemplateTargetField "about" .
  
  sub:11-reply-action a gen:ViewEntryAction;
    rdfs:label "💬 reply...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion>;
    gen:hasActionTemplateTargetField "target" .
  
  sub:12-support-action a gen:ViewEntryAction;
    rdfs:label "👍 support...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion>;
    gen:hasActionTemplateQueryMapping "support_stance:!stance";
    gen:hasActionTemplateTargetField "target" .
  
  sub:13-dispute-action a gen:ViewEntryAction;
    rdfs:label "👎 dispute...";
    gen:hasActionTemplate <https://w3id.org/np/RAviXo8yYqCIoOn6gcgHXyJKDjmWoO9CndMTpcSn5xX0c/templateVersion>;
    gen:hasActionTemplateQueryMapping "dispute_stance:!stance";
    gen:hasActionTemplateTargetField "target" .
  
  sub:14-question-action a gen:ViewEntryAction;
    rdfs:label "❓ question...";
    gen:hasActionTemplate <https://w3id.org/np/RAzhuZcCsv1zcv154bP__56eKxFhhJBz0N2_TW5-kOzIw/templateVersion>;
    gen:hasActionTemplateTargetField "target" .
  
  sub:viewVersion a gen:ResourceView, gen:ThreadView;
    dct:isVersionOf sub:discussions-view;
    dct:title "🧵 Discussions";
    rdfs:label "Discussion threads about a resource";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels/nanoarguments>;
    gen:hasPageSize "10";
    gen:hasStructuralPosition "4.2.discussions";
    gen:hasViewAction sub:01-start-action, sub:02-ask-action, sub:11-reply-action, sub:12-support-action,
      sub:13-dispute-action, sub:14-question-action;
    gen:hasViewQuery <https://w3id.org/np/RAD6fvmF1vzjlokbRMCmLzzipy4Gs30wfEWONtx2ElqEc/get-threads-about-resource>;
    gen:hasViewQueryTargetField "resource" .
}

