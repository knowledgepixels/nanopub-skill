sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:addArticleMetadataAction a gen:ViewResultAction;
    rdfs:label "add article metadata...";
    gen:hasActionTemplate <https://w3id.org/np/RAYRjIrbLSDIX5Mp1cb6MK4vRV0Vd5o0TZ8NTIEHwCPOI>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "void" .
  
  sub:addCitationAction a gen:ViewResultAction;
    rdfs:label "add citation...";
    gen:hasActionTemplate <https://w3id.org/np/RAX_4tWTyjFpO6nz63s14ucuejd64t2mK3IBlkwZ7jjLo>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "article" .
  
  sub:cited-papers-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAxvpXVd0mj-pe7kZxGr1qRA4tcoMzuNtPpw_fiYFFtsc/cited-papers-view-kind>;
    dct:title "📚 Cited papers";
    rdfs:label "Cited papers view";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:hasStructuralPosition "5.3.cited-papers";
    gen:hasViewAction sub:addArticleMetadataAction, sub:addCitationAction;
    gen:hasViewQuery <https://w3id.org/np/RAOCiFNyjzD-kRYGK49dpFiEwg9i4HqQwN9JrNu_KiOpg/get-cited-papers-for-resource>;
    gen:hasViewQueryTargetField "resource" .
}

