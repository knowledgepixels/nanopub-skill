  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:askAction a gen:ViewResultAction;
    rdfs:label "❓ ask a question...";
    gen:hasActionTemplate <https://w3id.org/np/RAsqh6SzmNU8NJnxOZ-viynv0tCWi8n2GFMlZ59dWZpVY>;
    gen:hasActionTemplateTargetField "target";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:qa-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RArDU9PvHzIV0jrgxgdH1CAiML5xp34qCJgJQQO1ktLKE/qa-view-kind>;
    dct:title "💬 Questions & answers";
    rdfs:label "Questions and answers view";
    gen:appliesToInstancesOf gen:MaintainedResource, gen:Space;
    gen:hasPageSize "10";
    gen:hasStructuralPosition "4.2.questions";
    gen:hasViewAction sub:askAction, sub:replyAction;
    gen:hasViewQuery <https://w3id.org/np/RAAWlWQVkHhj2XoqrMFcalU-Q_LQ9mzbwnrDMytZ3uXng>;
    gen:hasViewQueryTargetField "resource" .
  
  sub:replyAction a gen:ViewEntryAction;
    rdfs:label "💬 reply...";
    gen:hasActionTemplate <https://w3id.org/np/RAFpID-NunXGUAZebXPfhD9efjvfpZqB5gDBrgP2Lp5N8>;
    gen:hasActionTemplateQueryMapping "reply_target:target";
    gen:isVisibleTo gen:EveryoneRole .
}

