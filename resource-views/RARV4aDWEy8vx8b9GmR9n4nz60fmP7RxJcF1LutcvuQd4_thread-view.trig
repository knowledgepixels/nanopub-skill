    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:answerAction a gen:ViewEntryAction;
    rdfs:label "💬 reply...";
    gen:hasActionTemplate <https://w3id.org/np/RAFpID-NunXGUAZebXPfhD9efjvfpZqB5gDBrgP2Lp5N8>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "reply_target:target";
    gen:hasActionTemplateTargetField "void";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:postAction a gen:ViewResultAction;
    rdfs:label "➕ add reply...";
    gen:hasActionTemplate <https://w3id.org/np/RAFpID-NunXGUAZebXPfhD9efjvfpZqB5gDBrgP2Lp5N8>;
    gen:hasActionTemplatePartField "void";
    gen:hasActionTemplateQueryMapping "void";
    gen:hasActionTemplateTargetField "target";
    gen:isVisibleTo gen:EveryoneRole .
  
  sub:thread-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf sub:thread-view-kind;
    dct:title "🧵 Thread";
    rdfs:label "Thread view";
    gen:appliesToInstancesOf <https://schema.org/Question>, <https://schema.org/Statement>;
    gen:hasPageSize "20"^^xsd:integer;
    gen:hasStructuralPosition "4.2.thread";
    gen:hasViewAction sub:answerAction, sub:postAction;
    gen:hasViewQuery <https://w3id.org/np/RAhdldevdeHe4nb9fM3CKA_cUnufQPq_xj4fuRyjTkq1o/get-thread>;
    gen:hasViewQueryTargetField "resource" .
}

