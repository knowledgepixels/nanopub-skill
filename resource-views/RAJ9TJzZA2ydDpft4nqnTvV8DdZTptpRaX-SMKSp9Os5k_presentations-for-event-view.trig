  sub:presentations-for-event-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RAG_7-9Cdhh_0jYHe2Kp0forPS1VTb40Gxi1Rk0Go0Ndo/presentations-for-event-view-kind>;
    dct:title "🎤 Presentations";
    rdfs:label "Presentations for event view";
    gen:appliesToInstancesOf gen:Space;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    gen:hasStructuralPosition "4.4.presentations";
    gen:hasViewAction sub:addAction, sub:overrideAction;
    gen:hasViewQuery <https://w3id.org/np/RAdMMvPExUxGDTDSpf4w1isoCbA6uW5rlDhrgA_UTrzoc/get-presentations-for-event>;
