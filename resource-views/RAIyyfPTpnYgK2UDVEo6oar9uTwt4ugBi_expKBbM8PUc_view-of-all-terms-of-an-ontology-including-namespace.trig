sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:ontology-terms-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RASTzkJBhTnQ1YyD9il6Q3JywJ-RQ1IBKRB2PQOshbOPY/ontology-terms-view-kind>;
    dct:title "📖 Terms";
    rdfs:label "View of all terms of an ontology including namespace";
    gen:appliesToInstancesOf gen:MaintainedResource;
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    gen:hasStructuralPosition "4.5.terms.1";
    gen:hasViewAction sub:overrideAction;
    gen:hasViewQuery <https://w3id.org/np/RA5pNPWKHJ2_sGQmkMJB90SF-2UV6aCSIdOiWc415EjMU/get-terms-of-ontology-ns>;
    gen:hasViewQueryTargetField "ontology" .
  
  sub:overrideAction a gen:ViewEntryAction;
    rdfs:label "override...";
    gen:hasActionTemplate <http://purl.org/np/RAFu2BNmgHrjOTJ8SKRnKaRp-VP8AOOb7xX88ob0DZRsU>;
    gen:hasActionTemplateQueryMapping "override_target:@override override_template:@template";
    gen:isVisibleTo gen:MemberRole .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

