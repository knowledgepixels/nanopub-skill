sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:add-action a gen:ViewResultAction;
    rdfs:label "➕ add example...";
    gen:hasActionTemplate <https://w3id.org/np/RAQaFrvT2qZrDZ1A366gqINdlsVDU9Kziq8CfdFAATSHQ/template>;
    gen:hasActionTemplateTargetField "paragraph";
    gen:isVisibleTo gen:MemberRole .
  
  sub:docs-paragraph-examples-view a gen:ResourceView, gen:TabularView;
    dct:isVersionOf <https://w3id.org/np/RA-s4kT4Y1IAyzmSHMpa6TFg5ZbGELBMgoMAUijCb-HtE/docs-paragraph-examples-view-kind>;
    dct:title "🧪 Examples";
    rdfs:label "Documentation paragraph examples view";
    gen:appliesToInstancesOf gen:Paragraph;
    gen:governedBy <https://w3id.org/spaces/nanopub>;
    gen:hasStructuralPosition "4.2.examples";
    gen:hasViewAction sub:add-action, sub:edit-action;
    gen:hasViewQuery <https://w3id.org/np/RAULATZx0ceczSDhkuoT_wg1lM93KPDPAMmjWadJWp8n0/get-docs-paragraph-examples>;
    gen:hasViewQueryTargetField "resource" .
  
  sub:edit-action a gen:ViewEntryAction;
    rdfs:label "✏ edit link...";
    gen:hasActionTemplate <https://w3id.org/np/RAQaFrvT2qZrDZ1A366gqINdlsVDU9Kziq8CfdFAATSHQ/template>;
    gen:hasActionTemplateQueryMapping "override_target:@override";
    gen:isVisibleTo gen:MemberRole .
}

