    npx:hasSignature "GVOqDspuJzzenLzNnOvTy6eJ1TraZPNVo0Yg7OY3zXS5zKbG+k4I2gEQEFZlekZM4CUsLhT8wIT6uYW64jyXQEzJ6JiWyBJ3+ZiUGF9D9tEIXeCmNjxFurq8LIp9fR2OxveIJoO5I1Hg0o8uXnH0Mp/CraDsL+tyjjZzfGSJ5gA=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}
