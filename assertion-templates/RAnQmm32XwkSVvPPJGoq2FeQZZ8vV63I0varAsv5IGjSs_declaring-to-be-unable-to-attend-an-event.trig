@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  gen:unableToAttend a gen:RegularRoleProperty;
    rdfs:label "is unable to attend" .
  
  sub:agent a nt:AgentPlaceholder, nt:ExternalUriPlaceholder;
    rdfs:label "choose the agent who is unable to attend";
    nt:hasDefaultValue nt:CREATOR .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares that the given agent is unable to attend an event, which meeting minutes commonly call \"regrets\". This is the counterpart of \"Declaring to plan to attend an event\" and uses its own predicate, gen:unableToAttend, so that regrets are never mixed up with actual participation. For the declaration to show up on the event page, the event needs to have the \"Regrets\" role attached, which the general regular meeting preset provides.";
    rdfs:label "Declaring to be unable to attend an event";
    nt:hasNanopubLabelPattern "${agent} is unable to attend ${space}";
    nt:hasStatement sub:st1;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:RoleInstantiation .
  
  sub:space a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "choose the event";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:st1 rdf:object sub:space;
    rdf:predicate gen:unableToAttend;
    rdf:subject sub:agent .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

