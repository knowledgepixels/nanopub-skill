@prefix this: <https://w3id.org/np/RA7WpC4Dgd0pdN7JOo0KAbTV9b6vdjMl6KrhN4GOTjSE8> .
@prefix sub: <https://w3id.org/np/RA7WpC4Dgd0pdN7JOo0KAbTV9b6vdjMl6KrhN4GOTjSE8/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  obo:ECO_0000000 rdfs:label "evidence - an empirical result that bears on a claim" .
  
  obo:ECO_0000006 rdfs:label "experimental evidence" .
  
  obo:ECO_0000041 rdfs:label "similarity evidence" .
  
  obo:ECO_0000212 rdfs:label "combinatorial evidence" .
  
  obo:ECO_0000352 rdfs:label "evidence used in manual assertion" .
  
  obo:ECO_0000361 rdfs:label "inferential evidence" .
  
  obo:ECO_0000501 rdfs:label "evidence used in automatic assertion" .
  
  obo:ECO_0006055 rdfs:label "high throughput evidence" .
  
  obo:ECO_0006151 rdfs:label "documented statement evidence" .
  
  obo:ECO_0007672 rdfs:label "computational evidence" .
  
  dct:description rdfs:label "has the description" .
  
  cito:isDocumentedBy rdfs:label "is documented by" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the label" .
  
  prov:wasGeneratedBy rdfs:label "was generated by" .
  
  wd:Q11538 rdfs:label "mathematical proof - a deductive argument that establishes a claim" .
  
  wd:Q2762418 rdfs:label "formal proof" .
  
  sub:activity a nt:GuidedChoicePlaceholder;
    rdfs:label "the study that produced this item";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://purl.obolibrary.org/obo/OBI_0000066" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares an item in the evidence and arguments layer of a project: an empirical result that bears on a claim, or a deductive argument such as a proof that establishes one. It is not the dataset and not the paper - those are inputs and outputs. Name the result, not the procedure and not the claim: use a head noun that is itself evidential, such as 'results', 'predictions', 'observation', 'corroboration' or 'benchmark', keep the label short because it appears in the summary diagram, and put the detail in the description.";
    rdfs:label "Declaring an evidence item or argument of a study";
    nt:hasNanopubLabelPattern "${title}";
    nt:hasStatement sub:st0, sub:st1, sub:st2, sub:st3, sub:st4, sub:st5;
    nt:hasTag "Spaces" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "what was found" .
  
  sub:item a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short name of the item, used as its identifier" .
  
  sub:kind a nt:RestrictedChoicePlaceholder;
    rdfs:label "is this empirical evidence or a deductive argument?";
    nt:possibleValue obo:ECO_0000000, wd:Q11538 .
  
  sub:output a nt:UriPlaceholder;
    rdfs:label "an output where this item is reported" .
  
  sub:st0 rdf:object sub:kind;
    rdf:predicate rdf:type;
    rdf:subject sub:item .
  
  sub:st1 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:subkind;
    rdf:predicate rdf:type;
    rdf:subject sub:item .
  
  sub:st2 rdf:object sub:title;
    rdf:predicate rdfs:label;
    rdf:subject sub:item .
  
  sub:st3 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:item .
  
  sub:st4 a nt:RepeatableStatement;
    rdf:object sub:activity;
    rdf:predicate prov:wasGeneratedBy;
    rdf:subject sub:item .
  
  sub:st5 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:output;
    rdf:predicate cito:isDocumentedBy;
    rdf:subject sub:item .
  
  sub:subkind a nt:GuidedChoicePlaceholder;
    rdfs:label "a more specific kind, if one fits";
    nt:possibleValue obo:ECO_0000006, obo:ECO_0000041, obo:ECO_0000212, obo:ECO_0000352,
      obo:ECO_0000361, obo:ECO_0000501, obo:ECO_0006055, obo:ECO_0006151, obo:ECO_0007672,
      wd:Q2762418;
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols/api/select?ontology=eco&allChildrenOf=http://purl.obolibrary.org/obo/ECO_0000000&q=" .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "short name of the item, as shown in listings and diagrams" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot> .
}

sub:pubinfo {
  this: dct:created "2026-08-18T08:40:25Z"^^xsd:dateTime;
    dct:creator <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot>;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    rdfs:label "Declaring an evidence item or argument of a study";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA0J4vUn_dekg-U1kK3AOEt02p9mT2WO03uGxLDec1jLw>,
      <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RA97ErZmL97PuPlwui1_qIdVTi5Ag8IaDdKeXlumYD_ms> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot> .
}

