@prefix this: <https://w3id.org/np/RABkfLmIVTDRosDhcfBPY9SWU_ejWYwzaOANE3SKFrR4g> .
@prefix sub: <https://w3id.org/np/RABkfLmIVTDRosDhcfBPY9SWU_ejWYwzaOANE3SKFrR4g/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:description rdfs:label "in more detail says" .
  
  dct:type rdfs:label "is of the kind" .
  
  rdf:type rdfs:label "is" .
  
  rdfs:label rdfs:label "in one sentence says" .
  
  wd:Q11743037 rdfs:label "🔧 could be improved (constructive criticism)" .
  
  wd:Q1208425 rdfs:label "👍 went well (praise)" .
  
  wd:Q89325745 rdfs:label "💡 suggestion for next time (suggestion)" .
  
  schema:Review rdfs:label "feedback (review)" .
  
  schema:itemReviewed rdfs:label "is feedback to the organizers of" .
  
  sub:details a nt:LongLiteralPlaceholder;
    rdfs:label "more details (optional)" .
  
  sub:feedback a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "This feedback" .
  
  sub:kind a nt:RestrictedChoicePlaceholder;
    rdfs:label "kind of feedback";
    nt:possibleValue wd:Q11743037, wd:Q1208425, wd:Q89325745 .
  
  sub:st01 rdf:object schema:Review;
    rdf:predicate rdf:type;
    rdf:subject sub:feedback .
  
  sub:st02 rdf:object sub:kind;
    rdf:predicate dct:type;
    rdf:subject sub:feedback .
  
  sub:st03 rdf:object sub:summary;
    rdf:predicate rdfs:label;
    rdf:subject sub:feedback .
  
  sub:st04 a nt:OptionalStatement;
    rdf:object sub:details;
    rdf:predicate dct:description;
    rdf:subject sub:feedback .
  
  sub:st05 rdf:object sub:target;
    rdf:predicate schema:itemReviewed;
    rdf:subject sub:feedback .
  
  sub:summary a nt:LiteralPlaceholder;
    rdfs:label "your feedback in one sentence" .
  
  sub:target a nt:GuidedChoicePlaceholder;
    rdfs:label "event, space, or maintained resource the feedback is for";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/MaintainedResource",
      "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Give feedback to the organizers of an event such as a conference, workshop, or tutorial (or of any other space or maintained resource): something that went well, something that could be improved, or a suggestion for next time. The feedback is a schema:Review whose schema:itemReviewed is the space or maintained resource; its kind is given with dct:type as one of the Wikidata items praise (Q1208425), constructive criticism (Q11743037), or suggestion (Q89325745). It gets a one-sentence summary and optional details. Other participants can up-vote it using the \"Up-voting an idea or feedback\" template, so that the organizers can see which points matter to many people. Note that, like every nanopublication, the feedback is public and signed with your identity.";
    rdfs:label "Giving feedback to organizers";
    nt:hasNanopubLabelPattern "Feedback: ${summary}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05;
    nt:hasTag "Events", "Feedback" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

