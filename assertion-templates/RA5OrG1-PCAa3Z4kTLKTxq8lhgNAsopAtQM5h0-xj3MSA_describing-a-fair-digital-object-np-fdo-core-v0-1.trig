    npx:hasSignature "p/0w9TW4KTKh4nR4n1VBrEqqw3XpFsL96p+CebPhqZ7RCOhc6qfMQjM8ef3ocU1yERb5wrlM9KyjcF3caY+v0IPE1fnbQKZ4js1ykcEY6bvZCwIS7kQLCwNaAW/N8QNhgLRS/wxU6LSIgg57Zsy/ap1bJmhFuWCSRYApWp3tRkg=";
