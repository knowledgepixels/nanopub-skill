sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is an" .
  
  rdfs:label rdfs:label "has the title" .
  
  rdfs:seeAlso rdfs:label "has further information at" .
  
  gen:isRelevantFor rdfs:label "is suggested for" .
  
  <https://w3id.org/np/RA7b4hUMrroGWIlG_JJm9XV_XJlHGqRiTFP0amY0BcOd8/Idea> rdfs:label
      "idea" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "description of the idea" .
  
  sub:idea a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "This idea" .
  
  sub:link a nt:ExternalUriPlaceholder;
    rdfs:label "a link with further information" .
  
  sub:st01 rdf:object <https://w3id.org/np/RA7b4hUMrroGWIlG_JJm9XV_XJlHGqRiTFP0amY0BcOd8/Idea>;
    rdf:predicate rdf:type;
    rdf:subject sub:idea .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate rdfs:label;
    rdf:subject sub:idea .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:idea .
  
  sub:st04 a nt:RepeatableStatement;
    rdf:object sub:target;
    rdf:predicate gen:isRelevantFor;
    rdf:subject sub:idea .
  
  sub:st05 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:link;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:idea .
  
  sub:target a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "space or maintained resource this idea is suggested for";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/MaintainedResource",
      "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Suggest an idea for a space or a maintained resource, for example a topic to be covered in a tutorial, a feature for a project, or an activity for a community. The idea gets a short title and an optional description, and is linked to the space(s) or maintained resource(s) it is suggested for. Other people can then support it with the \"Up-voting an idea\" template, so that the most wanted ideas can be identified.";
    rdfs:label "Suggesting an idea";
    nt:hasNanopubLabelPattern "Idea: ${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05;
    nt:hasTag "Ideas" .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "short title of the idea" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

