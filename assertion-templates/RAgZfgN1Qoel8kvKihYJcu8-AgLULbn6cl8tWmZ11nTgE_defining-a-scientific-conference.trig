    npx:supersedes <https://w3id.org/np/RAKt5SG8y-wWWEm6wDmJM_ApDi1JDYCKo2ok30ClAu9sw>;
    rdfs:label "Defining a scientific conference";
    skos:changeNote "Agent and guided-choice fields that must refer to existing resources are now also external URI placeholders, so Nanodash no longer offers to mint a typed plain name locally for them: admin.";
