@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:altlabel a nt:LiteralPlaceholder;
    rdfs:label "alternative label";
    nt:hasLanguageTag "en" .
  
  sub:assertion a nt:AssertionTemplate, nt:UnlistedTemplate;
    dct:description "Demo template for the language-tag picker on literal placeholders (nanodash PR #559). It shows all cases: 'name' has a restricted picker (en/de/fr) with default en and is repeatable (one name per language); 'comment' has an unrestricted picker with free BCP 47 entry (full tags like en-GB or de-CH can be typed) and, being optional, demonstrates that entering text without picking a language blocks submission; 'description' shows the picker on a long-literal textarea; 'regional name' has a restricted picker of full region-subtag languages (de-CH, de-DE, de-AT, fr-CH, it-CH) with no default; 'alternative label' has a fixed en tag for contrast (no picker).";
    rdfs:label "Example: Multilingual descriptions (language-tag picker demo)";
    nt:hasNanopubLabelPattern "Example: multilingual descriptions of ${thing}";
    nt:hasStatement sub:st1, sub:st2, sub:st3, sub:st4, sub:st5 .
  
  sub:comment a nt:LanguageTaggedLiteralPlaceholder, nt:LiteralPlaceholder;
    rdfs:label "comment" .
  
  sub:description a nt:LanguageTaggedLiteralPlaceholder, nt:LongLiteralPlaceholder;
    rdfs:label "description" .
  
  sub:name a nt:LanguageTaggedLiteralPlaceholder, nt:LiteralPlaceholder;
    rdfs:label "name";
    nt:hasLanguageTag "en";
    nt:possibleLanguageTag "de", "en", "fr" .
  
  sub:regionalname a nt:LanguageTaggedLiteralPlaceholder, nt:LiteralPlaceholder;
    rdfs:label "regional name";
    nt:possibleLanguageTag "de-AT", "de-CH", "de-DE", "fr-CH", "it-CH" .
  
  sub:st1 a nt:RepeatableStatement;
    rdf:object sub:name;
    rdf:predicate rdfs:label;
    rdf:subject sub:thing;
    nt:statementOrder "1"^^xsd:integer .
  
  sub:st2 a nt:OptionalStatement;
    rdf:object sub:comment;
    rdf:predicate rdfs:comment;
    rdf:subject sub:thing;
    nt:statementOrder "2"^^xsd:integer .
  
  sub:st3 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:thing;
    nt:statementOrder "3"^^xsd:integer .
  
  sub:st4 a nt:OptionalStatement;
    rdf:object sub:regionalname;
    rdf:predicate skos:prefLabel;
    rdf:subject sub:thing;
    nt:statementOrder "4"^^xsd:integer .
  
  sub:st5 a nt:OptionalStatement;
    rdf:object sub:altlabel;
    rdf:predicate skos:altLabel;
    rdf:subject sub:thing;
    nt:statementOrder "5"^^xsd:integer .
  
  sub:thing a nt:UriPlaceholder;
    rdfs:label "thing being described" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

