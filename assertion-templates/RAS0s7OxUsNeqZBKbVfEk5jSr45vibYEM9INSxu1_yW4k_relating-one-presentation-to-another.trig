sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdf:type rdfs:label "is a" .
  
  wd:Q604733 rdfs:label "presentation" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "States how one talk relates to another, using the CiTO relation types — that it extends it, uses its method or its data, confirms it, disagrees with it, or takes its background from it. Both talks are picked by title from the presentations published in the network, so the relation can cross sessions, workshops and conferences rather than staying inside one programme, and the relation itself is the standard CiTO property, so it reads the same as any other citation statement. The statement is repeatable, so one talk can be related to several others at once.";
    rdfs:label "Relating one presentation to another";
    nt:hasNanopubLabelPattern "Relation from: ${presentation}";
    nt:hasStatement sub:st01, sub:st02;
    nt:hasTag "Events";
    nt:hasTargetNanopubType wd:Q604733 .
  
  sub:other a nt:GuidedChoicePlaceholder;
    rdfs:label "the other talk (type part of its title)";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://www.wikidata.org/entity/Q604733" .
  
  sub:presentation a nt:GuidedChoicePlaceholder;
    rdfs:label "this talk";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://www.wikidata.org/entity/Q604733" .
  
  sub:relation a nt:RestrictedChoicePlaceholder;
    rdfs:label "how it relates to the other talk";
    nt:possibleValuesFrom <https://w3id.org/np/RAZt5kzfoJg2m4dMRdMm2SP6JeUDD_GMzSq9xyRPMgP5k> .
  
  sub:st01 rdf:object wd:Q604733;
    rdf:predicate rdf:type;
    rdf:subject sub:presentation .
  
  sub:st02 a nt:RepeatableStatement;
    rdf:object sub:other;
    rdf:predicate sub:relation;
    rdf:subject sub:presentation .
}

