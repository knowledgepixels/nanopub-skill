    npx:hasSignature "iqm4PdmYQB6kdqt2FDdWvKchFm8wT27y/C4we+xPB8uN6xtYoO2AyuwR5dsFGf3cUQ+h10w1GNjCuol7Mqsutt8YoC2GFzm5JovBYQaJWR4XybF/Co5h9tqt1NLd+2xL9l7Zu+az3wSIXoqls6ubGvTgAbryIVijPwEftXd6z2U=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

