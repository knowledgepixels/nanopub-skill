@prefix this: <https://w3id.org/np/RAUyaSwDeKfbXl4-_Q4-u58fRoHh98whfp-bRbmI8T4KI> .
@prefix sub: <https://w3id.org/np/RAUyaSwDeKfbXl4-_Q4-u58fRoHh98whfp-bRbmI8T4KI/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication asserts that a proof or other deductive argument establishes a given statement. Use this instead of a support relation when the grounds are deductive: a proof settles the statement given its premises, rather than adding weight that could later be outweighed. The statement is an AIDA sentence and the proof is an item in the evidence and arguments layer.";
    rdfs:label "Asserting that a proof establishes a statement";
    nt:hasNanopubLabelPattern "${proof} proves ${statement}";
    nt:hasStatement sub:st0;
    nt:hasTag "Spaces" .
  
  sub:proof a nt:GuidedChoicePlaceholder;
    rdfs:label "the proof or deductive argument";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://www.wikidata.org/entity/Q11538" .
  
  sub:st0 rdf:object sub:statement;
    rdf:predicate <https://w3id.org/np/RApY2x9ZrKtmpsW-ZINc1M1cvI9LYbmZ1-Gbgl3TEJsCI/proves>;
    rdf:subject sub:proof .
  
  sub:statement a nt:ExternalUriPlaceholder;
    rdfs:label "the statement that is established (an AIDA sentence URI)";
    nt:hasRegex "http://purl.org/aida/.*" .
  
  <https://w3id.org/np/RApY2x9ZrKtmpsW-ZINc1M1cvI9LYbmZ1-Gbgl3TEJsCI/proves> rdfs:label
      "proves" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot> .
}

sub:pubinfo {
  this: dct:created "2026-08-18T08:46:29Z"^^xsd:dateTime;
    dct:creator <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot>;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    rdfs:label "Asserting that a proof establishes a statement";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA0J4vUn_dekg-U1kK3AOEt02p9mT2WO03uGxLDec1jLw>,
      <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RA97ErZmL97PuPlwui1_qIdVTi5Ag8IaDdKeXlumYD_ms> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy <https://w3id.org/np/RA0SDqJIc3dtX2AihcvcSzBR7QIWfVl5lwk6U_MbH5RoA/nanopub-ecosystem-paper-bot> .
}

