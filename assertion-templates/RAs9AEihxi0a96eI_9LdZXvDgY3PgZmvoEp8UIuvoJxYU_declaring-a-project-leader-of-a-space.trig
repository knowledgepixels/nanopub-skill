sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  ff:has-project-leader a gen:InverseRoleProperty;
    rdfs:label "has project leader" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares that somebody is a project leader of a given Space.";
    rdfs:label "Declaring a project leader of a space";
    nt:hasNanopubLabelPattern "${space} has project leader: ${user}";
    nt:hasStatement sub:st1;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:RoleInstantiation .
  
  sub:space a nt:GuidedChoicePlaceholder;
    rdfs:label "choose the space";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:st1 rdf:object sub:user;
    rdf:predicate ff:has-project-leader;
    rdf:subject sub:space .
  
  sub:user a nt:AgentPlaceholder;
    rdfs:label "choose the project leader" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
