    npx:hasSignature "ITaGRnFn0xB0Khb+Pben0k4Xz+pYDEY+4zJWdhKJk4d4dIPg2J3nK/VHRYu9K/qpk46pxM42LtXtJ1J9NFPxqF1xY+zwvi3B4ZFUwqIgKD/gSDG1/gBtWCw1U490a5Qp8dj266hV95TFshdClJAF0hUHDHpCzq1eG7kRSZDqZOM=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

