    npx:introduces <https://w3id.org/np/RAFpID-NunXGUAZebXPfhD9efjvfpZqB5gDBrgP2Lp5N8/templateKind>;
    rdfs:label "Discourse contribution";
    skos:changeNote "Add optional subtype field (hypothesis, evidence, argument).";
