@prefix this: <https://w3id.org/np/RA1Aa_7HVwMwdfA77jp0vjBzlS_g8vT9vMwBSIawUeVrc> .
@prefix sub: <https://w3id.org/np/RA1Aa_7HVwMwdfA77jp0vjBzlS_g8vT9vMwBSIawUeVrc/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <http://schema.org/ReviewAction> rdfs:label "review action" .
  
  <http://schema.org/agent> rdfs:label "has reviewer" .
  
  <http://schema.org/endTime> rdfs:label "has review date" .
  
  <http://schema.org/object> rdfs:label "has the review item" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:comment rdfs:label "has comment" .
  
  rdfs:label rdfs:label "has the label" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "The creator of such a nanopublication declares to have reviewed a resource (article, dataset, etc.).";
    rdfs:label "Declaring to have reviewed something";
    nt:hasNanopubLabelPattern "Review: ${label}";
    nt:hasStatement sub:st1, sub:st2, sub:st3, sub:st4, sub:st5, sub:st6, sub:st7;
    nt:hasTag "Review";
    nt:hasTargetNanopubType <http://schema.org/ReviewAction> .
  
  sub:comment a nt:LongLiteralPlaceholder;
    rdfs:label "comment or note about the review" .
  
  sub:item a nt:ExternalUriPlaceholder;
    rdfs:label "URI of the reviewed item" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "short label" .
  
  sub:reviewAction a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "this" .
  
  sub:reviewDate a nt:LiteralPlaceholder;
    rdfs:label "date of the review (YYYY, YYYY-MM, or YYYY-MM-DD)";
    nt:hasDatatype xsd:dateTime .
  
  sub:reviewer a nt:AgentPlaceholder;
    rdfs:label "who reviewed it";
    nt:hasDefaultValue nt:CREATOR .
  
  sub:st1 rdf:object <http://schema.org/ReviewAction>;
    rdf:predicate rdf:type;
    rdf:subject sub:reviewAction .
  
  sub:st2 rdf:object sub:item;
    rdf:predicate <http://schema.org/object>;
    rdf:subject sub:reviewAction .
  
  sub:st3 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:item .
  
  sub:st4 rdf:object sub:reviewer;
    rdf:predicate <http://schema.org/agent>;
    rdf:subject sub:reviewAction .
  
  sub:st5 a nt:OptionalStatement;
    rdf:object sub:comment;
    rdf:predicate rdfs:comment;
    rdf:subject sub:reviewAction .
  
  sub:st6 a nt:OptionalStatement;
    rdf:object sub:reviewDate;
    rdf:predicate <http://schema.org/endTime>;
    rdf:subject sub:reviewAction .
  
  sub:st7 a nt:OptionalStatement;
    rdf:object sub:journal;
    rdf:predicate <http://purl.org/spar/fabio/Journal>;
    rdf:subject sub:reviewAction .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354 .
}

sub:pubinfo {
  orcid:0000-0001-8492-0354 foaf:name "Ashley Caselli" .
  
  this: dct:created "2026-08-05T12:41:42.858Z"^^xsd:dateTime;
