@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdf:type rdfs:label "is a" .
  
  gen:RevokedRoleInstantiation rdfs:label "role revocation" .
  
  gen:forAgent rdfs:label "revokes the role from" .
  
  gen:forSpace rdfs:label "applies to the space" .
  
  gen:hasRole rdfs:label "revokes the role" .
  
  sub:agent a nt:AgentPlaceholder;
    rdfs:label "choose the user whose role is revoked" .
  
  sub:assertion a nt:AssertionTemplate;
    rdfs:label "Revoking a space role";
    nt:hasNanopubLabelPattern "Revoking role ${role} of ${agent} in ${space}";
    nt:hasStatement sub:st10, sub:st20, sub:st30, sub:st40;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:RevokedRoleInstantiation .
  
  sub:revocation a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "this" .
  
  sub:role a nt:GuidedChoicePlaceholder;
    rdfs:label "choose the role (for revoking adminship, use the built-in admin role)";
    nt:possibleValue gen:AdminRole;
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAs7Q2IMbb7C2WzFa98bVwlDMhN3kJ0rrF9cSEybtvLaA/find-embedded-things?type=https://w3id.org/kpxl/gen/terms/SpaceMemberRole" .
  
  sub:space a nt:GuidedChoicePlaceholder;
    rdfs:label "choose the space";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:st10 rdf:object gen:RevokedRoleInstantiation;
    rdf:predicate rdf:type;
    rdf:subject sub:revocation .
  
  sub:st20 rdf:object sub:space;
    rdf:predicate gen:forSpace;
    rdf:subject sub:revocation .
  
  sub:st30 rdf:object sub:agent;
    rdf:predicate gen:forAgent;
    rdf:subject sub:revocation .
  
  sub:st40 rdf:object sub:role;
    rdf:predicate gen:hasRole;
    rdf:subject sub:revocation .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  gen:AdminRole rdfs:label "built-in admin role" .
  
  this: dct:created "2026-08-25T10:43:30Z"^^xsd:dateTime;
