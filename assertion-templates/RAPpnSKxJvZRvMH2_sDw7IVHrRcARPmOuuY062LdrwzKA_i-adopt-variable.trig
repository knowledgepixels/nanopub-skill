  iadopt:Constraint rdfs:label "I-ADOPT Constraint" .
  
  iadopt:Entity rdfs:label "I-ADOPT Entity" .
  
  iadopt:Property rdfs:label "I-ADOPT Property" .
  
  iadopt:StatisticalModifier rdfs:label "I-ADOPT Statistical Modifier" .
  
  iadopt:SymmetricSystem rdfs:label "I-ADOPT Symmetric System" .
  
