    nt:hasPrefix "_:";
    nt:hasPrefixLabel "_:" .
  
  sub:SysType a nt:RestrictedChoicePlaceholder;
    rdfs:label "choose system type";
    nt:possibleValue iadopt:AsymmetricSystem, iadopt:SymmetricSystem .
  
  sub:alternativename a nt:LiteralPlaceholder;
