sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdfs:label rdfs:label "has the label" .
  
  <https://schema.org/about> rdfs:label "is about" .
  
  sub:claim a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the Project Delphi claim";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/delphi/ontology/Claim" .
  
  sub:entity a nt:ExternalUriPlaceholder;
    rdfs:label "the IRI of something the claim is about" .
  
  sub:entityLabel a nt:LiteralPlaceholder;
    rdfs:label "its name" .
  
  sub:st00 a nt:GroupedStatement, nt:RepeatableStatement;
    nt:hasStatement sub:st01, sub:st02 .
  
  sub:st01 rdf:object sub:entity;
    rdf:predicate <https://schema.org/about>;
    rdf:subject sub:claim;
    nt:statementOrder "1" .
  
  sub:st02 a nt:OptionalStatement;
    rdf:object sub:entityLabel;
    rdf:predicate rdfs:label;
    rdf:subject sub:entity;
    nt:statementOrder "2" .
  
  sub:templateVersion a nt:AssertionTemplate;
    dct:description "States what a Project Delphi claim is about, such as a gene, protein, chemical, process, anatomical entity, phenotype or taxon, each identified by an IRI. Kept apart from the claim so that who or what made the link, and how, is recorded in this nanopublication's provenance, and so that a link can be corrected or retracted without touching the claim. Not to be confused with delphi:domain, the curated domain the claim belongs to.";
    dct:isVersionOf sub:template;
    rdfs:label "Project Delphi claim subject matter";
    gen:governedBy <https://w3id.org/spaces/delphi>;
    nt:hasStatement sub:st00, sub:st01, sub:st02;
    nt:hasTag "Project Delphi";
    nt:hasTargetNanopubType <https://schema.org/about> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354 .
}

