sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:assertion a nt:AssertionTemplate;
    dct:description "To assign a feeding strategy to a carabid species, for example expressing that the subject taxon has herbivory feeding strategy. A feeding strategy is usually assigned after critical evaluation of literature and/or field lab experiments, rather than on the basis of a single observation";
    rdfs:label "(test2 don't use) Assigning a feeding strategy to a carabid species";
    nt:hasNanopubLabelPattern "${subjtaxonname} - has feeding strategy - ${feedingstrategy}";
    nt:hasStatement sub:st;
    nt:hasTag "Biodiversity";
    nt:hasTargetNamespace <https://w3id.org/spaces/carabid-beetles>;
    nt:hasTargetNanopubType <https://w3id.org/kpxl/biodiv/terms/BiodivNanopub> .
  
  sub:feedingstrategy a nt:GuidedChoicePlaceholder;
    rdfs:label "start typing feeding strategy";
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols/api/select?ontology=ecocore&fieldList=iri,label,description&q=" .
  
  sub:st rdf:object sub:feedingstrategy;
    rdf:predicate <https://w3id.org/np/RAwzHXJpSgCWL151wjTEttV2gxaR36xaUhLr5MHKgcB7Y/feedingstrategy>;
    rdf:subject sub:subjtaxonname .
  
  sub:subjtaxonname a nt:GuidedChoicePlaceholder;
    rdfs:label "start typing species name";
    nt:possibleValuesFromApi "https://api.gbif.org/v1/species/suggest?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&q=" .
  
  <https://w3id.org/np/RAwzHXJpSgCWL151wjTEttV2gxaR36xaUhLr5MHKgcB7Y/feedingstrategy>
    rdfs:label "has feeding strategy" .
}

sub:provenance {
