@prefix this: <https://w3id.org/np/RAlGqr_bQLaAHu8VvETUciDF94kEAFmEewgbBhqmgafpM> .
@prefix sub: <https://w3id.org/np/RAlGqr_bQLaAHu8VvETUciDF94kEAFmEewgbBhqmgafpM/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the label" .
  
  gen:ActivatedPresetAssignment rdfs:label "activated preset assignment" .
  
  gen:MaintainedResource rdfs:label "maintained resource" .
  
  gen:PresetAssignment rdfs:label "preset assignment" .
  
  gen:isAssignmentFor rdfs:label "is an assignment for" .
  
  gen:isAssignmentOfPreset rdfs:label "is an assignment of the preset" .
  
  gen:isMaintainedBy rdfs:label "is maintained by" .
  
  <https://w3id.org/np/RADIyQb1nNitqYNmyu6SCD9QcQUqka6h0U_fZ47eMG4vk/presetVersion>
    rdfs:label "Maintained view preset" .
  
  sub:assignment a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "this" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "the description of the view" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the name of the view" .
  
  sub:resource a nt:ExternalUriPlaceholder, nt:IntroducedResource;
    rdfs:label "the view's version-independent IRI" .
  
  sub:space a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the space maintaining this view";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:st00 rdf:object gen:MaintainedResource;
    rdf:predicate rdf:type;
    rdf:subject sub:resource .
  
  sub:st02 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:resource .
  
  sub:st03 rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:resource .
  
  sub:st04 rdf:object sub:space;
    rdf:predicate gen:isMaintainedBy;
    rdf:subject sub:resource .
  
  sub:st10 a nt:AdvancedStatement;
    rdf:object gen:PresetAssignment;
    rdf:predicate rdf:type;
    rdf:subject sub:assignment .
  
  sub:st12 a nt:AdvancedStatement;
    rdf:object gen:ActivatedPresetAssignment;
    rdf:predicate rdf:type;
    rdf:subject sub:assignment .
  
  sub:st20 a nt:AdvancedStatement;
    rdf:object <https://w3id.org/np/RADIyQb1nNitqYNmyu6SCD9QcQUqka6h0U_fZ47eMG4vk/presetVersion>;
    rdf:predicate gen:isAssignmentOfPreset;
    rdf:subject sub:assignment .
  
  sub:st30 a nt:AdvancedStatement;
    rdf:object sub:resource;
    rdf:predicate gen:isAssignmentFor;
    rdf:subject sub:assignment .
  
  sub:templateVersion a nt:AssertionTemplate;
    dct:description """<p>List a <strong>resource view</strong> as a maintained resource of a space, so the space governs its versions and the view gets its own resource page.</p>

<p>Unlike the general \"Defining a maintained resource\" template, this one is specific to views: the same nanopublication also assigns the <em>Maintained view preset</em>, which supplies the standard views for a view page (view info and version history). Listing a view and giving it its standard page is therefore a single act.</p>

<p>The preset assignment is identified by the <em>(preset, resource)</em> pair, not by this nanopublication's URI, so it can later be deactivated on its own without superseding this nanopublication.</p>""";
    dct:isVersionOf sub:template;
    rdfs:label "Listing a view as a maintained resource";
    gen:governedBy <https://w3id.org/spaces/knowledgepixels>;
    nt:hasNanopubLabelPattern "${label} is a view maintained by ${space}";
    nt:hasStatement sub:st00, sub:st02, sub:st03, sub:st04, sub:st10, sub:st12, sub:st20,
      sub:st30;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:MaintainedResource, gen:PresetAssignment .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://w3id.org/np/RA8x10ZUeKboFh1DpTeAWXuzGY5RoukonyzLa2rqqMPtA> .
}

