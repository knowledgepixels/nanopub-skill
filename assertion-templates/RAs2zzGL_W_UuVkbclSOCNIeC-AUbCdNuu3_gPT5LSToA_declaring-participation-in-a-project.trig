    npx:hasSignature "kSwQMtmZwZAikEnN+LYDvNr7HjSSIxcPW2HgBMvkQGyDBp3MQIKfz8/IzK/BdMrHoAKixoR7Y9202DsjCEJs9xWVQVcOyWOi9+6NA2UJO0ygMN+g7ZjQVEx74L5B5Nq/xWSAqHcKnWFq4MVIbmQql/07+1YFViWnDhJjuRgAvq4=";
