@prefix this: <https://w3id.org/np/RAfNI9FTg_t5AQL0IPVpZEet6WxJGanCJF7FaTfjjFkW0> .
@prefix sub: <https://w3id.org/np/RAfNI9FTg_t5AQL0IPVpZEet6WxJGanCJF7FaTfjjFkW0/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix ns1: <http://purl.org/np/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <http://purl.org/cerif/frapo/isOutputOf> rdfs:label "was developed in the context of" .
  
  dct:created rdfs:label "was first released / created in" .
  
  dct:creator rdfs:label "was originally created by" .
  
  dct:description rdfs:label "has the short description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the name" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Template for defining a Research software. Keep this record short. Fix mistakes by updating it; the identifier stays the same. Everything that changes over time goes in the description record.";
    rdfs:label "Introducing a Research Software or Model";
    nt:hasNanopubLabelPattern "Software: ${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06;
    nt:hasTag "Research Software";
    nt:hasTargetNanopubType <http://purl.org/dc/dcmitype/Software> .
  
  sub:created a nt:LiteralPlaceholder;
    rdfs:label "year the software was created";
    nt:hasDatatype xsd:gYear;
    nt:hasRegex "^[0-9]{4}$" .
  
  sub:creator a nt:UriPlaceholder;
    rdfs:label "ORCID, ROR, or other URI of the developer" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "short software description" .
  
  sub:isoutputof a nt:UriPlaceholder;
    rdfs:label "CORDIS, grant DOI, RAiD, or the funder’s page" .
  
  sub:software a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "this software" .
  
  sub:softwaretype a nt:RestrictedChoicePlaceholder;
    rdfs:label "type of the software";
    nt:possibleValuesFrom <https://w3id.org/np/RASi03ZfBGMlEDOIEZpao4YCFFxisVi5yJwA4N5FHI0Eo> .
  
  sub:st01 a rdf:Statement, nt:RepeatableStatement;
    rdf:object sub:softwaretype;
    rdf:predicate rdf:type;
    rdf:subject sub:software .
  
  sub:st02 a rdf:Statement;
    rdf:object sub:title;
    rdf:predicate rdfs:label;
    rdf:subject sub:software .
  
  sub:st03 a rdf:Statement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:software .
  
  sub:st04 a rdf:Statement, nt:RepeatableStatement;
    rdf:object sub:creator;
    rdf:predicate dct:creator;
    rdf:subject sub:software .
  
  sub:st05 a nt:OptionalStatement;
    rdf:object sub:created;
    rdf:predicate dct:created;
    rdf:subject sub:software .
  
  sub:st06 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:isoutputof;
    rdf:predicate <http://purl.org/cerif/frapo/isOutputOf>;
    rdf:subject sub:software .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "the name of the software" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1297-3104 .
}

