sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://schema.org/image> rdfs:label "has the profile picture" .
  
  sub:image a nt:ValuePlaceholder;
    rdfs:label "image URL, or SVG markup in quotes" .
  
  sub:st rdf:object sub:image;
    rdf:predicate <https://schema.org/image>;
    rdf:subject sub:user .
  
  sub:template a nt:AssertionTemplate;
    dct:description "This template is used to define the profile picture of a User. Give either the URL of an image file, or the SVG markup of the picture itself as a quoted literal.";
    dct:isVersionOf sub:templateKind;
    rdfs:label "Define the profile picture of a User";
    gen:governedBy <https://w3id.org/spaces/knowledgepixels/nanodash>;
    nt:hasStatement sub:st .
  
  sub:user a nt:AgentPlaceholder .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

