@prefix sub: <https://w3id.org/np/RAuUAdXWlPCa0EXwpUTwmGr81mE1O-mDYgUR0hW629UgM/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix orcid: <https://orcid.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:title rdfs:label "has the title" .
  
  <http://schema.org/name> rdfs:label "has the name" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the label" .
  
  gen:MaintainerRole rdfs:label "Maintainer-tier role" .
  
  gen:MemberRole rdfs:label "Member-tier role" .
  
  gen:ObserverRole rdfs:label "Observer-tier role" .
  
  gen:SpaceMemberRole rdfs:label "space member role" .
  
  gen:hasInverseProperty rdfs:label "has the inverse property" .
  
  gen:hasRegularProperty rdfs:label "has the regular property" .
  
  gen:hasRoleAssignmentTemplate rdfs:label "has the role assignment template" .
  
  sub:assertion a nt:AssertionTemplate;
    rdfs:label "Declaring a space member role";
    nt:hasStatement sub:st01, sub:st01b, sub:st02a, sub:st02b, sub:st02c, sub:st03, sub:st10a,
      sub:st10b;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:SpaceMemberRole .
  
  sub:inverseProperty a nt:ExternalUriPlaceholder;
    rdfs:label "inverse property URI (space-to-agent)" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the label for the role" .
  
  sub:name a nt:LiteralPlaceholder;
    rdfs:label "short name, e.g. \"member\"" .
  
  sub:regularProperty a nt:ExternalUriPlaceholder;
    rdfs:label "regular property URI (agent-to-space)" .
  
  sub:role a nt:EmbeddedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short ID suffix" .
  
  sub:roleAssignmentTemplate a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "choose template";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAvSIHegG4Mb-Q64cWQoghLffvN_2NdDdqxNnOhJSZQfs/search-templates" .
  
  sub:st01 rdf:object gen:SpaceMemberRole;
    rdf:predicate rdf:type;
    rdf:subject sub:role .
  
  sub:st01b rdf:object sub:tier;
    rdf:predicate rdf:type;
    rdf:subject sub:role .
  
  sub:st02a rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:role .
  
  sub:st02b rdf:object sub:name;
    rdf:predicate <http://schema.org/name>;
    rdf:subject sub:role .
  
  sub:st02c rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:role .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:roleAssignmentTemplate;
    rdf:predicate gen:hasRoleAssignmentTemplate;
    rdf:subject sub:role .
  
  sub:st10a a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:regularProperty;
    rdf:predicate gen:hasRegularProperty;
    rdf:subject sub:role .
  
  sub:st10b a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:inverseProperty;
    rdf:predicate gen:hasInverseProperty;
    rdf:subject sub:role .
  
  sub:tier a nt:RestrictedChoicePlaceholder;
    rdfs:label "tier";
    nt:hasDefaultValue gen:ObserverRole;
    nt:possibleValue gen:MaintainerRole, gen:MemberRole, gen:ObserverRole .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "short header title, e.g. \"Members\"" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

