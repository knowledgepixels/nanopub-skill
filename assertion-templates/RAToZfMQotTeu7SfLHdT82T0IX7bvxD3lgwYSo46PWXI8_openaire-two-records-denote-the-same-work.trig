@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix orcid: <https://orcid.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  skos:exactMatch rdfs:label "is the same work as" .
  
  sub:recordA a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "record";
    nt:possibleValuesFromApi "https://api.openaire.eu/graph/v3/research-products?search=" .
  
  sub:recordB a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "same as this record";
    nt:possibleValuesFromApi "https://api.openaire.eu/graph/v3/research-products?search=" .
  
  sub:st1 rdf:object sub:recordB;
    rdf:predicate skos:exactMatch;
    rdf:subject sub:recordA .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares that two scholarly records denote the same work. This is useful, for example, to point out works that automatic deduplication has wrongly kept separate.";
    rdfs:label "OpenAIRE: Two records denote the same work";
    nt:hasNanopubLabelPattern "${recordA} is the same work as ${recordB}";
    nt:hasStatement sub:st1;
    nt:hasTag "OpenAIRE";
    nt:hasTargetNanopubType skos:exactMatch .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-09-24T12:04:38+00:00"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
