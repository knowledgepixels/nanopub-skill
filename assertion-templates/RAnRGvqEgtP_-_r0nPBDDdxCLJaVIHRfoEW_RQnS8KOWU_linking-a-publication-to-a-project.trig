sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <http://purl.org/cerif/frapo/hasOutput> rdfs:label "has output" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares that a given project has an existing publication as one of its outputs.";
    rdfs:label "Linking a publication to a project";
    nt:hasNanopubLabelPattern "${project} has output ${publication}";
    nt:hasStatement sub:st1;
    nt:hasTag "Spaces" .
  
  sub:project a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "choose the project";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Project" .
  
  sub:publication a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "choose the publication";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://purl.org/spar/fabio/ScholarlyWork" .
  
  sub:st1 rdf:object sub:publication;
    rdf:predicate <http://purl.org/cerif/frapo/hasOutput>;
    rdf:subject sub:project .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

