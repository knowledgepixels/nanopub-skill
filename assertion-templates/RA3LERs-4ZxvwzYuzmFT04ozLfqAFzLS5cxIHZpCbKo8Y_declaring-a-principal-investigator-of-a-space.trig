sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/fair/ff/terms/has-principal-investigator> a gen:InverseRoleProperty;
    rdfs:label "has principal investigator" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication declares that somebody is a principal investigator of a given Space.";
    rdfs:label "Declaring a principal investigator of a space";
    nt:hasNanopubLabelPattern "${space} has principal investigator: ${user}";
    nt:hasStatement sub:st1;
    nt:hasTag "Spaces";
    nt:hasTargetNanopubType gen:RoleInstantiation .
  
  sub:space a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "choose the space";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/Space" .
  
  sub:st1 rdf:object sub:user;
    rdf:predicate <https://w3id.org/fair/ff/terms/has-principal-investigator>;
    rdf:subject sub:space .
  
  sub:user a nt:AgentPlaceholder;
    rdfs:label "choose the principal investigator" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

