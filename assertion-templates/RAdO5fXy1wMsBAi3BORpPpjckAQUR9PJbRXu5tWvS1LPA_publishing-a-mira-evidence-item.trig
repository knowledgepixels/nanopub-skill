@prefix this: <https://w3id.org/np/RAdO5fXy1wMsBAi3BORpPpjckAQUR9PJbRXu5tWvS1LPA> .
@prefix sub: <https://w3id.org/np/RAdO5fXy1wMsBAi3BORpPpjckAQUR9PJbRXu5tWvS1LPA/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix mira: <http://purl.org/mira-science/mira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:title rdfs:label "has the title" .
  
  mira:Evidence rdfs:label "MIRA evidence item" .
  
  mira:is_grounded_in rdfs:label "is grounded in the study" .
  
  mira:observationBase rdfs:label "is based on the data" .
  
  mira:observationOriginActivity rdfs:label "originated from the activity" .
  
  mira:observationStatement rdfs:label "is an observation of the claim" .
  
  mira:sourceDocument rdfs:label "is reported in the source document" .
  
  sioc:content rdfs:label "has the content" .
  
  rdf:type rdfs:label "is a" .
  
  prov:Entity rdfs:label "data" .
  
  sub:activity a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the research activity this observation originated from (optional)";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Study" .
  
  sub:claim a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the MIRA claim this is an observation of";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Claim" .
  
  sub:content a nt:LongLiteralPlaceholder;
    rdfs:label "further text about the observation (optional)" .
  
  sub:data a nt:ExternalUriPlaceholder;
    rdfs:label "the data the observation is based on (a URL, DOI, dataset or figure)" .
  
  sub:document a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the source document reporting this evidence";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23SourceDocument" .
  
  sub:evidence a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short URI suffix for this evidence item";
    nt:hasDefaultValue sub:evidence .
  
  sub:st01 rdf:object mira:Evidence;
    rdf:predicate rdf:type;
    rdf:subject sub:evidence .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:evidence .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:content;
    rdf:predicate sioc:content;
    rdf:subject sub:evidence .
  
  sub:st04 rdf:object sub:claim;
    rdf:predicate mira:observationStatement;
    rdf:subject sub:evidence .
  
  sub:st05 rdf:object sub:data;
    rdf:predicate mira:observationBase;
    rdf:subject sub:evidence .
  
  sub:st06 rdf:object prov:Entity;
    rdf:predicate rdf:type;
    rdf:subject sub:data .
  
  sub:st07 a nt:OptionalStatement;
    rdf:object sub:study;
    rdf:predicate mira:is_grounded_in;
    rdf:subject sub:evidence .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:document;
    rdf:predicate mira:sourceDocument;
    rdf:subject sub:evidence .
  
  sub:st09 a nt:OptionalStatement;
    rdf:object sub:activity;
    rdf:predicate mira:observationOriginActivity;
    rdf:subject sub:evidence .
  
  sub:study a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the MIRA study that produced this evidence";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Study" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Publishes a piece of evidence as a MIRA record: one specific empirical observation from a particular application of a research method. MIRA requires an evidence item to say which claim it is an observation of, and on which data it is based. Whether the evidence supports or opposes the claim is a separate judgement, published with its own template.";
    dct:isVersionOf <https://w3id.org/np/RA0d-DGy3gPBo6p101X3v6IlSao1rHHhYURAkVOTKz6ps/templateKind>;
    rdfs:label "Publishing a MIRA evidence item";
    gen:governedBy <https://w3id.org/spaces/mira>;
    nt:hasNanopubLabelPattern "${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08, sub:st09;
    nt:hasTag "MIRA";
    nt:hasTargetNanopubType mira:Evidence, <https://w3id.org/spaces/mira/r/MiraRecord> .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "what was observed, as one sentence" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://github.com/MIRA-science/schema>, <https://mira.science/> .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-10-02T07:53:57Z"^^xsd:dateTime;
