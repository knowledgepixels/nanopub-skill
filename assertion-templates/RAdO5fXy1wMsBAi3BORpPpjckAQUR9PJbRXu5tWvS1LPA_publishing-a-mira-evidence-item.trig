    npx:hasSignature "q1JNTIsQoo19SLtmvajT913h/sZrq6FgBiyNA3i0e1ZM6SGGL4f2aESRcPHSE66eNsyARoGfP5HQk+xQkEBLILaQQcLTB81wGEQWiZB0AyNGomK0LXpHy9nAI9mfaImfSfLHDLVbW365H0saTeYvG16E+PinsMnyneWZncXj2ZI=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

