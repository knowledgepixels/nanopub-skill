  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0001-6534-6609 .
  
  <https://w3id.org/spaces/zdouclab> nt:hasLabelFromApi "ZdoucLab" .
}

