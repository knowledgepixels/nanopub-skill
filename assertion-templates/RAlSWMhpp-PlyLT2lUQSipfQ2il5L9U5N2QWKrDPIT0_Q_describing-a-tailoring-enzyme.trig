    npx:introduces <https://w3id.org/np/RArzZy2snnFyejqHkDM_6UH8UKctBDbrIaTencNefwA3I/templateKind>;
    npx:wasCreatedAt <https://nanodash.knowledgepixels.com/>;
    rdfs:label "Describing a tailoring enzyme";
    skos:changeNote "added uniprot field";
    prov:wasDerivedFrom <https://w3id.org/np/RApDP5ErD8OHIiMzHqBtjN5ECezXug4ggkqSBbV8G-tsU>;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
