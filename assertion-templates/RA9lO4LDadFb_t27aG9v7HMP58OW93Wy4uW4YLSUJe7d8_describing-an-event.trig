@prefix this: <https://w3id.org/np/RA9lO4LDadFb_t27aG9v7HMP58OW93Wy4uW4YLSUJe7d8> .
@prefix sub: <https://w3id.org/np/RA9lO4LDadFb_t27aG9v7HMP58OW93Wy4uW4YLSUJe7d8/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  frapo:hasAcronym rdfs:label "has the acronym" .
  
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the name" .
  
  rdfs:seeAlso rdfs:label "has a page at" .
  
  owl:sameAs rdfs:label "is the same thing as" .
  
  skos:altLabel rdfs:label "has the other name" .
  
  schema:endDate rdfs:label "ends on" .
  
  schema:location rdfs:label "takes place at" .
  
  schema:organizer rdfs:label "has the organizer" .
  
  schema:startDate rdfs:label "starts on" .
  
  schema:superEvent rdfs:label "is part of the series" .
  
  sub:acronym a nt:LiteralPlaceholder;
    rdfs:label "the acronym" .
  
  sub:altlabel a nt:LiteralPlaceholder;
    rdfs:label "another name" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "a description" .
  
  sub:enddate a nt:LiteralPlaceholder;
    rdfs:label "the last day";
    nt:hasDatatype xsd:date .
  
  sub:event a nt:IntroducedResource, nt:UriPlaceholder;
    rdfs:label "GND IRI, ConfIDent DOI, or a new short name" .
  
  sub:eventkind a nt:RestrictedChoicePlaceholder;
    rdfs:label "one gathering, or a series";
    nt:hasDefaultValue schema:Event;
    nt:possibleValue schema:Event, schema:EventSeries .
  
  sub:eventtype a nt:ExternalUriPlaceholder;
    rdfs:label "e.g. https://schema.org/ConferenceEvent" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the name" .
  
  sub:organizer a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "IRI of an organizing organization or person";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https%3A%2F%2Fschema.org%2FOrganization",
      "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https%3A%2F%2Fschema.org%2FPerson" .
  
  sub:page a nt:ExternalUriPlaceholder;
    rdfs:label "address of a page about it" .
  
  sub:place a nt:ExternalUriPlaceholder;
    rdfs:label "IRI of the place (Wikidata, GeoNames, ...)" .
  
  sub:placetext a nt:LiteralPlaceholder;
    rdfs:label "place in the source's words" .
  
  sub:sameas a nt:ExternalUriPlaceholder;
    rdfs:label "another IRI of the same thing" .
  
  sub:series a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "IRI of the series";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https%3A%2F%2Fschema.org%2FEvent" .
  
  sub:st01 rdf:object sub:eventkind;
    rdf:predicate rdf:type;
    rdf:subject sub:event .
  
  sub:st02 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:eventtype;
    rdf:predicate rdf:type;
    rdf:subject sub:event .
  
  sub:st03 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:event .
  
  sub:st04 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:altlabel;
    rdf:predicate skos:altLabel;
    rdf:subject sub:event .
  
  sub:st05 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:event .
  
  sub:st06 a nt:OptionalStatement;
    rdf:object sub:acronym;
    rdf:predicate frapo:hasAcronym;
    rdf:subject sub:event .
  
  sub:st07 a nt:OptionalStatement;
    rdf:object sub:startdate;
    rdf:predicate schema:startDate;
    rdf:subject sub:event .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:enddate;
    rdf:predicate schema:endDate;
    rdf:subject sub:event .
  
  sub:st09 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:place;
    rdf:predicate schema:location;
    rdf:subject sub:event .
  
  sub:st10 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:placetext;
    rdf:predicate schema:location;
    rdf:subject sub:event .
  
  sub:st11 a nt:OptionalStatement;
    rdf:object sub:series;
    rdf:predicate schema:superEvent;
    rdf:subject sub:event .
  
  sub:st12 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:organizer;
    rdf:predicate schema:organizer;
    rdf:subject sub:event .
  
  sub:st13 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:sameas;
    rdf:predicate owl:sameAs;
    rdf:subject sub:event .
  
  sub:st14 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:page;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:event .
  
  sub:startdate a nt:LiteralPlaceholder;
    rdfs:label "the first day";
    nt:hasDatatype xsd:date .
  
  sub:templateVersion a nt:AssertionTemplate;
    dct:description "Describes an event, that is one gathering with a time and a place, or an event series, following the AI-FAIR Compendia schema recommendation. An announcement, a call for papers, a deposited talk or the proceedings are not the event. The event is named by its GND IRI, or else by its ConfIDent DOI, or else by a newly minted IRI.";
    dct:isVersionOf sub:template;
    rdfs:label "Describing an event";
    gen:governedBy <https://w3id.org/spaces/pensoft>;
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08, sub:st09, sub:st10, sub:st11, sub:st12, sub:st13, sub:st14;
    nt:hasTag "Pensoft";
    nt:hasTargetNanopubType schema:Event .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-11-13T14:10:29.185+01:00"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
