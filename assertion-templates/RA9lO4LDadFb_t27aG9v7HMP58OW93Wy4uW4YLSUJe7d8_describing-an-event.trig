    npx:hasSignature "R9nMCAdAyCNugE5v5rcBn9UMQj/K52SOKlTcAWAG/QN2cGGx2uJgFoIyRYuUbaXeYQbcHc5O0CV1lFa3ZpgDBPXyL/fKaY91jq9/6Du5Pifzs5jllRYO/hAt5uSkRnJktJ25UR6Y3KHcscJc2dylbqCLMG3aMrKwLhBvAlRYZQ8=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

