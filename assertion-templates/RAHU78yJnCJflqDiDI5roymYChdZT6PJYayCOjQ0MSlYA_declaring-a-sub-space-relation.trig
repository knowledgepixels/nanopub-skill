    npx:supersedes <https://w3id.org/np/RAXdKiIZbrPgUT-dkm4WP01rW1Kjxb0iUc31400Q0yeRk>;
    rdfs:label "Declaring a sub-space relation";
    skos:changeNote "Guided choices that must refer to existing resources are now also external URI placeholders, so Nanodash no longer offers to mint a typed plain name locally for them: parent, child.";
