@prefix sub: <https://w3id.org/np/RA0B1Ayz3xAHcPipNspLKvgf2gmydcWbtLB-14gWXvs0w/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix mira: <http://purl.org/mira-science/mira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:title rdfs:label "has the title" .
  
  mira:SourceDocument rdfs:label "MIRA source document" .
  
  mira:describesActivity rdfs:label "describes the activity" .
  
  rdf:type rdfs:label "is a" .
  
  sub:activity a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the MIRA study or protocol this document describes";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Protocol",
      "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Study" .
  
  sub:document a nt:ExternalUriPlaceholder;
    rdfs:label "the DOI or URL of the document" .
  
  sub:st01 rdf:object mira:SourceDocument;
    rdf:predicate rdf:type;
    rdf:subject sub:document .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:document .
  
  sub:st03 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:activity;
    rdf:predicate mira:describesActivity;
    rdf:subject sub:document .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Registers an existing document - a journal article, preprint, book or conference paper - as a MIRA source document, and records which research activity it describes. The document keeps its own identifier (a DOI or URL); no new identifier is minted.";
    dct:isVersionOf <https://w3id.org/np/RAMlaof5zHWBC0Q3m8FbrJM4dsz4Y6M8DMKvJwnha88Gc/templateKind>;
    rdfs:label "Registering a MIRA source document";
    gen:governedBy <https://w3id.org/spaces/mira>;
    nt:hasNanopubLabelPattern "${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03;
    nt:hasTag "MIRA";
    nt:hasTargetNanopubType mira:SourceDocument, <https://w3id.org/spaces/mira/r/MiraRecord> .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "the title of the document" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://github.com/MIRA-science/schema>, <https://mira.science/> .
}

