sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  mira:opposes rdfs:label "opposes the claim" .
  
  sub:argument a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the MIRA claim or evidence item making the case";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Claim",
      "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Evidence" .
  
  sub:claim a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the MIRA claim it is about";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Claim" .
  
  sub:st01 rdf:object sub:claim;
    rdf:predicate mira:opposes;
    rdf:subject sub:argument .
  
  sub:template a nt:AssertionTemplate;
    dct:description "States that an existing MIRA claim or evidence item opposes a MIRA claim. This is the epistemic judgement itself, signed by whoever makes it, so it is published separately from the records it links - anyone may oppose anyone else's claim.";
    dct:isVersionOf <https://w3id.org/np/RArwPtBdIM2gCF-MxqHaSYqhMgPVp-BezS1-NoAE4JtX4/templateKind>;
    rdfs:label "Opposing a MIRA claim";
    gen:governedBy <https://w3id.org/spaces/mira>;
    nt:hasStatement sub:st01;
    nt:hasTag "MIRA";
    nt:hasTargetNanopubType mira:opposes, <https://w3id.org/spaces/mira/r/MiraRecord> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://github.com/MIRA-science/schema>, <https://mira.science/> .
}

