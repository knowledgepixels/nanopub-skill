@prefix this: <https://w3id.org/np/RAnhFaMe-SKEeE7z0Z8PnNQxV-SAM4WXc6GPIAdUZkarM> .
@prefix sub: <https://w3id.org/np/RAnhFaMe-SKEeE7z0Z8PnNQxV-SAM4WXc6GPIAdUZkarM/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix mira: <http://purl.org/mira-science/mira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:title rdfs:label "has the title" .
  
  mira:Request rdfs:label "MIRA request" .
  
  mira:request_for rdfs:label "is a request for the study" .
  
  mira:request_target rdfs:label "targets the claim" .
  
  sioc:content rdfs:label "has the content" .
  
  rdf:type rdfs:label "is a" .
  
  sub:claim a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "a MIRA claim this request would settle";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Claim" .
  
  sub:content a nt:LongLiteralPlaceholder;
    rdfs:label "further text about the request (optional)" .
  
  sub:request a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short URI suffix for this request";
    nt:hasDefaultValue sub:request .
  
  sub:st01 rdf:object mira:Request;
    rdf:predicate rdf:type;
    rdf:subject sub:request .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:request .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:content;
    rdf:predicate sioc:content;
    rdf:subject sub:request .
  
  sub:st04 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:study;
    rdf:predicate mira:request_for;
    rdf:subject sub:request .
  
  sub:st05 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:claim;
    rdf:predicate mira:request_target;
    rdf:subject sub:request .
  
  sub:study a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "a MIRA study this request asks for";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http%3A%2F%2Fpurl.org%2Fmira-science%2Fmira%23Study" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Publishes a request as a MIRA record: a unit of work the community can pick up, issue-tracker-shaped. A request can name the study it asks for and the claim it would settle.";
    dct:isVersionOf <https://w3id.org/np/RAFuZekJxSndpFe5C6MZkcgqepkL-LLEKs2qPGP7BAJHI/templateKind>;
    rdfs:label "Publishing a MIRA request";
    gen:governedBy <https://w3id.org/spaces/mira>;
    nt:hasNanopubLabelPattern "${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05;
    nt:hasTag "MIRA";
    nt:hasTargetNanopubType mira:Request, <https://w3id.org/spaces/mira/r/MiraRecord> .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "what is being requested, as one sentence" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://github.com/MIRA-science/schema>, <https://mira.science/> .
}

