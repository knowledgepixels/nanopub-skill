sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <http://purl.obolibrary.org/obo/ECOCORE_00000111> rdfs:label "Monophagy" .
  
  <http://purl.obolibrary.org/obo/ECOCORE_00000112> rdfs:label "Oligophagy" .
  
  <http://purl.obolibrary.org/obo/ECOCORE_00000113> rdfs:label "Polyphagy" .
  
  <https://w3id.org/np/RA-lzRsR4-2LiFpQnWBUlzWGX8L0H2pBYVcUAea1PJtEg/hasTrophicNicheBreadth>
    rdfs:label "has trophic niche" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Such a nanopublication assigns a trophic niche breadth to a carabid species, for outlining how specialized a carabid's diet is, among monophagy, oligophagy and polyphagy";
    rdfs:label "(test2 don't use) Assigning a trophic niche breadth to a carabid species";
    nt:hasNanopubLabelPattern "${subjtaxonname} - has trophic niche breadth - ${nichebreadth}";
    nt:hasStatement sub:st;
    nt:hasTag "Biodiversity";
    nt:hasTargetNamespace <https://w3id.org/spaces/carabid-beetles>;
    nt:hasTargetNanopubType <https://w3id.org/kpxl/biodiv/terms/BiodivNanopub> .
  
  sub:nichebreadth a nt:RestrictedChoicePlaceholder;
    rdfs:label "choose among monophagy, oligophagy, polyphagy";
    nt:possibleValue <http://purl.obolibrary.org/obo/ECOCORE_00000111>, <http://purl.obolibrary.org/obo/ECOCORE_00000112>,
      <http://purl.obolibrary.org/obo/ECOCORE_00000113> .
  
  sub:st rdf:object sub:nichebreadth;
    rdf:predicate <https://w3id.org/np/RA-lzRsR4-2LiFpQnWBUlzWGX8L0H2pBYVcUAea1PJtEg/hasTrophicNicheBreadth>;
    rdf:subject sub:subjtaxonname .
  
  sub:subjtaxonname a nt:GuidedChoicePlaceholder;
    rdfs:label "start typing species name";
    nt:possibleValuesFromApi "https://api.gbif.org/v1/species/suggest?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&q=" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-4587-3476 .
}

