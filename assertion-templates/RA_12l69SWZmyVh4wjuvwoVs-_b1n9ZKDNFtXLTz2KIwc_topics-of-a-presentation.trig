sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:subject rdfs:label "is about" .
  
  rdf:type rdfs:label "is a" .
  
  wd:Q604733 rdfs:label "presentation" .
  
  sub:assertion a nt:AssertionTemplate;
    dct:description "Records what a talk is about: one or more topics, each identified by a URI that already exists — a Wikidata item, found by typing a word and picking from the list, or any other URI pasted in, such as a W3C specification for a standard Wikidata does not yet cover. Nothing new is minted, which is what lets the topics link talks beyond one event: two talks that share a topic are related to each other wherever in the network they were published. The topic statement is repeatable, so a talk can carry as many as it needs.";
    rdfs:label "Topics of a presentation";
    nt:hasNanopubLabelPattern "Topics of: ${presentation}";
    nt:hasStatement sub:st01, sub:st02;
    nt:hasTag "Events";
    nt:hasTargetNanopubType wd:Q604733 .
  
  sub:presentation a nt:GuidedChoicePlaceholder;
    rdfs:label "the talk or presentation";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=http://www.wikidata.org/entity/Q604733" .
  
  sub:st01 rdf:object wd:Q604733;
    rdf:predicate rdf:type;
    rdf:subject sub:presentation .
  
  sub:st02 a nt:RepeatableStatement;
    rdf:object sub:topic;
    rdf:predicate dct:subject;
    rdf:subject sub:presentation .
  
  sub:topic a nt:GuidedChoicePlaceholder;
    rdfs:label "a topic the talk is about (type a word to search Wikidata, or paste any URI)";
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

