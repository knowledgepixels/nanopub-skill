@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:isReferencedBy rdfs:label "is covered by" .
  
  sub:coveredTopic a nt:ExternalUriPlaceholder;
    rdfs:label "the topic that was covered" .
  
  sub:newsArticle a nt:ExternalUriPlaceholder;
    rdfs:label "the news article covering it" .
  
  sub:st1 rdf:object sub:newsArticle;
    rdf:predicate dct:isReferencedBy;
    rdf:subject sub:coveredTopic .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Reports that one news article covers a given topic. Deliberately atomic: one article per nanopublication, so that coverage accumulates as independent, separately attributed contributions rather than being owned by whoever first defined the topic. Anyone can add coverage for a topic without touching the topic's definition, and a single mistaken claim can be retracted on its own. The count of such claims is what a coverage threshold (for example 'has appeared in at least three news articles') is measured against.";
    dct:isVersionOf sub:templateKind;
    rdfs:label "Reporting news coverage of a topic";
    gen:governedBy <https://w3id.org/spaces/wikinewsie>;
    nt:hasNanopubLabelPattern "news coverage of ${coveredTopic}";
    nt:hasStatement sub:st1;
    nt:hasTag "Wikinewsie" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-08-26T14:20:19Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:template;
    npx:introduces sub:templateKind;
    rdfs:label "Reporting news coverage of a topic";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
      <https://w3id.org/np/RAMEgudZsQ1bh1fZhfYnkthqH6YSXpghSE_DEN1I-6eAI>, <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RA9cOdAwjxTF6qNNFkXTl_EgOan0LDPmu0fWnIgmZu-7E/template> .
  
