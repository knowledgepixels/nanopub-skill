@prefix this: <https://w3id.org/np/RAw9Z_Kgy9kgYDgIImptSA5H13EDoZyx0Jhx0VI-syQ04> .
@prefix sub: <https://w3id.org/np/RAw9Z_Kgy9kgYDgIImptSA5H13EDoZyx0Jhx0VI-syQ04/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:abstract rdfs:label "has the abstract" .
  
  dct:isPartOf rdfs:label "is part of" .
  
  dct:publisher rdfs:label "is published by" .
  
  dct:title rdfs:label "has the title" .
  
  bibo:authorList rdfs:label "has the author list" .
  
  bibo:chapter rdfs:label "is chapter number" .
  
  bibo:pageEnd rdfs:label "ends on page" .
  
  bibo:pageStart rdfs:label "starts on page" .
  
  fabio:BookChapter rdfs:label "book chapter" .
  
  fabio:hasPublicationYear rdfs:label "has the publication year" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:seeAlso rdfs:label "see also" .
  
  schema:about rdfs:label "is about" .
  
  sub:abstract a nt:LongLiteralPlaceholder;
    rdfs:label "abstract of the chapter" .
  
  sub:author a nt:AgentPlaceholder;
    rdfs:label "an author of the chapter";
    nt:hasDefaultValue nt:CREATOR .
  
  sub:author-list a nt:LocalResource;
    rdfs:label "this author list" .
  
  sub:book a nt:ExternalUriPlaceholder;
    rdfs:label "the book: a DOI or an https ISBN link" .
  
  sub:book-title a nt:LiteralPlaceholder;
    rdfs:label "title of the book" .
  
  sub:chapter a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short ID suffix for the chapter" .
  
  sub:chapter-number a nt:LiteralPlaceholder;
    rdfs:label "chapter number";
    nt:hasRegex "[0-9]+" .
  
  sub:link a nt:UriPlaceholder;
    rdfs:label "URL to the chapter or a related resource" .
  
  sub:membership-property a nt:SequenceElementPlaceholder;
    rdfs:label "has at position ${number}";
    nt:hasPrefix "http://www.w3.org/1999/02/22-rdf-syntax-ns#_";
    nt:hasPrefixLabel "includes as element number";
    nt:hasRegex "[1-9][0-9]*" .
  
  sub:pageEnd a nt:LiteralPlaceholder;
    rdfs:label "end page" .
  
  sub:pageStart a nt:LiteralPlaceholder;
    rdfs:label "start page" .
  
  sub:publisher a nt:LiteralPlaceholder;
    rdfs:label "publisher of the book" .
  
  sub:st01 rdf:object fabio:BookChapter;
    rdf:predicate rdf:type;
    rdf:subject sub:chapter .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:chapter .
  
  sub:st03 rdf:object sub:year;
    rdf:predicate fabio:hasPublicationYear;
    rdf:subject sub:chapter .
  
  sub:st04 rdf:object sub:author-list;
    rdf:predicate bibo:authorList;
    rdf:subject sub:chapter .
  
  sub:st04a a nt:RepeatableStatement;
    rdf:object sub:author;
    rdf:predicate sub:membership-property;
    rdf:subject sub:author-list .
  
  sub:st05 rdf:object sub:book;
    rdf:predicate dct:isPartOf;
    rdf:subject sub:chapter .
  
  sub:st05a rdf:object sub:book-title;
    rdf:predicate dct:title;
    rdf:subject sub:book .
  
  sub:st05b a nt:OptionalStatement;
    rdf:object sub:publisher;
    rdf:predicate dct:publisher;
    rdf:subject sub:book .
  
  sub:st06 a nt:OptionalStatement;
    rdf:object sub:chapter-number;
    rdf:predicate bibo:chapter;
    rdf:subject sub:chapter .
  
  sub:st07a a nt:OptionalStatement;
    rdf:object sub:pageStart;
    rdf:predicate bibo:pageStart;
    rdf:subject sub:chapter .
  
  sub:st07b a nt:OptionalStatement;
    rdf:object sub:pageEnd;
    rdf:predicate bibo:pageEnd;
    rdf:subject sub:chapter .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:abstract;
    rdf:predicate dct:abstract;
    rdf:subject sub:chapter .
  
  sub:st09 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:link;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:chapter .
  
  sub:st10 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:topic;
    rdf:predicate schema:about;
    rdf:subject sub:chapter .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Publish metadata about a chapter in a book: title, year, ordered authors, the book it belongs to, and optionally the chapter number, pages, abstract, links and topics. Identify the book by a DOI or an https ISBN link such as https://books.google.com/books?vid=ISBN9781234567890.";
    rdfs:label "Publishing information about a book chapter";
    nt:hasNanopubLabelPattern "Book chapter: ${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st04a, sub:st05, sub:st05a,
      sub:st05b, sub:st06, sub:st07a, sub:st07b, sub:st08, sub:st09, sub:st10;
    nt:hasTag "Publications";
    nt:hasTargetNanopubType fabio:BookChapter .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "title of the chapter" .
  
  sub:topic a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "topic or subject of the chapter";
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .
  
  sub:year a nt:LiteralPlaceholder;
    rdfs:label "year of publication";
    nt:hasDatatype xsd:gYear .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354 .
}

sub:pubinfo {
  this: dct:created "2026-10-15T18:00:26Z"^^xsd:dateTime;
    dct:creator orcid:0000-0001-8492-0354;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:template;
    rdfs:label "Publishing information about a book chapter";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
      <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0001-8492-0354 .
}

