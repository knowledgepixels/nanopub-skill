@prefix this: <https://w3id.org/np/RASQg5FXAnL8EJYEpft2_CO4aXRq8VKdRwXQR2wCtgWmg> .
@prefix sub: <https://w3id.org/np/RASQg5FXAnL8EJYEpft2_CO4aXRq8VKdRwXQR2wCtgWmg/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix relators: <http://id.loc.gov/vocabulary/relators/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  relators:ths rdfs:label "has the thesis advisor" .
  
  dct:abstract rdfs:label "has the abstract" .
  
  dct:issued rdfs:label "was issued on" .
  
  dct:title rdfs:label "has the title" .
  
  bibo:authorList rdfs:label "has the author list" .
  
  fabio:BachelorsThesis rdfs:label "bachelor's thesis" .
  
  fabio:DoctoralThesis rdfs:label "doctoral thesis" .
  
  fabio:MastersThesis rdfs:label "master's thesis" .
  
  fabio:hasPublicationYear rdfs:label "has the publication year" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:seeAlso rdfs:label "see also" .
  
  wd:P4101 rdfs:label "was submitted to" .
  
  schema:about rdfs:label "is about" .
  
  sub:abstract a nt:LongLiteralPlaceholder;
    rdfs:label "abstract of the thesis" .
  
  sub:author a nt:AgentPlaceholder;
    rdfs:label "the author of the thesis";
    nt:hasDefaultValue nt:CREATOR .
  
  sub:author-list a nt:LocalResource;
    rdfs:label "this author list" .
  
  sub:author-position a nt:SequenceElementPlaceholder;
    rdfs:label "has at position ${number}";
    nt:hasPrefix "http://www.w3.org/1999/02/22-rdf-syntax-ns#_";
    nt:hasPrefixLabel "includes as element number";
    nt:hasRegex "[1-9][0-9]*" .
  
  sub:institution a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the institution the thesis was submitted to";
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .
  
  sub:issued a nt:LiteralPlaceholder;
    rdfs:label "date the thesis was issued";
    nt:hasDatatype xsd:date .
  
  sub:link a nt:UriPlaceholder;
    rdfs:label "URL to the thesis or a related resource" .
  
  sub:st01 rdf:object sub:thesis-kind;
    rdf:predicate rdf:type;
    rdf:subject sub:thesis .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:thesis .
  
  sub:st03 rdf:object sub:year;
    rdf:predicate fabio:hasPublicationYear;
    rdf:subject sub:thesis .
  
  sub:st04 a nt:OptionalStatement;
    rdf:object sub:issued;
    rdf:predicate dct:issued;
    rdf:subject sub:thesis .
  
  sub:st05 rdf:object sub:author-list;
    rdf:predicate bibo:authorList;
    rdf:subject sub:thesis .
  
  sub:st05a a nt:RepeatableStatement;
    rdf:object sub:author;
    rdf:predicate sub:author-position;
    rdf:subject sub:author-list .
  
  sub:st06 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:supervisor;
    rdf:predicate relators:ths;
    rdf:subject sub:thesis .
  
  sub:st07 rdf:object sub:institution;
    rdf:predicate wd:P4101;
    rdf:subject sub:thesis .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:abstract;
    rdf:predicate dct:abstract;
    rdf:subject sub:thesis .
  
  sub:st09 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:link;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:thesis .
  
  sub:st10 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:topic;
    rdf:predicate schema:about;
    rdf:subject sub:thesis .
  
  sub:supervisor a nt:AgentPlaceholder;
    rdfs:label "a supervisor of the thesis" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Publish metadata about a doctoral, master's or bachelor's thesis: its kind, title, year, author, the institution it was submitted to, and optionally its issue date, supervisors, abstract, links and topics. Identify the thesis by its DOI or by its stable repository URL.";
    rdfs:label "Publishing information about a thesis";
    nt:hasNanopubLabelPattern "Thesis: ${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st05a, sub:st06,
      sub:st07, sub:st08, sub:st09, sub:st10;
    nt:hasTag "Publications";
    nt:hasTargetNanopubType fabio:Thesis .
  
  sub:thesis a nt:ExternalUriPlaceholder, nt:IntroducedResource;
    rdfs:label "the thesis: its DOI or stable repository URL" .
  
  sub:thesis-kind a nt:RestrictedChoicePlaceholder;
    rdfs:label "kind of thesis";
    nt:hasDefaultValue fabio:DoctoralThesis;
    nt:possibleValue fabio:BachelorsThesis, fabio:DoctoralThesis, fabio:MastersThesis .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "title of the thesis" .
  
  sub:topic a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "topic or subject of the thesis";
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .
  
  sub:year a nt:LiteralPlaceholder;
    rdfs:label "year of the thesis";
    nt:hasDatatype xsd:gYear .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354 .
}

sub:pubinfo {
  this: dct:created "2026-10-15T18:19:27Z"^^xsd:dateTime;
    dct:creator orcid:0000-0001-8492-0354;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:template;
    rdfs:label "Publishing information about a thesis";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
      <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0001-8492-0354 .
}

