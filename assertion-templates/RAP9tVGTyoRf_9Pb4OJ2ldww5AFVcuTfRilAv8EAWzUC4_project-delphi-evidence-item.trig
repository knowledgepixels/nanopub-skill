@prefix this: <https://w3id.org/np/RAP9tVGTyoRf_9Pb4OJ2ldww5AFVcuTfRilAv8EAWzUC4> .
@prefix sub: <https://w3id.org/np/RAP9tVGTyoRf_9Pb4OJ2ldww5AFVcuTfRilAv8EAWzUC4/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix orcid: <https://orcid.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the label" .
  
  prov:wasDerivedFrom rdfs:label "is derived from" .
  
  <https://w3id.org/delphi/ontology/EvidenceItem> rdfs:label "evidence item" .
  
  <https://w3id.org/delphi/ontology/pValue> rdfs:label "has the p-value" .
  
  <https://w3id.org/delphi/ontology/statisticalTest> rdfs:label "comes from the statistical test" .
  
  <https://w3id.org/delphi/ontology/vovkSellkeMaxPRatio> rdfs:label "has the Vovk–Sellke maximum p-ratio" .
  
  <https://w3id.org/delphi/ontology/weightOfEvidence> rdfs:label "has the weight of evidence (0–1)" .
  
  <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~> a nt:IntroducedResource;
    rdfs:label "this evidence item" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "a longer description of the evidence" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the evidence in one sentence" .
  
  sub:paper a nt:ExternalUriPlaceholder;
    rdfs:label "the paper reporting the evidence (DOI as https://doi.org/… IRI)";
    nt:hasPrefix "https://doi.org/";
    nt:hasPrefixLabel "DOI" .
  
  sub:pvalue a nt:LiteralPlaceholder;
    rdfs:label "the p-value";
    nt:hasDatatype xsd:double .
  
  sub:st01 rdf:object <https://w3id.org/delphi/ontology/EvidenceItem>;
    rdf:predicate rdf:type;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "1" .
  
  sub:st02 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "2" .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "3" .
  
  sub:st04 a nt:OptionalStatement;
    rdf:object sub:paper;
    rdf:predicate prov:wasDerivedFrom;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "4" .
  
  sub:st05 a nt:OptionalStatement;
    rdf:object sub:test;
    rdf:predicate <https://w3id.org/delphi/ontology/statisticalTest>;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "5" .
  
  sub:st06 a nt:OptionalStatement;
    rdf:object sub:pvalue;
    rdf:predicate <https://w3id.org/delphi/ontology/pValue>;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "6" .
  
  sub:st07 a nt:OptionalStatement;
    rdf:object sub:vsmpr;
    rdf:predicate <https://w3id.org/delphi/ontology/vovkSellkeMaxPRatio>;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "7" .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:weight;
    rdf:predicate <https://w3id.org/delphi/ontology/weightOfEvidence>;
    rdf:subject <https://w3id.org/delphi/resource/evidence/~~ARTIFACTCODE~~>;
    nt:statementOrder "8" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "A single piece of evidence for or against a Project Delphi claim, as reported in a paper: the statistical test and p-value it rests on, the Vovk–Sellke maximum p-ratio bound derived from that p-value, and its weight of evidence. The evidence item's identifier is minted from this nanopublication's artifact code.";
    dct:isVersionOf <https://w3id.org/np/RAXGuXJtOBVqNAQswIpXkUHtrgY4NADQjIT2YYTpDbyd8/evidenceKind>;
    rdfs:label "Project Delphi evidence item";
    gen:governedBy <https://w3id.org/spaces/delphi>;
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08;
    nt:hasTag "Project Delphi";
    nt:hasTargetNanopubType <https://w3id.org/delphi/ontology/EvidenceItem> .
  
  sub:test a nt:LiteralPlaceholder;
    rdfs:label "the statistical test the p-value comes from" .
  
  sub:vsmpr a nt:LiteralPlaceholder;
    rdfs:label "Vovk–Sellke maximum p-ratio (bound on the Bayes factor implied by the p-value)";
    nt:hasDatatype xsd:double .
  
  sub:weight a nt:LiteralPlaceholder;
    rdfs:label "weight of evidence, from 0 to 1";
    nt:hasDatatype xsd:double;
    nt:hasRegex "^(0(\\.[0-9]+)?|1(\\.0+)?)$" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

