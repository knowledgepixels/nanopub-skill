    npx:hasSignature "ddw3HhC671Q2ttxFzMmbZ59r5PxSyucn+GpoVjboffRm9GSQdwxntMBgHCKAGk13DADmfHbeMwTk1/M20Yw57HSm1Og6yQHJhJwLBgrkBRU75azoKWhAcZI+xIsU2rV07aHrdIUF8k+OPVNe4U2+JqExWbJRVNtnTevrPbaJyz8=";
