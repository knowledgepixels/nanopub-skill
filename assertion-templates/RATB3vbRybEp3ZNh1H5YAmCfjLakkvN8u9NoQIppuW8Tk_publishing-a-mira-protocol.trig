@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix mira: <http://purl.org/mira-science/mira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:title rdfs:label "has the title" .
  
  mira:Protocol rdfs:label "MIRA protocol" .
  
  sioc:content rdfs:label "has the content" .
  
  rdf:type rdfs:label "is a" .
  
  sub:content a nt:LongLiteralPlaceholder;
    rdfs:label "the protocol itself (optional)" .
  
  sub:protocol a nt:IntroducedResource, nt:LocalResource, nt:UriPlaceholder;
    rdfs:label "short URI suffix for this protocol";
    nt:hasDefaultValue sub:protocol .
  
  sub:st01 rdf:object mira:Protocol;
    rdf:predicate rdf:type;
    rdf:subject sub:protocol .
  
  sub:st02 rdf:object sub:title;
    rdf:predicate dct:title;
    rdf:subject sub:protocol .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:content;
    rdf:predicate sioc:content;
    rdf:subject sub:protocol .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Publishes a protocol as a MIRA record: the method or experimental approach that a study follows to generate its evidence. Studies point at protocols with 'follows'.";
    dct:isVersionOf <https://w3id.org/np/RA0YKLTU3WbJ9b_nlHDaFeu79I2FXkJ4Lgx86O4BxK6ns/templateKind>;
    rdfs:label "Publishing a MIRA protocol";
    gen:governedBy <https://w3id.org/spaces/mira>;
    nt:hasNanopubLabelPattern "${title}";
    nt:hasStatement sub:st01, sub:st02, sub:st03;
    nt:hasTag "MIRA";
    nt:hasTargetNanopubType mira:Protocol, <https://w3id.org/spaces/mira/r/MiraRecord> .
  
  sub:title a nt:LiteralPlaceholder;
    rdfs:label "the title of the protocol" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234;
    prov:wasDerivedFrom <https://github.com/MIRA-science/schema>, <https://mira.science/> .
}

