@prefix this: <https://w3id.org/np/RAKV1x80qQUDKSEp7TMop5QA4j4GOoJXtU4-Hpj_3hFm8> .
@prefix sub: <https://w3id.org/np/RAKV1x80qQUDKSEp7TMop5QA4j4GOoJXtU4-Hpj_3hFm8/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  frapo:hasGrantNumber rdfs:label "has the grant number" .
  
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the name" .
  
  rdfs:seeAlso rdfs:label "has a page at" .
  
  owl:sameAs rdfs:label "is the same thing as" .
  
  skos:altLabel rdfs:label "has the other name" .
  
  schema:Grant rdfs:label "grant" .
  
  schema:funder rdfs:label "has the funder" .
  
  sub:altlabel a nt:LiteralPlaceholder;
    rdfs:label "another name" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "a description" .
  
  sub:funder a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "ROR ID or other IRI of the funder";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https%3A%2F%2Fschema.org%2FOrganization" .
  
  sub:grant a nt:IntroducedResource, nt:UriPlaceholder;
    rdfs:label "grant DOI, ARC/NHMRC PURL, or a new short name" .
  
  sub:grantnumber a nt:LiteralPlaceholder;
    rdfs:label "grant number, as the funder writes it" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "title, or funder's name and grant number" .
  
  sub:page a nt:ExternalUriPlaceholder;
    rdfs:label "address of a page about it" .
  
  sub:sameas a nt:ExternalUriPlaceholder;
    rdfs:label "another IRI of the same thing" .
  
  sub:st01 rdf:object schema:Grant;
    rdf:predicate rdf:type;
    rdf:subject sub:grant .
  
  sub:st02 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:grant .
  
  sub:st03 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:altlabel;
    rdf:predicate skos:altLabel;
    rdf:subject sub:grant .
  
  sub:st04 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:grant .
  
  sub:st05 a nt:RepeatableStatement;
    rdf:object sub:funder;
    rdf:predicate schema:funder;
    rdf:subject sub:grant .
  
  sub:st06 a nt:OptionalStatement;
    rdf:object sub:grantnumber;
    rdf:predicate frapo:hasGrantNumber;
    rdf:subject sub:grant .
  
  sub:st07 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:sameas;
    rdf:predicate owl:sameAs;
    rdf:subject sub:grant .
  
  sub:st08 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:page;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:grant .
  
  sub:templateVersion a nt:AssertionTemplate;
    dct:description "Describes a grant with its funder and grant number, following the AI-FAIR Compendia schema recommendation. The grant is a separate thing from the project it funds, and is named by its grant DOI, or else by its ARC or NHMRC PURL, or else by a newly minted IRI.";
    dct:isVersionOf sub:template;
    rdfs:label "Describing a grant";
    gen:governedBy <https://w3id.org/spaces/pensoft>;
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08;
    nt:hasTag "Pensoft";
    nt:hasTargetNanopubType schema:Grant .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-11-13T14:09:02.881+01:00"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:templateVersion;
    npx:introduces sub:template;
    rdfs:label "Describing a grant";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
      <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAgeON_vGgJCt5E4DPMi0eOPaGwNv9tbfFTRZtBwdQL0w/templateVersion> .
  
