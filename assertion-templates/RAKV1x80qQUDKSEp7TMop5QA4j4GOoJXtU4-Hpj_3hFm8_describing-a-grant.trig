    npx:hasSignature "FJF5j3OExZ8hGfkWC1fI4WkY4T5XtzuoVYnUGkX8uv8qNVmF+rY1mXNFNtGFJm2MjV2C/abX7tCuDV2FeAgiR/GLR7qv16Vc1w1+MG6FPN0FEb6dCkao9oDgEmpeXNc4xmGSaG9iLYmHwwUUbVe3opX4jp0H2vJa1eCU2eD1aG4=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}

