@prefix this: <https://w3id.org/np/RAklHk86FBYJvTFtkBatP_pDnR_zOTkEhE6OUgrwPzFxs> .
@prefix sub: <https://w3id.org/np/RAklHk86FBYJvTFtkBatP_pDnR_zOTkEhE6OUgrwPzFxs/> .
@prefix schema: <https://schema.org/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  frapo:hasAcronym rdfs:label "has the acronym" .
  
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the name" .
  
  rdfs:seeAlso rdfs:label "has a page at" .
  
  owl:sameAs rdfs:label "is the same thing as" .
  
  skos:altLabel rdfs:label "has the other name" .
  
  skos:notation rdfs:label "has the code" .
  
  schema:Corporation rdfs:label "company" .
  
  schema:EducationalOrganization rdfs:label "university, college or school" .
  
  schema:FundingAgency rdfs:label "funder" .
  
  schema:GovernmentOrganization rdfs:label "public body" .
  
  schema:MedicalOrganization rdfs:label "hospital or clinic" .
  
  schema:NGO rdfs:label "non-profit" .
  
  schema:Organization rdfs:label "organization" .
  
  schema:ResearchOrganization rdfs:label "research organization" .
  
  schema:location rdfs:label "is based in" .
  
  sub:acronym a nt:LiteralPlaceholder;
    rdfs:label "the acronym" .
  
  sub:altlabel a nt:LiteralPlaceholder;
    rdfs:label "another name" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "a description" .
  
  sub:kind a nt:RestrictedChoicePlaceholder;
    rdfs:label "kind of organization";
    nt:possibleValue schema:Corporation, schema:EducationalOrganization, schema:FundingAgency,
      schema:GovernmentOrganization, schema:MedicalOrganization, schema:NGO, schema:ResearchOrganization .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the name" .
  
  sub:organization a nt:IntroducedResource, nt:UriPlaceholder;
    rdfs:label "ROR ID, Funder ID, ISNI, or a new short name" .
  
  sub:page a nt:ExternalUriPlaceholder;
    rdfs:label "address of a page about it" .
  
  sub:pic a nt:LiteralPlaceholder;
    rdfs:label "EU PIC, 9 digits";
    nt:hasDatatype <https://bioregistry.io/registry/cordis.organization>;
    nt:hasRegex "[0-9]{9}" .
  
  sub:place a nt:ExternalUriPlaceholder;
    rdfs:label "IRI of the country or place" .
  
  sub:placetext a nt:LiteralPlaceholder;
    rdfs:label "country code or place, e.g. DE" .
  
  sub:sameas a nt:ExternalUriPlaceholder;
    rdfs:label "another IRI of the same thing" .
  
  sub:st01 rdf:object schema:Organization;
    rdf:predicate rdf:type;
    rdf:subject sub:organization .
  
  sub:st02 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:kind;
    rdf:predicate rdf:type;
    rdf:subject sub:organization .
  
  sub:st03 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:organization .
  
  sub:st04 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:altlabel;
    rdf:predicate skos:altLabel;
    rdf:subject sub:organization .
  
  sub:st05 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject sub:organization .
  
  sub:st06 a nt:OptionalStatement;
    rdf:object sub:acronym;
    rdf:predicate frapo:hasAcronym;
    rdf:subject sub:organization .
  
  sub:st07 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:place;
    rdf:predicate schema:location;
    rdf:subject sub:organization .
  
  sub:st08 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:placetext;
    rdf:predicate schema:location;
    rdf:subject sub:organization .
  
  sub:st09 a nt:OptionalStatement;
    rdf:object sub:pic;
    rdf:predicate skos:notation;
    rdf:subject sub:organization .
  
  sub:st10 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:sameas;
    rdf:predicate owl:sameAs;
    rdf:subject sub:organization .
  
  sub:st11 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:page;
    rdf:predicate rdfs:seeAlso;
    rdf:subject sub:organization .
  
  sub:templateVersion a nt:AssertionTemplate;
    dct:description "Describes an organization with its names and identifiers, following the Research Metadata Schema. The organization is named by its ROR ID, or else by a Crossref Funder ID that names the organization, or else by its ISNI, or else by a newly minted IRI.";
    dct:isVersionOf <https://w3id.org/np/RAEDhYb1HlFdyc_fkI5N5IVvz5L8NcXGHpqnK81d_5y_k/template>;
    rdfs:label "Describing an organization";
    gen:governedBy <https://w3id.org/spaces/pensoft>;
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08, sub:st09, sub:st10, sub:st11;
    nt:hasTag "Pensoft";
    nt:hasTargetNanopubType schema:Organization .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

