@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdf:type rdfs:label "is a - asserts that the thing on the left belongs to the class on the right" .
  
  rdfs:comment rdfs:label "has the description" .
  
  rdfs:label rdfs:label "has the name" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "further description of this example (optional)" .
  
  sub:example a nt:ExternalUriPlaceholder;
    rdfs:label "URI of the existing thing that is an example of the use case" .
  
  sub:name a nt:LiteralPlaceholder;
    rdfs:label "name of the example" .
  
  sub:st01 rdf:object sub:useCaseClass;
    rdf:predicate rdf:type;
    rdf:subject sub:example .
  
  sub:st02 rdf:object sub:name;
    rdf:predicate rdfs:label;
    rdf:subject sub:example .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate rdfs:comment;
    rdf:subject sub:example .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Declare an existing resource (identified by its URI - e.g. a project, ontology, dataset, or service) as a concrete example of a previously defined use case, with a name and an optional description. Use cases themselves can be defined with the 'Defining a use case for a resource' template.";
    rdfs:label "Providing an example for a use case";
    nt:hasNanopubLabelPattern "Use case example: ${name}";
    nt:hasStatement sub:st01, sub:st02, sub:st03;
    nt:hasTargetNanopubType gen:UseCase .
  
  sub:useCaseClass a nt:GuidedChoicePlaceholder;
    rdfs:label "the use case this is an example of";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/kpxl/gen/terms/UseCase" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-07-30T10:33:10Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
