@prefix sub: <https://w3id.org/np/RA_5nLwlQ1h2LqiqpGh58IuX66uko6XXlGfEju836AFYs/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix orcid: <https://orcid.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "is called" .
  
  <http://www.w3.org/2002/07/owl#NamedIndividual> rdfs:label "named individual" .
  
  skos:definition rdfs:label "has the definition" .
  
  <https://w3id.org/fair/fip/terms/FIP-Data-related-Question> rdfs:label "FIP question about data" .
  
  <https://w3id.org/fair/fip/terms/FIP-Metadata-related-Question> rdfs:label "FIP question about metadata" .
  
  <https://w3id.org/fair/fip/terms/FIP-Question> rdfs:label "FIP question" .
  
  <https://w3id.org/fair/fip/terms/FIP-S-Question> rdfs:label "FIP Supporting Question" .
  
  <https://w3id.org/fair/fip/terms/refers-to-principle> rdfs:label "is about the FAIR principle" .
  
  <https://w3id.org/fair/principles/terms/A1.1> rdfs:label "A1.1 — the protocol is open, free, and universally implementable" .
  
  <https://w3id.org/fair/principles/terms/A1.2> rdfs:label "A1.2 — the protocol allows for an authentication and authorization procedure, where necessary" .
  
  <https://w3id.org/fair/principles/terms/A2> rdfs:label "A2 — metadata are accessible, even when the data are no longer available" .
  
  <https://w3id.org/fair/principles/terms/F1> rdfs:label "F1 — (meta)data are assigned a globally unique and persistent identifier" .
  
  <https://w3id.org/fair/principles/terms/F2> rdfs:label "F2 — data are described with rich metadata" .
  
  <https://w3id.org/fair/principles/terms/F3> rdfs:label "F3 — metadata clearly and explicitly include the identifier of the data it describes" .
  
  <https://w3id.org/fair/principles/terms/F4> rdfs:label "F4 — (meta)data are registered or indexed in a searchable resource" .
  
  <https://w3id.org/fair/principles/terms/I1> rdfs:label "I1 — (meta)data use a formal, accessible, shared, and broadly applicable language for knowledge representation" .
  
  <https://w3id.org/fair/principles/terms/I2> rdfs:label "I2 — (meta)data use vocabularies that follow FAIR principles" .
  
  <https://w3id.org/fair/principles/terms/I3> rdfs:label "I3 — (meta)data include qualified references to other (meta)data" .
  
  <https://w3id.org/fair/principles/terms/R1.1> rdfs:label "R1.1 — (meta)data are released with a clear and accessible data usage license" .
  
  <https://w3id.org/fair/principles/terms/R1.2> rdfs:label "R1.2 — (meta)data are associated with detailed provenance" .
  
  <https://w3id.org/fair/principles/terms/R1.3> rdfs:label "R1.3 — (meta)data meet domain-relevant community standards" .
  
  sub:definition a nt:LanguageTaggedLiteralPlaceholder, nt:LiteralPlaceholder;
    rdfs:label "the question as put to a community";
    nt:hasLanguageTag "en" .
  
  sub:label a nt:LanguageTaggedLiteralPlaceholder, nt:LiteralPlaceholder;
    rdfs:label "short name, e.g. FIP Question F2";
    nt:hasLanguageTag "en" .
  
  sub:principle a nt:RestrictedChoicePlaceholder;
    rdfs:label "the FAIR principle it is about";
    nt:possibleValue <https://w3id.org/fair/principles/terms/A1.1>, <https://w3id.org/fair/principles/terms/A1.2>,
      <https://w3id.org/fair/principles/terms/A2>, <https://w3id.org/fair/principles/terms/F1>,
      <https://w3id.org/fair/principles/terms/F2>, <https://w3id.org/fair/principles/terms/F3>,
      <https://w3id.org/fair/principles/terms/F4>, <https://w3id.org/fair/principles/terms/I1>,
      <https://w3id.org/fair/principles/terms/I2>, <https://w3id.org/fair/principles/terms/I3>,
      <https://w3id.org/fair/principles/terms/R1.1>, <https://w3id.org/fair/principles/terms/R1.2>,
      <https://w3id.org/fair/principles/terms/R1.3> .
  
  sub:question a nt:IntroducedResource, nt:NewUriPlaceholder, nt:UriPlaceholder;
    rdfs:label "term suffix, e.g. FIP-S-Question-crosswalk";
    nt:hasPrefix "https://w3id.org/fair/fip/terms/";
    nt:hasPrefixLabel "fip:";
    nt:hasRegex "FIP-(S-)?Question-[A-Za-z0-9.\\-]+" .
  
  sub:st1 rdf:object <http://www.w3.org/2002/07/owl#NamedIndividual>;
    rdf:predicate rdf:type;
    rdf:subject sub:question .
  
  sub:st2 rdf:object sub:type;
    rdf:predicate rdf:type;
    rdf:subject sub:question .
  
  sub:st3 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject sub:question .
  
  sub:st4 rdf:object sub:definition;
    rdf:predicate skos:definition;
    rdf:subject sub:question .
  
  sub:st5 a nt:OptionalStatement;
    rdf:object sub:principle;
    rdf:predicate <https://w3id.org/fair/fip/terms/refers-to-principle>;
    rdf:subject sub:question .
  
  sub:template a nt:AssertionTemplate;
    dct:description "Such a nanopublication defines a question of a FAIR Implementation Profile (FIP): the term that FIP declarations point at with fip:refers-to-question. Use it for the supplementary \"S\" questions (fip:FIP-S-Question-*), which FIP declarations already use but which have never been defined, and for any further question term. The question text entered as the definition is what the Declared FSRs view of the FAIR Implementation Space shows as the heading above the resources declared under the question, so write it as it is put to a community. Enter the term suffix exactly as the declarations spell it, for instance FIP-S-Question-crosswalk; Nanodash refuses to publish if the term is already introduced elsewhere, which keeps the twenty-one questions of the FIP Ontology (fip:FIP-Question-F2 and its siblings) from being redefined here — those are revised through the ontology itself. Saying whether the question is about data or about metadata records a distinction that the question identifiers have so far only carried in their -D and -MD endings.";
    dct:isVersionOf <https://w3id.org/np/RAVLpmXXM143UM3og5A86x89aZ7V5wF3ZJMh4U52G7PMU/templateKind>;
    rdfs:label "Defining a FIP question";
    gen:governedBy <https://w3id.org/spaces/FAIR-Implementation-Space>;
    nt:hasStatement sub:st1, sub:st2, sub:st3, sub:st4, sub:st5;
    nt:hasTag "FIP";
    nt:hasTargetNanopubType <https://w3id.org/fair/fip/terms/FIP-Question> .
  
  sub:type a nt:RestrictedChoicePlaceholder;
    rdfs:label "plain, data, metadata, or supporting question";
    nt:possibleValue <https://w3id.org/fair/fip/terms/FIP-Data-related-Question>, <https://w3id.org/fair/fip/terms/FIP-Metadata-related-Question>,
      <https://w3id.org/fair/fip/terms/FIP-Question>, <https://w3id.org/fair/fip/terms/FIP-S-Question> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

